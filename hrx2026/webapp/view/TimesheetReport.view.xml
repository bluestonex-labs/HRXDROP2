<mvc:View
	controllerName="bsx.hrx.hrx2026.controller.TimesheetReport"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
	class="hrxTimesheetReport">

	<!-- One view, two pages of the 15.10.26 design: the side rail opens it as Timesheet
	     reporting (?tab=assign, four tabs) or as Utilisation (?tab=util, no tabs and its
	     own filters). trView>/utilMode tells the two apart. Styles: css/pages/timesheet-reporting.css -->
	<Page id="timesheetReportPage" showHeader="false" title="{i18n>trTitle}" showNavButton="false" class="hrxPageContent">
		<content>
			<IllustratedMessage
				visible="{= !${app>/user/isManager} }"
				illustrationType="sapIllus-UnableToLoad"
				title="{i18n>trTitle}"
				description="{i18n>adminRestricted}" />

			<VBox visible="{app>/user/isManager}" renderType="Bare" class="hrxTsBody">

				<!-- ── Filter bar: each label above its control, on one card ── -->
				<HBox renderType="Bare" class="hrxTsFbar">
					<VBox renderType="Bare" visible="{= !${trView>/utilMode} }" class="hrxTsFg">
						<Label text="{i18n>trCustomer}" labelFor="trCustomer" class="hrxTsFgLabel" />
						<!-- Customer, Project and Resource: one or more, ticked in a list; none
						     ticked is all of them -->
						<MultiComboBox
							id="trCustomer"
							width="100%"
							enabled="{= ${trView>/tab} !== 'sub' }"
							showSelectAll="true"
							placeholder="{trView>/customerText}"
							selectedKeys="{trView>/filters/ClientKeys}"
							items="{path: 'tr>/customers', templateShareable: false}"
							selectionFinish=".onFilterChange"
							class="hrxTsInput hrxTsMulti">
							<core:Item key="{tr>key}" text="{tr>label}" />
						</MultiComboBox>
					</VBox>
					<VBox renderType="Bare" visible="{= !${trView>/utilMode} }" class="hrxTsFg">
						<Label text="{i18n>trProject}" labelFor="trProject" class="hrxTsFgLabel" />
						<MultiComboBox
							id="trProject"
							width="100%"
							enabled="{= ${trView>/tab} !== 'sub' }"
							showSelectAll="true"
							placeholder="{trView>/projectText}"
							selectedKeys="{trView>/filters/ProjectKeys}"
							items="{path: 'tr>/projects', templateShareable: false}"
							selectionFinish=".onFilterChange"
							class="hrxTsInput hrxTsMulti">
							<core:Item key="{tr>key}" text="{tr>label}" />
						</MultiComboBox>
					</VBox>
					<VBox renderType="Bare" visible="{= !${trView>/utilMode} }" class="hrxTsFg">
						<Label text="{i18n>trResource}" labelFor="trResource" class="hrxTsFgLabel" />
						<MultiComboBox
							id="trResource"
							width="100%"
							enabled="{= ${trView>/tab} !== 'sub' }"
							showSelectAll="true"
							placeholder="{trView>/peopleText}"
							selectedKeys="{trView>/filters/EmpIDs}"
							items="{path: 'tr>/people', templateShareable: false}"
							selectionFinish=".onFilterChange"
							class="hrxTsInput hrxTsMulti">
							<core:Item key="{tr>key}" text="{tr>label}" />
						</MultiComboBox>
					</VBox>
					<VBox renderType="Bare" class="hrxTsFg hrxTsFgPeriod">
						<Label text="{i18n>trPeriod}" labelFor="trPeriod" class="hrxTsFgLabel" />
						<!-- Read-only, as the design's field: a click anywhere on it opens the
						     calendar (see .hrxTsPeriod in the page's CSS). Who's submitted has a
						     period of its own, a week to start with, and arrows either side. -->
						<HBox renderType="Bare" class="hrxTsPeriodRow">
							<Button
								icon="sap-icon://tabler/chevron-left"
								tooltip="{i18n>tsPreviousWeek}"
								visible="{= !${trView>/utilMode} &amp;&amp; ${trView>/tab} === 'sub' }"
								press=".onSubWeek"
								class="hrxTsBtn hrxTsWeekBtn">
								<customData><core:CustomData key="step" value="-1" /></customData>
							</Button>
							<DateRangeSelection
								id="trPeriod"
								width="100%"
								displayFormat="d MMM yyyy"
								change=".onPeriodChange"
								class="hrxTsInput hrxTsPeriod" />
							<Button
								icon="sap-icon://tabler/chevron-right"
								tooltip="{i18n>tsNextWeek}"
								visible="{= !${trView>/utilMode} &amp;&amp; ${trView>/tab} === 'sub' }"
								enabled="{= !${trView>/sub/atLatest} }"
								press=".onSubWeek"
								class="hrxTsBtn hrxTsWeekBtn">
								<customData><core:CustomData key="step" value="1" /></customData>
							</Button>
						</HBox>
					</VBox>
					<HBox renderType="Bare" class="hrxTsQlinks">
						<Button
							text="{i18n>trClear}"
							visible="{= !${trView>/utilMode} }"
							press=".onClear"
							class="hrxTsBtn" />
						<Button
							text="{i18n>trThisYear}"
							visible="{trView>/utilMode}"
							press=".onThisYear"
							class="hrxTsBtn" />
						<Button
							text="{i18n>trLastYear}"
							visible="{trView>/utilMode}"
							press=".onLastYear"
							class="hrxTsBtn" />
					</HBox>
					<!-- Utilisation: one or more people, found by typing their name; none is everyone -->
					<VBox renderType="Bare" visible="{trView>/utilMode}" class="hrxTsFg hrxTsFgEmployee">
						<Label text="{i18n>trUtilEmployee}" labelFor="trUtilEmployee" class="hrxTsFgLabel" />
						<MultiComboBox
							id="trUtilEmployee"
							width="100%"
							showSelectAll="true"
							placeholder="{trView>/util/peopleText}"
							selectedKeys="{trView>/util/EmpIDs}"
							items="{path: 'tr>/people', templateShareable: false}"
							selectionFinish=".onUtilShow"
							class="hrxTsInput hrxTsMulti">
							<core:Item key="{tr>key}" text="{tr>label}" />
						</MultiComboBox>
					</VBox>
					<VBox renderType="Bare" visible="{trView>/utilMode}" class="hrxTsFg hrxTsFgShow">
						<Label text="{i18n>trShow}" labelFor="trUtilShow" class="hrxTsFgLabel" />
						<Select
							id="trUtilShow"
							width="100%"
							selectedKey="{trView>/util/show}"
							change=".onUtilShow"
							class="hrxTsSelect">
							<core:Item key="all" text="{i18n>trShowEveryone}" />
							<core:Item key="bill" text="{i18n>trShowBillable}" />
							<core:Item key="u50" text="{i18n>trShowUnder50}" />
							<core:Item key="u80" text="{i18n>trShowUnder80}" />
						</Select>
					</VBox>
				</HBox>

				<MessageStrip
					text="{trView>/failedText}"
					type="Warning"
					showIcon="true"
					visible="{= !!${trView>/failedText} }"
					class="hrxTsStrip" />

				<HBox alignItems="Center" visible="{trView>/loading}" class="hrxTsLoading">
					<BusyIndicator size="1.25rem" class="sapUiSmallMarginEnd" />
					<Text text="{trView>/progressText}" />
				</HBox>

				<!-- ── Tabs (Timesheet reporting only) ── -->
				<HBox renderType="Bare" visible="{= !${trView>/utilMode} }" class="hrxTsTabs">
					<Button text="{i18n>trTabAssign}" press=".onTabPress" class="hrxTsTab">
						<customData>
							<core:CustomData key="tab" value="assign" />
							<core:CustomData key="on" value="{= ${trView>/tab} === 'assign' ? 'yes' : 'no' }" writeToDom="true" />
						</customData>
					</Button>
					<Button text="{i18n>trTabDays}" press=".onTabPress" class="hrxTsTab">
						<customData>
							<core:CustomData key="tab" value="days" />
							<core:CustomData key="on" value="{= ${trView>/tab} === 'days' ? 'yes' : 'no' }" writeToDom="true" />
						</customData>
					</Button>
					<Button text="{i18n>trTabBreakdown}" press=".onTabPress" class="hrxTsTab">
						<customData>
							<core:CustomData key="tab" value="break" />
							<core:CustomData key="on" value="{= ${trView>/tab} === 'break' ? 'yes' : 'no' }" writeToDom="true" />
						</customData>
					</Button>
					<Button text="{i18n>trTabSubmitted}" press=".onTabPress" class="hrxTsTab">
						<customData>
							<core:CustomData key="tab" value="sub" />
							<core:CustomData key="on" value="{= ${trView>/tab} === 'sub' ? 'yes' : 'no' }" writeToDom="true" />
						</customData>
					</Button>
				</HBox>

				<!-- ══════════ Billing by assignment ══════════ -->
				<VBox renderType="Bare" visible="{= !${trView>/utilMode} &amp;&amp; ${trView>/tab} === 'assign' }" class="hrxTsSection">
					<HBox renderType="Bare" class="hrxTsKpis">
						<VBox renderType="Bare" class="hrxTsKpi">
							<customData><core:CustomData key="state" value="neu" writeToDom="true" /></customData>
							<core:Icon src="sap-icon://tabler/briefcase" class="hrxTsGlyph" />
							<Text text="{i18n>trKpiBillableAssignments}" class="hrxTsKlab" />
							<Text text="{tr>/assign/kpis/billable}" class="hrxTsKnum" />
							<Text text="{tr>/assign/kpis/billableSub}" class="hrxTsKsub" />
						</VBox>
						<VBox renderType="Bare" class="hrxTsKpi">
							<customData><core:CustomData key="state" value="neu" writeToDom="true" /></customData>
							<core:Icon src="sap-icon://tabler/building" class="hrxTsGlyph" />
							<Text text="{i18n>trKpiClients}" class="hrxTsKlab" />
							<Text text="{tr>/assign/kpis/clients}" class="hrxTsKnum" />
							<Text text="{i18n>trKpiClientsSub}" class="hrxTsKsub" />
						</VBox>
						<VBox renderType="Bare" class="hrxTsKpi">
							<customData><core:CustomData key="state" value="ok" writeToDom="true" /></customData>
							<core:Icon src="sap-icon://tabler/currency-pound" class="hrxTsGlyph" />
							<Text text="{i18n>trKpiBilled}" class="hrxTsKlab" />
							<Text text="{tr>/assign/kpis/billed}" class="hrxTsKnum" />
							<Text text="{i18n>trInPeriod}" class="hrxTsKsub" />
						</VBox>
						<VBox renderType="Bare" class="hrxTsKpi">
							<customData><core:CustomData key="state" value="neu" writeToDom="true" /></customData>
							<core:Icon src="sap-icon://tabler/calendar-month" class="hrxTsGlyph" />
							<Text text="{i18n>trKpiBilledMonth}" class="hrxTsKlab" />
							<Text text="{tr>/assign/kpis/month}" class="hrxTsKnum" />
							<Text text="{trView>/month/label}" class="hrxTsKsub" />
						</VBox>
					</HBox>

					<VBox renderType="Bare" busy="{trView>/loading}" busyIndicatorDelay="0" class="hrxTsCard">
						<HBox renderType="Bare" class="hrxTsCardHead">
							<VBox renderType="Bare" class="hrxTsCardHeadText">
								<Title text="{i18n>trTabAssign}" level="H3" class="hrxTsCardTitle" />
								<Text text="{tr>/assign/hint}" class="hrxTsCardHint" />
							</VBox>
							<HBox renderType="Bare" class="hrxTsTools">
								<Input
									value="{trView>/assign/q}"
									placeholder="{i18n>trSearchAssign}"
									valueLiveUpdate="true"
									liveChange=".onAssignSearch"
									class="hrxTsInput hrxTsSearch" />
								<Select
									selectedKey="{trView>/assign/work}"
									change=".onAssignSearch"
									class="hrxTsSelect hrxTsWork">
									<core:Item key="all" text="{i18n>trAllWork}" />
									<core:Item key="bill" text="{i18n>trBillableOnly}" />
									<core:Item key="int" text="{i18n>trInternalOnly}" />
								</Select>
								<Button text="{tr>/assign/expandText}" press=".onExpandAllAssign" class="hrxTsBtn" />
							</HBox>
						</HBox>

						<ScrollContainer horizontal="true" vertical="false" width="100%">
							<VBox renderType="Bare" class="hrxTsTable hrxTsAsgTable">
								<HBox renderType="Bare" class="hrxTsTr hrxTsTh hrxTsAsgCols">
									<Text text="" />
									<Text text="{i18n>trColEmployee}" />
									<Text text="{i18n>trColProject}" />
									<Text text="{i18n>trColBilling}" />
									<Text text="{i18n>trColDayRate}" textAlign="End" class="hrxTsNum" />
									<Text text="{i18n>trColThisMonth}" textAlign="End" class="hrxTsNum" />
									<Text text="{i18n>trColBilledTotal}" textAlign="End" class="hrxTsNum" />
								</HBox>
								<Text text="{i18n>trNothing}" visible="{= ${tr>/assign/rows}.length === 0 }" class="hrxTsTblEmpty" />
								<VBox id="trAssignList" renderType="Bare" items="{path: 'tr>/assign/rows', templateShareable: false}">
									<VBox renderType="Bare" class="hrxTsAsg">
										<customData>
											<core:CustomData key="key" value="{tr>key}" writeToDom="true" />
											<core:CustomData key="open" value="{= ${tr>open} ? 'yes' : 'no' }" writeToDom="true" />
										</customData>
										<HBox renderType="Bare" class="hrxTsTr hrxTsAsgCols hrxTsAsgRow">
											<!-- The chevron: the keyboard route to what a click on the row does. -->
											<Button
												type="Transparent"
												tooltip="{i18n>trShowBookings}"
												press=".onToggleAssign"
												class="hrxTsChev" />
											<VBox renderType="Bare">
												<Text text="{tr>Name}" class="hrxTsStrong" />
												<Text text="{tr>bookingsText}" class="hrxTsSub" />
											</VBox>
											<VBox renderType="Bare">
												<Text text="{tr>ClientDesc}" />
												<Text text="{tr>projectLine}" class="hrxTsSub" />
											</VBox>
											<HBox renderType="Bare">
												<Text text="{= ${tr>Billable} ? ${i18n>trBillable} : ${i18n>trInternal} }" class="hrxTsPill">
													<customData>
														<core:CustomData key="state" value="{= ${tr>Billable} ? 'ok' : 'neu' }" writeToDom="true" />
													</customData>
												</Text>
											</HBox>
											<Text text="{tr>rateText}" textAlign="End" class="hrxTsNum" />
											<Text text="{tr>monthText}" textAlign="End" class="hrxTsNum" />
											<Text text="{tr>totalText}" textAlign="End" class="hrxTsNum hrxTsTotal">
												<customData>
													<core:CustomData key="priced" value="{= ${tr>total} !== null ? 'yes' : 'no' }" writeToDom="true" />
												</customData>
											</Text>
										</HBox>

										<!-- The assignment's time bookings, opened under its row. -->
										<VBox renderType="Bare" visible="{tr>open}" class="hrxTsAsgSub">
											<VBox renderType="Bare" class="hrxTsInner">
												<HBox renderType="Bare" class="hrxTsTr hrxTsTh hrxTsLogCols">
													<Text text="{i18n>trColDate}" />
													<Text text="{i18n>trColHours}" textAlign="End" class="hrxTsNum" />
													<Text text="{i18n>trColWork}" />
												</HBox>
												<VBox renderType="Bare" items="{path: 'tr>logs', templateShareable: false}">
													<HBox renderType="Bare" class="hrxTsTr hrxTsLogCols">
														<Text text="{tr>dateText}" />
														<Text text="{tr>hoursText}" textAlign="End" class="hrxTsNum" />
														<Text text="{tr>Comment}" />
													</HBox>
												</VBox>
												<VBox renderType="Bare" visible="{= ${tr>logs}.length === 0 }" class="hrxTsEmpty hrxTsEmptySmall">
													<Text text="{i18n>trNoBookings}" class="hrxTsEmptyTitle" />
												</VBox>
											</VBox>
										</VBox>
									</VBox>
								</VBox>
							</VBox>
						</ScrollContainer>
					</VBox>
				</VBox>

				<!-- ══════════ Billed days overview ══════════ -->
				<HBox renderType="Bare" visible="{= !${trView>/utilMode} &amp;&amp; ${trView>/tab} === 'days' }" class="hrxTsDaysGrid">
					<VBox renderType="Bare" class="hrxTsCard">
						<HBox renderType="Bare" class="hrxTsCardHead">
							<Title text="{trView>/period/title}" level="H3" class="hrxTsCardTitle" />
						</HBox>
						<VBox renderType="Bare" class="hrxTsPadded">
							<VBox renderType="Bare" class="hrxTsStat">
								<Text text="{i18n>trTotalDays}" class="hrxTsStatLabel" />
								<HBox renderType="Bare" class="hrxTsStatValue">
									<Text text="{tr>/days/totalText}" />
									<Text text="{i18n>trDaysUnit}" class="hrxTsStatUnit" />
								</HBox>
							</VBox>
							<VBox renderType="Bare" class="hrxTsStat">
								<Text text="{i18n>trBillableDays}" class="hrxTsStatLabel" />
								<HBox renderType="Bare" class="hrxTsStatValue">
									<Text text="{tr>/days/billableText}" />
									<Text text="{i18n>trDaysUnit}" class="hrxTsStatUnit" />
								</HBox>
							</VBox>
							<VBox renderType="Bare" class="hrxTsStat">
								<Text text="{i18n>trNonBillableDays}" class="hrxTsStatLabel" />
								<HBox renderType="Bare" class="hrxTsStatValue">
									<Text text="{tr>/days/nonBillableText}" />
									<Text text="{i18n>trDaysUnit}" class="hrxTsStatUnit" />
								</HBox>
							</VBox>
						</VBox>
					</VBox>

					<VBox id="trPieCard" renderType="Bare" class="hrxTsCard">
						<HBox renderType="Bare" class="hrxTsCardHead">
							<VBox renderType="Bare" class="hrxTsCardHeadText">
								<Title text="{tr>/days/title}" level="H3" class="hrxTsCardTitle" />
								<Text text="{tr>/days/hint}" class="hrxTsCardHint" />
							</VBox>
							<Button
								text="{i18n>trAllCustomers}"
								visible="{= !!${trView>/drill} }"
								press=".onAllCustomers"
								class="hrxTsBtn" />
						</HBox>
						<VBox renderType="Bare" class="hrxTsPadded">
							<VBox renderType="Bare" visible="{= ${tr>/days/slices}.length === 0 }" class="hrxTsEmpty">
								<Text text="{i18n>trNothingBooked}" class="hrxTsEmptyTitle" />
							</VBox>
							<!-- preferDOM off: the chart is redrawn whole each time its data
							     changes, rather than swapped in place - which left the old
							     chart on screen beside the new one. -->
							<core:HTML
								content="{tr>/days/pieHtml}"
								preferDOM="false"
								visible="{= ${tr>/days/slices}.length > 0 }" />
							<List
								items="{path: 'tr>/days/slices', templateShareable: false}"
								showSeparators="None"
								showNoData="false"
								backgroundDesign="Transparent"
								class="hrxTsLegend">
								<CustomListItem type="{= ${trView>/drill} ? 'Inactive' : 'Active' }" press=".onSliceSelect">
									<HBox renderType="Bare" class="hrxTsLgRow">
										<customData>
											<core:CustomData key="shown" value="{= ${tr>shown} ? 'true' : 'false' }" writeToDom="true" />
										</customData>
										<!-- Untick to take the slice out of the donut and its total -->
										<CheckBox
											selected="{tr>shown}"
											select=".onSliceToggle"
											tooltip="{i18n>trShowInChart}"
											class="hrxTsLgCheck" />
										<HBox renderType="Bare" class="hrxTsDot">
											<customData>
												<core:CustomData key="colour" value="{tr>colourKey}" writeToDom="true" />
											</customData>
										</HBox>
										<Text text="{tr>label}" class="hrxTsLgName" />
										<Text text="{tr>valueText}" class="hrxTsStrong" />
									</HBox>
								</CustomListItem>
							</List>
						</VBox>
					</VBox>

					<VBox renderType="Bare" class="hrxTsCard">
						<HBox renderType="Bare" class="hrxTsCardHead">
							<Title text="{i18n>trTopProjects}" level="H3" class="hrxTsCardTitle" />
						</HBox>
						<VBox renderType="Bare" class="hrxTsPadded">
							<VBox renderType="Bare" visible="{= ${tr>/days/top}.length === 0 }" class="hrxTsEmpty">
								<Text text="{i18n>trNothingBooked}" class="hrxTsEmptyTitle" />
							</VBox>
							<VBox renderType="Bare" items="{path: 'tr>/days/top', templateShareable: false}">
								<VBox renderType="Bare" class="hrxTsTopRow">
									<HBox renderType="Bare" class="hrxTsTopLabel">
										<Text text="{tr>label}" />
										<Text text="{tr>valueText}" class="hrxTsStrong" />
									</HBox>
									<HBox renderType="Bare" class="hrxTsTrack">
										<HBox renderType="Bare" width="{tr>width}" class="hrxTsFill hrxTsFillTop" />
									</HBox>
								</VBox>
							</VBox>
						</VBox>
					</VBox>
				</HBox>

				<!-- ══════════ Timesheet breakdown ══════════ -->
				<VBox renderType="Bare" visible="{= !${trView>/utilMode} &amp;&amp; ${trView>/tab} === 'break' }" class="hrxTsCard">
					<HBox renderType="Bare" class="hrxTsCardHead">
						<VBox renderType="Bare" class="hrxTsCardHeadText">
							<Title text="{i18n>trBreakdownTitle}" level="H3" class="hrxTsCardTitle" />
							<Text text="{tr>/brk/hint}" class="hrxTsCardHint" />
						</VBox>
						<Button
							text="{tr>/brk/expandText}"
							visible="{= ${tr>/brk/customers} > 0 }"
							press=".onExpandAllBreakdown"
							class="hrxTsBtn" />
					</HBox>
					<VBox renderType="Bare" visible="{= ${tr>/brk/customers} === 0 }" class="hrxTsEmpty">
						<Text text="{i18n>trNothingBooked}" class="hrxTsEmptyTitle" />
					</VBox>
					<!-- Its columns depend on who booked time, so the rows are built in the controller. -->
					<ScrollContainer horizontal="true" vertical="false" width="100%" visible="{= ${tr>/brk/customers} > 0 }">
						<VBox id="trBreakTable" renderType="Bare" class="hrxTsTable hrxTsBrk" />
					</ScrollContainer>
				</VBox>

				<!-- ══════════ Who's submitted ══════════ -->
				<VBox renderType="Bare" visible="{= !${trView>/utilMode} &amp;&amp; ${trView>/tab} === 'sub' }" class="hrxTsSection">
					<HBox renderType="Bare" class="hrxTsKpis">
						<VBox renderType="Bare" class="hrxTsKpi">
							<customData><core:CustomData key="state" value="{tr>/sub/complianceState}" writeToDom="true" /></customData>
							<core:Icon src="sap-icon://tabler/clipboard-check" class="hrxTsGlyph" />
							<Text text="{= ${trView>/sub/thisWeek} ? ${i18n>trKpiCompliance} : ${i18n>trKpiCompliancePeriod} }" class="hrxTsKlab" />
							<HBox renderType="Bare" class="hrxTsKnum">
								<Text text="{tr>/sub/compliance}" />
								<Text text="%" class="hrxTsKunit" />
							</HBox>
							<Text text="{i18n>trKpiComplianceSub}" class="hrxTsKsub" />
						</VBox>
						<VBox renderType="Bare" class="hrxTsKpi">
							<customData><core:CustomData key="state" value="{= ${tr>/sub/under} > 0 ? 'warn' : 'ok' }" writeToDom="true" /></customData>
							<core:Icon src="sap-icon://tabler/alert-triangle" class="hrxTsGlyph" />
							<Text text="{i18n>trKpiUnder}" class="hrxTsKlab" />
							<Text text="{tr>/sub/under}" class="hrxTsKnum" />
							<Text text="{= ${trView>/sub/thisWeek} ? ${i18n>trKpiUnderSub} : ${i18n>trKpiUnderSubPeriod} }" class="hrxTsKsub" />
						</VBox>
						<VBox renderType="Bare" class="hrxTsKpi">
							<customData><core:CustomData key="state" value="ok" writeToDom="true" /></customData>
							<core:Icon src="sap-icon://tabler/circle-check" class="hrxTsGlyph" />
							<Text text="{i18n>trKpiFull}" class="hrxTsKlab" />
							<Text text="{tr>/sub/full}" class="hrxTsKnum" />
							<Text text="{i18n>trKpiFullSub}" class="hrxTsKsub" />
						</VBox>
						<!-- The HRX service keeps no log of the reminders it sends, so there is no
						     count to show - the tile says what is missing instead. -->
						<VBox renderType="Bare" class="hrxTsKpi">
							<customData><core:CustomData key="state" value="neu" writeToDom="true" /></customData>
							<core:Icon src="sap-icon://tabler/mail" class="hrxTsGlyph" />
							<Text text="{i18n>trKpiReminders}" class="hrxTsKlab" />
							<Text text="—" class="hrxTsKnum" />
							<Text text="{i18n>trKpiRemindersNeeded}" class="hrxTsKsub" />
						</VBox>
					</HBox>

					<VBox renderType="Bare" busy="{trView>/weekLoading}" busyIndicatorDelay="0" class="hrxTsCard">
						<HBox renderType="Bare" class="hrxTsCardHead">
							<VBox renderType="Bare" class="hrxTsCardHeadText">
								<Title text="{i18n>trAllEmployees}" level="H3" class="hrxTsCardTitle" />
								<Text text="{tr>/sub/hint}" class="hrxTsCardHint" />
							</VBox>
							<HBox renderType="Bare" class="hrxTsTools">
								<Input
									value="{trView>/sub/q}"
									placeholder="{i18n>trSearch}"
									valueLiveUpdate="true"
									liveChange=".onSubSearch"
									class="hrxTsInput hrxTsSearch" />
								<Button text="{i18n>trRefreshWeek}" press=".onRefreshWeek" class="hrxTsBtn" />
								<Button text="{i18n>trSendAll}" press=".onRemindAll" class="hrxTsBtn hrxTsBtnPrimary" />
							</HBox>
						</HBox>

						<ScrollContainer horizontal="true" vertical="false" width="100%">
							<VBox renderType="Bare" class="hrxTsTable hrxTsSubTable">
								<HBox renderType="Bare" class="hrxTsTr hrxTsTh hrxTsSubCols">
									<Text text="{i18n>trColEmployee}" />
									<Text text="{= ${trView>/sub/thisWeek} ? ${i18n>trColThisWeek} : ${i18n>trColPeriod} }" />
									<Text text="{i18n>trColReminder}" />
									<Text text="{i18n>trColBooked}" textAlign="End" class="hrxTsNum" />
								</HBox>
								<Text text="{i18n>trNoWeek}" visible="{= ${tr>/sub/rows}.length === 0 }" class="hrxTsTblEmpty" />
								<VBox renderType="Bare" items="{path: 'tr>/sub/rows', templateShareable: false}">
									<HBox renderType="Bare" class="hrxTsTr hrxTsSubCols">
										<HBox renderType="Bare" class="hrxTsPerson">
											<Image src="{= ${pictures>/users}[${tr>UserID}] || '' }" visible="{= !!${pictures>/users}[${tr>UserID}] }" width="30px" height="30px" class="hrxAvatarPic" />
											<Text text="{tr>initials}" visible="{= !${pictures>/users}[${tr>UserID}] }" class="hrxTsAvatar" />
											<Text text="{tr>Name}" class="hrxTsPersonName" />
										</HBox>
										<VBox renderType="Bare" class="hrxTsAck">
											<Text text="{tr>hoursText}" class="hrxTsAckText" />
											<HBox renderType="Bare" class="hrxTsBarLine">
												<HBox renderType="Bare" class="hrxTsTrack">
													<HBox renderType="Bare" width="{tr>width}" class="hrxTsFill">
														<customData><core:CustomData key="state" value="{tr>state}" writeToDom="true" /></customData>
													</HBox>
												</HBox>
												<HBox renderType="Bare" class="hrxTsIco">
													<customData><core:CustomData key="state" value="{tr>state}" writeToDom="true" /></customData>
												</HBox>
											</HBox>
										</VBox>
										<HBox renderType="Bare">
											<Button
												text="{i18n>trRemind}"
												visible="{= !${tr>complete} }"
												press=".onRemind"
												class="hrxTsBtn hrxTsBtnMail" />
											<Text text="—" visible="{tr>complete}" />
										</HBox>
										<HBox renderType="Bare" class="hrxTsCellEnd">
											<Text text="{tr>statusText}" class="hrxTsPill">
												<customData><core:CustomData key="state" value="{tr>statusState}" writeToDom="true" /></customData>
											</Text>
										</HBox>
									</HBox>
								</VBox>
							</VBox>
						</ScrollContainer>
					</VBox>
				</VBox>

				<!-- ══════════ Utilisation (its own page in the side rail) ══════════ -->
				<VBox renderType="Bare" visible="{trView>/utilMode}" class="hrxTsSection">
					<HBox renderType="Bare" class="hrxTsKpis">
						<VBox renderType="Bare" class="hrxTsKpi">
							<customData><core:CustomData key="state" value="{tr>/util/teamState}" writeToDom="true" /></customData>
							<core:Icon src="sap-icon://tabler/chart-bar" class="hrxTsGlyph" />
							<Text text="{i18n>trKpiTeamUtil}" class="hrxTsKlab" />
							<HBox renderType="Bare" class="hrxTsKnum">
								<Text text="{tr>/util/team}" />
								<Text text="%" class="hrxTsKunit" />
							</HBox>
							<Text text="{i18n>trKpiTeamUtilSub}" class="hrxTsKsub" />
						</VBox>
						<VBox renderType="Bare" class="hrxTsKpi">
							<customData><core:CustomData key="state" value="neu" writeToDom="true" /></customData>
							<core:Icon src="sap-icon://tabler/briefcase" class="hrxTsGlyph" />
							<Text text="{i18n>trKpiOnBillable}" class="hrxTsKlab" />
							<Text text="{tr>/util/onBillable}" class="hrxTsKnum" />
							<Text text="{i18n>trKpiOnBillableSub}" class="hrxTsKsub" />
						</VBox>
						<VBox renderType="Bare" class="hrxTsKpi">
							<customData><core:CustomData key="state" value="ok" writeToDom="true" /></customData>
							<core:Icon src="sap-icon://tabler/calendar-dollar" class="hrxTsGlyph" />
							<Text text="{i18n>trBillableDays}" class="hrxTsKlab" />
							<Text text="{tr>/util/billable}" class="hrxTsKnum" />
							<Text text="{i18n>trInPeriod}" class="hrxTsKsub" />
						</VBox>
						<VBox renderType="Bare" class="hrxTsKpi">
							<customData><core:CustomData key="state" value="neu" writeToDom="true" /></customData>
							<core:Icon src="sap-icon://tabler/calendar-stats" class="hrxTsGlyph" />
							<Text text="{i18n>trKpiTotalBooked}" class="hrxTsKlab" />
							<Text text="{tr>/util/total}" class="hrxTsKnum" />
							<Text text="{i18n>trKpiTotalBookedSub}" class="hrxTsKsub" />
						</VBox>
					</HBox>

					<VBox renderType="Bare" busy="{trView>/loading}" busyIndicatorDelay="0" class="hrxTsCard">
						<HBox renderType="Bare" class="hrxTsCardHead">
							<VBox renderType="Bare" class="hrxTsCardHeadText">
								<Title text="{i18n>trUtilByPerson}" level="H3" class="hrxTsCardTitle" />
								<Text text="{tr>/util/hint}" class="hrxTsCardHint" />
							</VBox>
						</HBox>
						<ScrollContainer horizontal="true" vertical="false" width="100%">
							<VBox renderType="Bare" class="hrxTsTable hrxTsUtilTable">
								<HBox renderType="Bare" class="hrxTsTr hrxTsTh hrxTsUtilCols">
									<Text text="{i18n>trColEmployee}" />
									<Text text="{i18n>trColBillable}" textAlign="End" class="hrxTsNum" />
									<Text text="{i18n>trColTotal}" textAlign="End" class="hrxTsNum" />
									<Text text="{i18n>trColUtil}" />
									<Text text="{i18n>trColBillableProjects}" />
								</HBox>
								<Text text="{i18n>trNoUtil}" visible="{= ${tr>/util/rows}.length === 0 }" class="hrxTsTblEmpty" />
								<VBox renderType="Bare" items="{path: 'tr>/util/rows', templateShareable: false}">
									<HBox renderType="Bare" class="hrxTsTr hrxTsUtilCols">
										<VBox renderType="Bare">
											<Text text="{tr>Name}" class="hrxTsStrong" />
											<Text text="{tr>projectsCount}" class="hrxTsSub" />
										</VBox>
										<Text text="{tr>billableText}" textAlign="End" class="hrxTsNum" />
										<Text text="{tr>totalText}" textAlign="End" class="hrxTsNum" />
										<VBox renderType="Bare" class="hrxTsUbBar">
											<Text text="{tr>pctText}" class="hrxTsUbPct" />
											<HBox renderType="Bare" class="hrxTsBarLine">
												<HBox renderType="Bare" class="hrxTsTrack">
													<HBox renderType="Bare" width="{tr>width}" class="hrxTsFill">
														<customData><core:CustomData key="state" value="{tr>state}" writeToDom="true" /></customData>
													</HBox>
												</HBox>
												<HBox renderType="Bare" class="hrxTsIco">
													<customData><core:CustomData key="state" value="{tr>state}" writeToDom="true" /></customData>
												</HBox>
											</HBox>
										</VBox>
										<Text text="{tr>projectsText}" class="hrxTsProjs" />
									</HBox>
								</VBox>
							</VBox>
						</ScrollContainer>
					</VBox>
				</VBox>
			</VBox>
		</content>
	</Page>
</mvc:View>
