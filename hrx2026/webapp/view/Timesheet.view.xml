<mvc:View
	controllerName="bsx.hrx.hrx2026.controller.Timesheet"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:hrx="bsx.hrx.hrx2026.control"
	displayBlock="true"
	class="hrxTimesheet">

	<Page id="timesheetPage" showHeader="false" showNavButton="false" class="hrxPageContent">

		<content>

			<!-- The month's billing figures: three tiles, as wide together as the week card. -->
			<FlexBox renderType="Bare" class="hrxTsKpis">

				<VBox renderType="Bare" class="hrxTsKpi hrxTsKpiNeutral">
					<core:Icon src="sap-icon://tabler/target-arrow" class="hrxTsKpiGlyph" />
					<Text text="{i18n>kpiTargetBillable}" class="hrxTsKpiLabel" />
					<Text text="{tsView>/kpis/targetDays}" class="hrxTsKpiNum" />
					<Text text="{tsView>/kpis/month}" class="hrxTsKpiSub" />
				</VBox>

				<VBox renderType="Bare" class="hrxTsKpi hrxTsKpiWarning">
					<core:Icon src="sap-icon://tabler/clock-hour-4" class="hrxTsKpiGlyph" />
					<Text text="{i18n>kpiActualBilled}" class="hrxTsKpiLabel" />
					<Text text="{tsView>/kpis/actualDays}" class="hrxTsKpiNum" />
					<Text text="{tsView>/kpis/month}" class="hrxTsKpiSub" />
				</VBox>

				<VBox renderType="Bare" class="hrxTsKpi hrxTsKpiGood">
					<core:Icon src="sap-icon://tabler/chart-bar" class="hrxTsKpiGlyph" />
					<Text text="{i18n>kpiUtilisation}" class="hrxTsKpiLabel" />
					<HBox renderType="Bare" class="hrxTsKpiNum">
						<Text text="{tsView>/kpis/utilisation}" />
						<Text text="%" class="hrxTsKpiUnit" />
					</HBox>
					<Text text="{tsView>/kpis/month}" class="hrxTsKpiSub" />
				</VBox>

			</FlexBox>

			<!-- The week itself, as one card: week navigation, progress, grid, footnote -->
			<VBox renderType="Bare" class="hrxTsCard">

				<HBox alignItems="Center" justifyContent="SpaceBetween" class="hrxTsTop">
					<HBox alignItems="Center" class="hrxTsWeekNav">
						<Button
							id="timesheetPrevWeek"
							icon="sap-icon://slim-arrow-left"
							tooltip="{i18n>tsPreviousWeek}"
							press=".onPreviousWeek"
							class="hrxTsIconButton" />
						<!-- The week title opens a calendar to jump straight to any week -->
						<Button
							id="timesheetWeekPicker"
							text="{tsView>/weekLabel}"
							tooltip="{i18n>tsPickWeek}"
							press=".onOpenWeekPicker"
							class="hrxTsWeekTitle" />
						<Button
							id="timesheetNextWeek"
							icon="sap-icon://slim-arrow-right"
							tooltip="{i18n>tsNextWeek}"
							press=".onNextWeek"
							class="hrxTsIconButton" />
					</HBox>
					<HBox alignItems="Center" class="hrxTsActions">
						<Button
							id="timesheetAddProjects"
							text="{i18n>btnAddProjects}"
							press=".onOpenAddProjects"
							class="hrxTsButton hrxTsButtonGhost" />
						<Button
							id="timesheetDeleteProjects"
							text="{i18n>btnDeleteProjects}"
							icon="sap-icon://delete"
							press=".onDeleteProjects"
							class="hrxTsButton hrxTsButtonGhost" />
						<Button
							id="timesheetSave"
							text="{i18n>btnSave}"
							type="Emphasized"
							press=".onSave"
							class="hrxTsButton hrxTsButtonPrimary" />
					</HBox>
				</HBox>

				<!-- Hours booked against the week's target -->
				<HBox alignItems="Center" class="hrxTsHours">
					<ProgressIndicator
						percentValue="{tsView>/weekPercent}"
						showValue="false"
						state="{= ${tsView>/weekOver} ? 'Error' : 'None' }"
						class="hrxTsHoursTrack">
						<layoutData>
							<FlexItemData growFactor="1" baseSize="0%" />
						</layoutData>
					</ProgressIndicator>
					<HBox renderType="Bare" class="hrxTsHoursLabel">
						<Text text="{tsView>/weekBooked}" class="hrxTsHoursBooked" />
						<Text
							text="{path: 'tsView>/weekTarget', formatter: '.formatHoursOfTarget'}"
							class="hrxTsHoursTarget" />
					</HBox>
				</HBox>

				<!-- One row per project, grouped by client; a group row folds its projects
				     away when clicked (see createGroupHeader). -->
				<hrx:TimesheetTable
					id="timesheetTable"
					items="{path: 'ts>/rows', groupHeaderFactory: '.createGroupHeader'}"
					mode="MultiSelect"
					busy="{= ${tsView>/busy} || ${tsView>/saving} }"
					busyIndicatorDelay="0"
					noDataText="{i18n>tsNoRows}"
					alternateRowColors="false"
					sticky="ColumnHeaders"
					class="hrxTsTable"
					selectionChange=".onSelectionChange"
					updateFinished=".onTableUpdated">
					<hrx:columns>
						<Column width="13.48%" vAlign="Middle">
							<Text text="{i18n>tsColProject}" />
						</Column>
						<Column width="13.65%" vAlign="Middle" minScreenWidth="Tablet" demandPopin="true">
							<Text text="{tsView>/dayHeaders/0/label}" />
						</Column>
						<Column width="13.65%" vAlign="Middle" minScreenWidth="Tablet" demandPopin="true">
							<Text text="{tsView>/dayHeaders/1/label}" />
						</Column>
						<Column width="13.65%" vAlign="Middle" minScreenWidth="Tablet" demandPopin="true">
							<Text text="{tsView>/dayHeaders/2/label}" />
						</Column>
						<Column width="13.65%" vAlign="Middle" minScreenWidth="Tablet" demandPopin="true">
							<Text text="{tsView>/dayHeaders/3/label}" />
						</Column>
						<Column width="13.65%" vAlign="Middle" minScreenWidth="Tablet" demandPopin="true">
							<Text text="{tsView>/dayHeaders/4/label}" />
						</Column>
						<Column width="7.54%" vAlign="Middle" minScreenWidth="Tablet" demandPopin="true">
							<Text text="{tsView>/dayHeaders/5/label}" />
						</Column>
						<Column vAlign="Middle" minScreenWidth="Tablet" demandPopin="true">
							<Text text="{tsView>/dayHeaders/6/label}" />
						</Column>
					</hrx:columns>
					<hrx:items>
						<!-- A row that may not be deleted takes no part in the selection, so "select
						     all" picks exactly the rows the Delete button acts on, and ticks. -->
						<hrx:TimesheetRow
							vAlign="Middle"
							selected="false"
							selectable="{= ${ts>deletable} !== false }">
							<!-- A real data-* attribute rather than a bound class, which does
							     not evaluate on `class`. Written as the string "true"/"false":
							     writeToDom drops a raw boolean false entirely. -->
							<hrx:customData>
								<core:CustomData
									key="deletable"
									value="{= ${ts>deletable} === false ? 'false' : 'true' }"
									writeToDom="true" />
							</hrx:customData>
							<hrx:cells>
								<HBox alignItems="Center" wrap="Wrap" class="hrxTsProject">
									<Text text="{ts>project}" class="hrxTsProjectName" />
									<ObjectStatus
										text="{i18n>tsOverbooked}"
										state="Warning"
										visible="{ts>Overbooked}"
										class="hrxTsOverbooked" />
								</HBox>
								<HBox renderType="Bare" binding="{ts>days/0}" alignItems="Center" class="hrxTsTimeCell">
									<Input
										value="{ts>time}"
										visible="{ts>editable}"
										change=".onTimeChange"
										placeholder="{i18n>tsTimePlaceholder}"
										class="hrxTsTimeInput" />
									<Button
										icon="sap-icon://tabler/message-2"
										tooltip="{parts: ['ts>comment', 'ts>commentRequired'], formatter: '.formatCommentTooltip'}"
										visible="{ts>editable}"
										press=".onOpenComment"
										class="hrxTsCommentButton">
										<customData>
											<core:CustomData
												key="comment"
												value="{parts: ['ts>comment', 'ts>commentError'], formatter: '.formatCommentState'}"
												writeToDom="true" />
										</customData>
									</Button>
									<Text text="{= ${ts>time} || '—' }" visible="{= !${ts>editable} }" class="hrxTsCellText" />
								</HBox>
								<HBox renderType="Bare" binding="{ts>days/1}" alignItems="Center" class="hrxTsTimeCell">
									<Input
										value="{ts>time}"
										visible="{ts>editable}"
										change=".onTimeChange"
										placeholder="{i18n>tsTimePlaceholder}"
										class="hrxTsTimeInput" />
									<Button
										icon="sap-icon://tabler/message-2"
										tooltip="{parts: ['ts>comment', 'ts>commentRequired'], formatter: '.formatCommentTooltip'}"
										visible="{ts>editable}"
										press=".onOpenComment"
										class="hrxTsCommentButton">
										<customData>
											<core:CustomData
												key="comment"
												value="{parts: ['ts>comment', 'ts>commentError'], formatter: '.formatCommentState'}"
												writeToDom="true" />
										</customData>
									</Button>
									<Text text="{= ${ts>time} || '—' }" visible="{= !${ts>editable} }" class="hrxTsCellText" />
								</HBox>
								<HBox renderType="Bare" binding="{ts>days/2}" alignItems="Center" class="hrxTsTimeCell">
									<Input
										value="{ts>time}"
										visible="{ts>editable}"
										change=".onTimeChange"
										placeholder="{i18n>tsTimePlaceholder}"
										class="hrxTsTimeInput" />
									<Button
										icon="sap-icon://tabler/message-2"
										tooltip="{parts: ['ts>comment', 'ts>commentRequired'], formatter: '.formatCommentTooltip'}"
										visible="{ts>editable}"
										press=".onOpenComment"
										class="hrxTsCommentButton">
										<customData>
											<core:CustomData
												key="comment"
												value="{parts: ['ts>comment', 'ts>commentError'], formatter: '.formatCommentState'}"
												writeToDom="true" />
										</customData>
									</Button>
									<Text text="{= ${ts>time} || '—' }" visible="{= !${ts>editable} }" class="hrxTsCellText" />
								</HBox>
								<HBox renderType="Bare" binding="{ts>days/3}" alignItems="Center" class="hrxTsTimeCell">
									<Input
										value="{ts>time}"
										visible="{ts>editable}"
										change=".onTimeChange"
										placeholder="{i18n>tsTimePlaceholder}"
										class="hrxTsTimeInput" />
									<Button
										icon="sap-icon://tabler/message-2"
										tooltip="{parts: ['ts>comment', 'ts>commentRequired'], formatter: '.formatCommentTooltip'}"
										visible="{ts>editable}"
										press=".onOpenComment"
										class="hrxTsCommentButton">
										<customData>
											<core:CustomData
												key="comment"
												value="{parts: ['ts>comment', 'ts>commentError'], formatter: '.formatCommentState'}"
												writeToDom="true" />
										</customData>
									</Button>
									<Text text="{= ${ts>time} || '—' }" visible="{= !${ts>editable} }" class="hrxTsCellText" />
								</HBox>
								<HBox renderType="Bare" binding="{ts>days/4}" alignItems="Center" class="hrxTsTimeCell">
									<Input
										value="{ts>time}"
										visible="{ts>editable}"
										change=".onTimeChange"
										placeholder="{i18n>tsTimePlaceholder}"
										class="hrxTsTimeInput" />
									<Button
										icon="sap-icon://tabler/message-2"
										tooltip="{parts: ['ts>comment', 'ts>commentRequired'], formatter: '.formatCommentTooltip'}"
										visible="{ts>editable}"
										press=".onOpenComment"
										class="hrxTsCommentButton">
										<customData>
											<core:CustomData
												key="comment"
												value="{parts: ['ts>comment', 'ts>commentError'], formatter: '.formatCommentState'}"
												writeToDom="true" />
										</customData>
									</Button>
									<Text text="{= ${ts>time} || '—' }" visible="{= !${ts>editable} }" class="hrxTsCellText" />
								</HBox>
								<HBox renderType="Bare" binding="{ts>days/5}" alignItems="Center" class="hrxTsTimeCell">
									<Input
										value="{ts>time}"
										visible="{ts>editable}"
										change=".onTimeChange"
										placeholder="{i18n>tsTimePlaceholder}"
										class="hrxTsTimeInput" />
									<Button
										icon="sap-icon://tabler/message-2"
										tooltip="{parts: ['ts>comment', 'ts>commentRequired'], formatter: '.formatCommentTooltip'}"
										visible="{ts>editable}"
										press=".onOpenComment"
										class="hrxTsCommentButton">
										<customData>
											<core:CustomData
												key="comment"
												value="{parts: ['ts>comment', 'ts>commentError'], formatter: '.formatCommentState'}"
												writeToDom="true" />
										</customData>
									</Button>
									<Text text="{= ${ts>time} || '—' }" visible="{= !${ts>editable} }" class="hrxTsCellText" />
								</HBox>
								<HBox renderType="Bare" binding="{ts>days/6}" alignItems="Center" class="hrxTsTimeCell">
									<Input
										value="{ts>time}"
										visible="{ts>editable}"
										change=".onTimeChange"
										placeholder="{i18n>tsTimePlaceholder}"
										class="hrxTsTimeInput" />
									<Button
										icon="sap-icon://tabler/message-2"
										tooltip="{parts: ['ts>comment', 'ts>commentRequired'], formatter: '.formatCommentTooltip'}"
										visible="{ts>editable}"
										press=".onOpenComment"
										class="hrxTsCommentButton">
										<customData>
											<core:CustomData
												key="comment"
												value="{parts: ['ts>comment', 'ts>commentError'], formatter: '.formatCommentState'}"
												writeToDom="true" />
										</customData>
									</Button>
									<Text text="{= ${ts>time} || '—' }" visible="{= !${ts>editable} }" class="hrxTsCellText" />
								</HBox>
							</hrx:cells>
						</hrx:TimesheetRow>
					</hrx:items>
				</hrx:TimesheetTable>

				<HBox renderType="Bare" alignItems="Center" class="hrxTsNote">
					<!-- The live app's outline "i" (Tabler info-circle), drawn inline: the icon
					     fonts only have a filled one. Coloured by .hrxTsNoteIcon. -->
					<core:HTML content="&lt;svg class=&quot;hrxTsNoteIcon&quot; viewBox=&quot;0 0 24 24&quot; aria-hidden=&quot;true&quot;&gt;&lt;circle cx=&quot;12&quot; cy=&quot;12&quot; r=&quot;9&quot;/&gt;&lt;path d=&quot;M12 8h.01M11 12h1v4h1&quot;/&gt;&lt;/svg&gt;" />
					<Text text="{i18n>commentRequiredNote}" />
				</HBox>
			</VBox>
		</content>
	</Page>
</mvc:View>
