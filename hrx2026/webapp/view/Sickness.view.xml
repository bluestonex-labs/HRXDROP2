<mvc:View
	controllerName="bsx.hrx.hrx2026.controller.Sickness"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
	class="hrxSickness">

	<!-- The 15.10.26 design's Sickness page. "Record sickness" is the page action in
	     the shell's top bar, which calls onPageAction on this page's controller. -->
	<Page id="sicknessPage" showHeader="false" title="{i18n>skTitle}" showNavButton="false" class="hrxPageContent">
		<content>
			<!-- Manager rights come from the signed-in profile, so a direct link to this
			     page still lands on the notice rather than on anyone's sickness record. -->
			<IllustratedMessage
				visible="{= !${app>/user/isManager} }"
				illustrationType="sapIllus-UnableToLoad"
				title="{i18n>skTitle}"
				description="{i18n>adminRestricted}" />

			<VBox visible="{app>/user/isManager}" busy="{skView>/busy}" busyIndicatorDelay="0" renderType="Bare" class="hrxSickBody">

				<!-- the policy alert: crit while any trigger is open, ok otherwise -->
				<HBox alignItems="Center" renderType="Bare" class="hrxSickAlert">
					<customData>
						<core:CustomData key="state" value="{skView>/alert/state}" writeToDom="true" />
					</customData>
					<core:Icon src="sap-icon://message-information" class="hrxSickAlertIcon" />
					<Text text="{skView>/alert/text}" class="hrxSickAlertText" />
				</HBox>

				<MessageStrip
					text="{i18n>serviceNeededSickness}"
					type="Warning"
					showIcon="true"
					enableFormattedText="true"
					visible="{= !${skView>/reviewBound} }"
					class="hrxSickServiceNeeded" />

				<!-- ============================ policy triggers ============================ -->
				<!-- The financial year being looked at sits at the end of the section head:
				     the design has one period only, the app can step back through past years. -->
				<HBox alignItems="Center" justifyContent="SpaceBetween" renderType="Bare" class="hrxSickSectionHead">
					<Title text="{i18n>skTriggersTitle}" level="H2" class="hrxSickSectionTitle" />
					<HBox alignItems="Center" renderType="Bare" class="hrxSickYearNav">
						<Button
							id="sicknessPrevYear"
							icon="sap-icon://navigation-left-arrow"
							type="Transparent"
							tooltip="{i18n>skPreviousYear}"
							press=".onStepYear"
							class="hrxSickYearBtn hrxSickYearPrev">
							<customData>
								<core:CustomData key="step" value="previous" />
							</customData>
						</Button>
						<Text text="{skView>/year/label}" class="hrxSickYearLabel" />
						<Button
							id="sicknessNextYear"
							icon="sap-icon://navigation-right-arrow"
							type="Transparent"
							tooltip="{i18n>skNextYear}"
							enabled="{= !${skView>/isCurrentYear} }"
							press=".onStepYear"
							class="hrxSickYearBtn hrxSickYearNext">
							<customData>
								<core:CustomData key="step" value="next" />
							</customData>
						</Button>
					</HBox>
				</HBox>

				<VBox visible="{= ${sk>/triggers}.length === 0 }" renderType="Bare" class="hrxSickCard hrxSickEmpty">
					<Text text="{skView>/noTriggersText}" textAlign="Center" class="hrxSickEmptyTitle" />
				</VBox>

				<VBox items="{path: 'sk>/triggers', templateShareable: false}" renderType="Bare" class="hrxSickStack">
					<VBox renderType="Bare" class="hrxSickCard hrxSickTrigger">
						<customData>
							<core:CustomData key="status" value="{sk>status}" writeToDom="true" />
						</customData>

						<HBox alignItems="Center" renderType="Bare" class="hrxSickTrigHead">
							<Image src="{= ${pictures>/users}[${sk>EmpID}] || '' }" visible="{= !!${pictures>/users}[${sk>EmpID}] }" width="42px" height="42px" class="hrxAvatarPic" />
							<Text text="{sk>initials}" wrapping="false" visible="{= !${pictures>/users}[${sk>EmpID}] }" class="hrxSickAvatar hrxSickAvatarGrad hrxSickAvatarBig" />
							<VBox renderType="Bare" class="hrxSickTrigWho">
								<Text text="{sk>Name}" class="hrxSickTrigName" />
								<Text text="{skView>/year/label}" class="hrxSickTrigSub" />
							</VBox>
							<Text text="{sk>pillText}" wrapping="false" class="hrxSickPill">
								<customData>
									<core:CustomData key="kind" value="{sk>pillKind}" writeToDom="true" />
								</customData>
							</Text>
						</HBox>

						<VBox renderType="Bare" class="hrxSickTrigBody">
							<Text text="{skView>/ruleText}" class="hrxSickTrigRule" />
							<Text text="{sk>summary}" class="hrxSickTrigSum" />

							<!-- absence history: collapsed until asked for -->
							<HBox alignItems="Center" renderType="Bare" class="hrxSickToggleRow">
								<customData>
									<core:CustomData key="open" value="{= ${sk>expanded} ? 'yes' : 'no' }" writeToDom="true" />
								</customData>
								<Button
									text="{i18n>skHistory}"
									icon="sap-icon://navigation-right-arrow"
									type="Transparent"
									press=".onToggleHistory"
									class="hrxSickToggle" />
								<Text text="{sk>historyCount}" wrapping="false" class="hrxSickToggleCount" />
							</HBox>

							<VBox visible="{sk>expanded}" renderType="Bare" class="hrxSickHistory">
								<Table items="{path: 'sk>absences', templateShareable: false}" class="hrxSickTable">
									<columns>
										<Column width="40%"><Text text="{i18n>skColDate}" /></Column>
										<Column width="20%" hAlign="Center"><Text text="{i18n>skColDuration}" /></Column>
										<Column><Text text="{i18n>skColReason}" /></Column>
									</columns>
									<items>
										<ColumnListItem>
											<cells>
												<Text text="{sk>dateText}" />
												<Text text="{sk>durationText}" />
												<Text text="{sk>Reason}" />
											</cells>
										</ColumnListItem>
									</items>
								</Table>
							</VBox>

							<Text text="{i18n>skRecommended}" class="hrxSickLabel" />
							<Text text="{i18n>skRecommendation}" class="hrxSickTrigRec" />

							<Text
								text="{sk>emailedText}"
								visible="{= ${sk>emailed} &amp;&amp; ${sk>status} === 'OPEN' }"
								class="hrxSickTrigNote" />
							<HBox wrap="Wrap" visible="{= ${sk>status} === 'OPEN' }" renderType="Bare" class="hrxSickTrigActs">
								<Button
									text="{= ${sk>emailed} ? ${i18n>skSendAnother} : ${i18n>skSendFollowUp} }"
									icon="sap-icon://email"
									press=".onSendFollowUp"
									class="hrxSickBtnSm hrxSickBtnMail" />
								<Button
									text="{sk>dismissText}"
									press=".onOpenDismiss"
									class="hrxSickBtnSm" />
							</HBox>
						</VBox>
					</VBox>
				</VBox>

				<!-- ============================ return to work ============================= -->
				<HBox alignItems="Center" renderType="Bare" class="hrxSickSectionHead">
					<Title text="{i18n>skRtwTitle}" level="H2" class="hrxSickSectionTitle" />
				</HBox>

				<VBox visible="{= ${sk>/rtw}.length === 0 }" renderType="Bare" class="hrxSickCard hrxSickEmpty">
					<Text text="{i18n>skNoRtw}" textAlign="Center" class="hrxSickEmptyTitle" />
				</VBox>

				<!-- auto-fill columns of at least 380px, as the design's .rtw-grid -->
				<FlexBox
					items="{path: 'sk>/rtw', templateShareable: false}"
					visible="{= ${sk>/rtw}.length > 0 }"
					renderType="Bare"
					class="hrxSickRtwGrid">
					<VBox renderType="Bare" class="hrxSickCard hrxSickRtw">
						<HBox alignItems="Center" justifyContent="SpaceBetween" renderType="Bare" class="hrxSickRtwHead">
							<HBox alignItems="Center" renderType="Bare" class="hrxSickPerson">
								<Image src="{= ${pictures>/users}[${sk>EmpID}] || '' }" visible="{= !!${pictures>/users}[${sk>EmpID}] }" width="30px" height="30px" class="hrxAvatarPic" />
								<Text text="{sk>initials}" wrapping="false" visible="{= !${pictures>/users}[${sk>EmpID}] }" class="hrxSickAvatar hrxSickAvatarGrad" />
								<VBox renderType="Bare">
									<Text text="{sk>Name}" class="hrxSickPersonName" />
									<Text text="{sk>Title}" visible="{= !!${sk>Title} }" class="hrxSickPersonSub" />
								</VBox>
							</HBox>
							<Text text="{i18n>skInProgress}" wrapping="false" class="hrxSickPill">
								<customData>
									<core:CustomData key="kind" value="warn" writeToDom="true" />
								</customData>
							</Text>
						</HBox>

						<VBox renderType="Bare" class="hrxSickRtwBody">
							<Text text="{i18n>skSteps}" class="hrxSickLabel hrxSickLabelFirst" />
							<VBox items="{path: 'sk>steps', templateShareable: false}" renderType="Bare" class="hrxSickSteps">
								<HBox alignItems="Center" renderType="Bare" class="hrxSickStep">
									<customData>
										<core:CustomData key="done" value="{= ${sk>done} ? 'yes' : 'no' }" writeToDom="true" />
									</customData>
									<core:Icon src="sap-icon://accept" class="hrxSickStepIcon" />
									<Text text="{sk>Text}" class="hrxSickStepText" />
									<Button
										text="{i18n>skMarkDone}"
										visible="{= !${sk>done} }"
										press=".onMarkStepDone"
										class="hrxSickBtnSm" />
								</HBox>
							</VBox>

							<HBox justifyContent="End" renderType="Bare" class="hrxSickRtwFoot">
								<Button
									text="{i18n>skEmail}"
									icon="sap-icon://email"
									enabled="{= !!${sk>Email} }"
									press=".onEmailRtw"
									class="hrxSickBtnSm hrxSickBtnMail" />
								<Button
									text="{i18n>skCompleteRtw}"
									type="Emphasized"
									press=".onCompleteRtw"
									class="hrxSickBtnSm" />
							</HBox>
						</VBox>
					</VBox>
				</FlexBox>

				<!-- ============== every absence in the year, collapsed until asked for ============== -->
				<VBox renderType="Bare" class="hrxSickCard hrxSickAll">
					<customData>
						<core:CustomData key="open" value="{= ${skView>/allExpanded} ? 'yes' : 'no' }" writeToDom="true" />
					</customData>
					<HBox alignItems="Center" justifyContent="SpaceBetween" renderType="Bare" class="hrxSickAllHead">
						<Button
							text="{i18n>skAllTitle}"
							icon="sap-icon://navigation-right-arrow"
							type="Transparent"
							press=".onToggleAll"
							class="hrxSickAllToggle" />
						<Text text="{skView>/allCount}" wrapping="false" class="hrxSickAllHint" />
					</HBox>
					<Table
						id="sicknessTable"
						items="{sk>/absences}"
						visible="{skView>/allExpanded}"
						noDataText="{i18n>skNoAbsences}"
						growing="true"
						growingThreshold="50"
						class="hrxSickTable hrxSickAllTable">
						<columns>
							<!-- the widths the design's table settles on at full width -->
							<Column width="24%"><Text text="{i18n>skColEmployee}" /></Column>
							<Column width="29%" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>skColDate}" /></Column>
							<Column width="13%" hAlign="Center" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>skColDuration}" /></Column>
							<Column width="18%" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>skColReason}" /></Column>
							<Column hAlign="End"><Text text="{i18n>skColStatus}" /></Column>
						</columns>
						<items>
							<ColumnListItem>
								<cells>
									<HBox alignItems="Center" renderType="Bare" class="hrxSickPerson">
										<Image src="{= ${pictures>/users}[${sk>EmpID}] || '' }" visible="{= !!${pictures>/users}[${sk>EmpID}] }" width="30px" height="30px" class="hrxAvatarPic" />
										<Text text="{sk>initials}" wrapping="false" visible="{= !${pictures>/users}[${sk>EmpID}] }" class="hrxSickAvatar" />
										<VBox renderType="Bare">
											<Text text="{sk>Name}" class="hrxSickAllName" />
											<Text
												text="{sk>dismissedNote}"
												tooltip="{sk>dismissedTooltip}"
												visible="{sk>dismissed}"
												maxLines="2"
												class="hrxSickPersonSub" />
										</VBox>
									</HBox>
									<Text text="{sk>dateText}" />
									<Text text="{sk>durationText}" />
									<Text text="{sk>Reason}" />
									<Text text="{sk>statusText}" wrapping="false" class="hrxSickPill">
										<customData>
											<core:CustomData key="kind" value="{sk>statusKind}" writeToDom="true" />
										</customData>
									</Text>
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</VBox>
			</VBox>
		</content>
	</Page>
</mvc:View>
