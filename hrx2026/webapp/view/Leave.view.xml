<mvc:View
	controllerName="bsx.hrx.hrx2026.controller.Leave"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
	class="hrxMyLeave">

	<!-- My Leave, laid out as the 15.10.26 design's "leave" view: three balance tiles,
	     the New Leave Request card beside the Leave Calendar, then the Leave Requests
	     table. The page title sits in the shell's top bar (App.view.xml). -->
	<Page id="leavePage" showHeader="false" title="{i18n>leaveTitle}" showNavButton="false" class="hrxPageContent">
		<content>

			<!-- ── Balance tiles (the design's .kpis row) ─────────────────────── -->
			<HBox renderType="Bare" class="hrxLeaveKpis">

				<VBox renderType="Bare" class="hrxLeaveKpi hrxLeaveKpiNeutral">
					<core:Icon src="sap-icon://tabler/calendar-stats" class="hrxLeaveKpiGlyph" />
					<Text text="{i18n>kpiAnnualQuota}" class="hrxLeaveKpiLabel" />
					<HBox renderType="Bare" class="hrxLeaveKpiFigure">
						<Text id="leaveKpiQuota" text="{mlView>/kpis/quota}" class="hrxLeaveKpiNumber" />
						<Text text="{i18n>mlDaysUnit}" class="hrxLeaveKpiUnit" />
					</HBox>
					<Text text="{mlView>/kpis/allowanceText}" class="hrxLeaveKpiSub" />
				</VBox>

				<VBox renderType="Bare" class="hrxLeaveKpi hrxLeaveKpiGood">
					<core:Icon src="sap-icon://tabler/calendar-check" class="hrxLeaveKpiGlyph" />
					<Text text="{i18n>kpiDaysRemaining}" class="hrxLeaveKpiLabel" />
					<HBox renderType="Bare" class="hrxLeaveKpiFigure">
						<Text id="leaveKpiBalance" text="{mlView>/kpis/balance}" class="hrxLeaveKpiNumber" />
						<Text text="{i18n>mlDaysUnit}" class="hrxLeaveKpiUnit" />
					</HBox>
					<Text text="{i18n>mlBalanceSub}" class="hrxLeaveKpiSub" />
				</VBox>

				<VBox renderType="Bare" class="hrxLeaveKpi hrxLeaveKpiWarning">
					<core:Icon src="sap-icon://tabler/calendar-event" class="hrxLeaveKpiGlyph" />
					<Text text="{i18n>kpiDaysBooked}" class="hrxLeaveKpiLabel" />
					<HBox renderType="Bare" class="hrxLeaveKpiFigure">
						<Text id="leaveKpiBooked" text="{mlView>/kpis/used}" class="hrxLeaveKpiNumber" />
						<Text text="{i18n>mlDaysUnit}" class="hrxLeaveKpiUnit" />
					</HBox>
					<Text text="{i18n>mlBookedSub}" class="hrxLeaveKpiSub" />
				</VBox>
			</HBox>

			<!-- ── Request card (340px) beside the calendar (the rest) ────────── -->
			<HBox renderType="Bare" class="hrxLeaveMainGrid">

				<!-- New Leave Request: the design's featured (dark) card head -->
				<VBox id="newLeaveRequestCard" renderType="Bare" class="hrxLeaveCard">
					<HBox renderType="Bare" class="hrxLeaveCardHead hrxLeaveCardHeadFeatured">
						<core:Icon src="sap-icon://tabler/calendar-plus" class="hrxLeaveCardHeadIcon" />
						<Title text="{i18n>newLeaveRequestTitle}" level="H2" class="hrxLeaveCardTitle" />
					</HBox>

					<VBox renderType="Bare" class="hrxLeaveCardBody hrxLeaveRequestBody" busy="{mlView>/saving}" busyIndicatorDelay="0">
						<Label text="{i18n>fieldDates}" labelFor="leaveDatesInput" class="hrxLeaveFieldLabel" />
						<!-- Read-only, as in the design: a click anywhere on the field opens the
						     range picker (fragment/LeaveDatePicker), which offers today onwards. -->
						<Input
							id="leaveDatesInput"
							value="{mlForm>/DatesText}"
							placeholder="{i18n>mlDatesClickPlaceholder}"
							showValueHelp="true"
							valueHelpOnly="true"
							valueHelpRequest=".onOpenDatePicker"
							width="100%"
							class="hrxLeaveDatesInput" />

						<Label text="{i18n>fieldLeaveType}" labelFor="leaveType" class="hrxLeaveFieldLabel" />
						<Select
							id="leaveType"
							width="100%"
							forceSelection="false"
							selectedKey="{mlForm>/LeaveCategoryId}"
							items="{ml>/leaveTypes}">
							<core:Item key="{ml>LeaveCategoryId}" text="{ml>LeaveCategoryDesc}" />
						</Select>

						<Label text="{i18n>fieldDuration}" labelFor="leaveDuration" class="hrxLeaveFieldLabel" />
						<!-- One choice for the whole range, as in the design. "Choose per day"
						     opens the half day dialog for a mix of full and half days. -->
						<Select
							id="leaveDuration"
							width="100%"
							selectedKey="{mlForm>/Duration}"
							change=".onDurationChange">
							<core:Item key="F" text="{i18n>mlDurationFull}" />
							<core:Item key="A" text="{i18n>mlDurationAm}" />
							<core:Item key="P" text="{i18n>mlDurationPm}" />
							<core:Item key="M" text="{i18n>mlDurationPerDay}" />
						</Select>

						<Label text="{i18n>fieldComments}" labelFor="leaveComments" class="hrxLeaveFieldLabel" />
						<TextArea
							id="leaveComments"
							value="{mlForm>/Comments}"
							rows="3"
							width="100%"
							placeholder="{i18n>mlOptional}" />

						<Label text="{i18n>fieldApprover}" class="hrxLeaveFieldLabel" />
						<Text
							id="leaveApprover"
							text="{= ${mlView>/user/managerName} || ${i18n>mlNoApprover} }"
							class="hrxLeaveApprover" />

						<!-- The design's .card-spacer: keeps the button on the card's foot -->
						<HBox renderType="Bare" class="hrxLeaveCardSpacer" />

						<Button
							id="leaveSubmit"
							text="{i18n>btnRequestLeave}"
							type="Emphasized"
							width="100%"
							enabled="{= !${mlView>/saving} }"
							press=".onSubmitLeave"
							class="hrxLeaveSubmit" />
					</VBox>
				</VBox>

				<!-- Leave Calendar: one month at a time, each day in its leave type's colour -->
				<VBox id="leaveCalendarCard" renderType="Bare" class="hrxLeaveCard">
					<HBox renderType="Bare" class="hrxLeaveCardHead">
						<Title text="{i18n>mlCalendarTitle}" level="H2" class="hrxLeaveCardTitle" />
					</HBox>

					<VBox renderType="Bare" class="hrxLeaveCardBody" busy="{mlView>/busy}" busyIndicatorDelay="0">
						<HBox renderType="Bare" class="hrxLeaveMonthHead">
							<Button
								id="leaveCalendarPrevious"
								icon="sap-icon://navigation-left-arrow"
								tooltip="{i18n>mlPreviousMonth}"
								press=".onCalendarPrevious"
								class="hrxLeaveNavButton" />
							<Text id="leaveCalendarTitle" text="{mlCal>/title}" class="hrxLeaveMonthTitle" />
							<Button
								id="leaveCalendarNext"
								icon="sap-icon://navigation-right-arrow"
								tooltip="{i18n>mlNextMonth}"
								press=".onCalendarNext"
								class="hrxLeaveNavButton" />
						</HBox>

						<HBox renderType="Bare" class="hrxLeaveMonthGrid">
							<Text text="{i18n>mlDayMo}" class="hrxLeaveWeekday" />
							<Text text="{i18n>mlDayTu}" class="hrxLeaveWeekday" />
							<Text text="{i18n>mlDayWe}" class="hrxLeaveWeekday" />
							<Text text="{i18n>mlDayTh}" class="hrxLeaveWeekday" />
							<Text text="{i18n>mlDayFr}" class="hrxLeaveWeekday" />
							<Text text="{i18n>mlDaySa}" class="hrxLeaveWeekday" />
							<Text text="{i18n>mlDaySu}" class="hrxLeaveWeekday" />
						</HBox>

						<!-- Each day writes its state (muted, weekend, today) and leave type
						     (data-leave) to the DOM, where leave.css colours it. -->
						<HBox id="leaveCalendarGrid" renderType="Bare" class="hrxLeaveMonthGrid" items="{mlCal>/cells}">
							<Text text="{mlCal>label}" tooltip="{mlCal>tooltip}" class="hrxLeaveMonthDay">
								<customData>
									<core:CustomData key="cell" value="{mlCal>state}" writeToDom="true" />
									<core:CustomData key="leave" value="{mlCal>leave}" writeToDom="true" />
								</customData>
							</Text>
						</HBox>

						<!-- The colour key. Bank holidays are not in the design's key, but the
						     service returns them and the calendar marks them. -->
						<HBox renderType="Bare" class="hrxLeaveLegend">
							<Text text="{i18n>tcLegendCompassionate}" class="hrxLeaveLegendItem">
								<customData><core:CustomData key="leave" value="COMPL" writeToDom="true" /></customData>
							</Text>
							<Text text="{i18n>tcLegendHoliday}" class="hrxLeaveLegendItem">
								<customData><core:CustomData key="leave" value="HOLIL" writeToDom="true" /></customData>
							</Text>
							<Text text="{i18n>mlLegendMaternity}" class="hrxLeaveLegendItem">
								<customData><core:CustomData key="leave" value="MATEL" writeToDom="true" /></customData>
							</Text>
							<Text text="{i18n>mlLegendPaternity}" class="hrxLeaveLegendItem">
								<customData><core:CustomData key="leave" value="PATEL" writeToDom="true" /></customData>
							</Text>
							<Text text="{i18n>tcLegendSick}" class="hrxLeaveLegendItem">
								<customData><core:CustomData key="leave" value="SICKL" writeToDom="true" /></customData>
							</Text>
							<Text text="{i18n>tcLegendUnpaid}" class="hrxLeaveLegendItem">
								<customData><core:CustomData key="leave" value="UNPDL" writeToDom="true" /></customData>
							</Text>
							<Text text="{i18n>tcLegendBankHoliday}" class="hrxLeaveLegendItem">
								<customData><core:CustomData key="leave" value="BANK" writeToDom="true" /></customData>
							</Text>
						</HBox>
					</VBox>
				</VBox>
			</HBox>

			<!-- ── Leave Requests (the design's .tablecard) ───────────────────── -->
			<VBox id="myLeaveCard" renderType="Bare" class="hrxLeaveTableCard">
				<HBox renderType="Bare" class="hrxLeaveTableTop">
					<Title text="{i18n>mlRequestsTitle}" level="H2" class="hrxLeaveCardTitle" />
					<SegmentedButton
						id="leaveStatusFilter"
						selectedKey="{mlView>/statusFilter}"
						selectionChange=".onStatusFilter"
						class="hrxLeaveSeg">
						<items>
							<SegmentedButtonItem key="All" text="{i18n>mlTabAll}" />
							<SegmentedButtonItem key="Requested" text="{i18n>mlTabRequested}" />
							<SegmentedButtonItem key="Approved" text="{i18n>mlTabApproved}" />
							<SegmentedButtonItem key="Rejected" text="{i18n>mlTabRejected}" />
						</items>
					</SegmentedButton>
				</HBox>

				<!-- One row per request (a request can span several days). A request still
				     awaiting a decision opens the edit dialog and can be cancelled. -->
				<Table
					id="myLeaveTable"
					items="{ml>/leaves}"
					busy="{= ${mlView>/busy} || ${mlView>/saving} }"
					busyIndicatorDelay="0"
					noDataText="{i18n>mlNoLeave}"
					growing="true"
					growingThreshold="50"
					growingScrollToLoad="true"
					class="hrxLeaveTable">
					<columns>
						<Column width="22.1%" styleClass="hrxLeaveColFirst"><Text text="{i18n>mrLeaveColDate}" /></Column>
						<Column width="41.5%"><Text text="{i18n>mlColLeaveType}" /></Column>
						<Column width="18.9%"><Text text="{i18n>mrLeaveColStatus}" /></Column>
						<Column width="17.5%" hAlign="End" styleClass="hrxLeaveColLast"><Text text="" /></Column>
					</columns>
					<items>
						<ColumnListItem
							type="{= ${ml>editable} ? 'Active' : 'Inactive' }"
							press=".onEditLeave">
							<cells>
								<Text text="{ml>DisplayRange}" />
								<HBox renderType="Bare" class="hrxLeaveTypeCell">
									<Text text="{ml>LeaveType}" class="hrxLeaveTypeName">
										<customData><core:CustomData key="leave" value="{ml>LeaveTypeID}" writeToDom="true" /></customData>
									</Text>
									<Text text="{ml>DurationText}" class="hrxLeaveDuration" />
								</HBox>
								<ObjectStatus
									text="{ml>Status}"
									state="{path: 'ml>StatusID', formatter: '.formatter.leaveStatusState'}" />
								<Button
									text="{i18n>mlCancel}"
									visible="{ml>cancellable}"
									press=".onCancelLeave"
									class="hrxLeaveCancelButton" />
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</content>
	</Page>
</mvc:View>
