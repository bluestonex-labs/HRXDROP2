<mvc:View
	controllerName="bsx.hrx.hrx2026.controller.Expenses"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
	class="hrxExpenses">

	<!-- Expenses: the employee's own expense claims (the design's "Expenses" page).
	     Three panels on one page, switched by exView>/panel:
	       list     My claims: filters and the table of claims
	       summary  Summary: what has been approved, is waiting, and needs input
	       claim    one claim: general information, items, mileage and the bar to submit -->
	<Page id="expensesPage" showHeader="false" title="{i18n>exTitle}" class="hrxPageContent">
		<content>
			<VBox busy="{exView>/busy}" busyIndicatorDelay="0" renderType="Bare" class="hrxExBody">

				<MessageStrip
					text="{exView>/error}"
					type="Error"
					showIcon="true"
					visible="{= !!${exView>/error} }"
					class="hrxExStrip" />

				<!-- ═════════ My claims and Summary ═════════ -->
				<VBox renderType="Bare" visible="{= ${exView>/panel} !== 'claim' }" class="hrxExStack">
					<HBox renderType="Bare" class="hrxExTabRow">
						<HBox renderType="Bare" class="hrxExTabs">
							<Button text="{i18n>exTabClaims}" press=".onTabPress" class="hrxExTab">
								<customData>
									<core:CustomData key="tab" value="list" />
									<core:CustomData key="on" value="{= ${exView>/panel} === 'list' ? 'yes' : 'no' }" writeToDom="true" />
								</customData>
							</Button>
							<Button text="{i18n>exTabSummary}" press=".onTabPress" class="hrxExTab">
								<customData>
									<core:CustomData key="tab" value="summary" />
									<core:CustomData key="on" value="{= ${exView>/panel} === 'summary' ? 'yes' : 'no' }" writeToDom="true" />
								</customData>
							</Button>
						</HBox>
					</HBox>

					<!-- My claims -->
					<VBox renderType="Bare" visible="{= ${exView>/panel} === 'list' }" class="hrxExStack">
						<HBox renderType="Bare" class="hrxExFilters">
							<VBox renderType="Bare" class="hrxExField">
								<Label text="{i18n>exFilterPeriodFrom}" />
								<DatePicker value="{exView>/filters/from}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" placeholder="{i18n>exDatePlaceholder}" change=".onFilterChange" />
							</VBox>
							<VBox renderType="Bare" class="hrxExField">
								<Label text="{i18n>exFilterPeriodTo}" />
								<DatePicker value="{exView>/filters/to}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" placeholder="{i18n>exDatePlaceholder}" change=".onFilterChange" />
							</VBox>
							<VBox renderType="Bare" class="hrxExField">
								<Label text="{i18n>exFilterStatus}" />
								<Select selectedKey="{exView>/filters/status}" change=".onFilterChange" items="{exView>/statusOptions}">
									<core:Item key="{exView>key}" text="{exView>text}" />
								</Select>
							</VBox>
							<VBox renderType="Bare" class="hrxExField hrxExFieldGrow">
								<Label text="{i18n>exFilterSearch}" />
								<SearchField value="{exView>/filters/query}" liveChange=".onFilterChange" placeholder="{i18n>exFilterSearchPlaceholder}" />
							</VBox>
							<Button text="{i18n>exFilterClear}" press=".onClearFilters" type="Transparent" class="hrxExGhost hrxExClear" />
						</HBox>

						<VBox renderType="Bare" class="hrxExCard">
							<VBox renderType="Bare" class="hrxExCardHead">
								<Title text="{i18n>exListTitle}" level="H3" class="hrxExCardTitle" />
								<Text text="{ex>/listHint}" class="hrxExCardHint" />
							</VBox>
							<VBox renderType="Bare" visible="{= ${ex>/rows}.length === 0 }" class="hrxExEmpty">
								<Text text="{= ${ex>/claims}.length ? ${i18n>exNoMatch} : ${i18n>exNoClaims} }" class="hrxExEmptyTitle" />
								<Text text="{= ${ex>/claims}.length ? ${i18n>exNoMatchText} : ${i18n>exNoClaimsText} }" class="hrxExEmptyText" />
							</VBox>
							<Table
								items="{path: 'ex>/rows', templateShareable: false}"
								visible="{= ${ex>/rows}.length > 0 }"
								mode="None"
								fixedLayout="false"
								itemPress=".onOpenClaim"
								class="hrxExTable hrxExClaimsTable">
								<columns>
									<Column><Text text="{i18n>exColNumber}" /></Column>
									<Column><Text text="{i18n>exColPeriod}" /></Column>
									<Column><Text text="{i18n>exColStatus}" /></Column>
									<Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>exColNet}" /></Column>
									<Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>exColTax}" /></Column>
									<Column hAlign="End"><Text text="{i18n>exColTotal}" /></Column>
								</columns>
								<items>
									<ColumnListItem type="Active">
										<cells>
											<Text text="{ex>numberText}" class="hrxExStrong" />
											<Text text="{ex>periodText}" />
											<ObjectStatus text="{ex>statusText}" state="{ex>statusState}" class="hrxExPill" />
											<Text text="{ex>netText}" />
											<Text text="{ex>taxText}" />
											<Text text="{ex>totalText}" class="hrxExStrong" />
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</VBox>
					</VBox>

					<!-- Summary -->
					<VBox renderType="Bare" visible="{= ${exView>/panel} === 'summary' }" class="hrxExStack">
						<HBox renderType="Bare" class="hrxExKpis">
							<VBox renderType="Bare" class="hrxExKpi">
								<customData><core:CustomData key="state" value="Good" writeToDom="true" /></customData>
								<core:Icon src="sap-icon://tabler/circle-check" class="hrxExKpiGlyph" />
								<Text text="{i18n>exKpiApproved}" class="hrxExKpiLabel" />
								<Text text="{ex>/summary/approvedText}" class="hrxExKpiValue" />
								<Text text="{ex>/summary/approvedSub}" class="hrxExKpiSub" />
							</VBox>
							<VBox renderType="Bare" class="hrxExKpi">
								<core:Icon src="sap-icon://tabler/hourglass" class="hrxExKpiGlyph" />
								<Text text="{i18n>exKpiPending}" class="hrxExKpiLabel" />
								<Text text="{ex>/summary/pendingText}" class="hrxExKpiValue" />
								<Text text="{ex>/summary/pendingSub}" class="hrxExKpiSub" />
							</VBox>
							<VBox renderType="Bare" class="hrxExKpi">
								<core:Icon src="sap-icon://tabler/receipt-tax" class="hrxExKpiGlyph" />
								<Text text="{ex>/summary/taxLabel}" class="hrxExKpiLabel" />
								<Text text="{ex>/summary/taxText}" class="hrxExKpiValue" />
								<Text text="{i18n>exKpiTaxSub}" class="hrxExKpiSub" />
							</VBox>
							<VBox renderType="Bare" class="hrxExKpi">
								<customData><core:CustomData key="state" value="{= ${ex>/summary/attention} > 0 ? 'Warning' : 'Good' }" writeToDom="true" /></customData>
								<core:Icon src="sap-icon://tabler/alert-triangle" class="hrxExKpiGlyph" />
								<Text text="{i18n>exKpiAttention}" class="hrxExKpiLabel" />
								<Text text="{ex>/summary/attention}" class="hrxExKpiValue" />
								<Text text="{i18n>exKpiAttentionSub}" class="hrxExKpiSub" />
							</VBox>
						</HBox>

						<HBox renderType="Bare" class="hrxExGrid2">
							<VBox renderType="Bare" class="hrxExCard">
								<HBox renderType="Bare" class="hrxExCardHead hrxExCardHeadRow">
									<Title text="{i18n>exSpendByType}" level="H3" class="hrxExCardTitle" />
									<Text text="{i18n>exSpendByTypeHint}" class="hrxExCardHint" />
								</HBox>
								<VBox renderType="Bare" class="hrxExPadded">
									<VBox renderType="Bare" visible="{= ${ex>/summary/byType}.length === 0 }" class="hrxExEmpty">
										<Text text="{i18n>exNoSpend}" class="hrxExEmptyTitle" />
									</VBox>
									<VBox items="{path: 'ex>/summary/byType', templateShareable: false}" renderType="Bare">
										<VBox renderType="Bare" class="hrxExBarRow">
											<HBox renderType="Bare" class="hrxExBarLabel">
												<Text text="{ex>type}" />
												<Text text="{ex>amountText}" class="hrxExStrong" />
											</HBox>
											<core:HTML content="{= '&lt;div class=&quot;hrxExBarTrack&quot;&gt;&lt;div class=&quot;hrxExBarFill&quot; style=&quot;width:' + ${ex>percent} + '%&quot;&gt;&lt;/div&gt;&lt;/div&gt;' }" />
										</VBox>
									</VBox>
								</VBox>
							</VBox>
							<VBox renderType="Bare" class="hrxExCard">
								<HBox renderType="Bare" class="hrxExCardHead hrxExCardHeadRow">
									<Title text="{i18n>exNeedsInput}" level="H3" class="hrxExCardTitle" />
									<Text text="{i18n>exNeedsInputHint}" class="hrxExCardHint" />
								</HBox>
								<VBox renderType="Bare" class="hrxExPadded">
									<VBox renderType="Bare" visible="{= ${ex>/summary/attentionRows}.length === 0 }" class="hrxExEmpty">
										<Text text="{i18n>exNothingNeededTitle}" class="hrxExEmptyTitle" />
										<Text text="{i18n>exNothingNeededText}" class="hrxExEmptyText" />
									</VBox>
									<VBox items="{path: 'ex>/summary/attentionRows', templateShareable: false}" renderType="Bare">
										<HBox renderType="Bare" class="hrxExAttn">
											<customData><core:CustomData key="claim" value="{ex>claimId}" /></customData>
											<VBox renderType="Bare">
												<Link text="{ex>title}" press=".onOpenAttention" class="hrxExAttnTitle" />
												<Text text="{ex>issue}" class="hrxExAttnIssue" />
											</VBox>
											<Text text="{ex>amountText}" class="hrxExStrong" />
										</HBox>
									</VBox>
								</VBox>
							</VBox>
						</HBox>
					</VBox>
				</VBox>

				<!-- ═════════ One claim ═════════ -->
				<VBox renderType="Bare" visible="{= ${exView>/panel} === 'claim' }" class="hrxExClaim">
					<HBox renderType="Bare" class="hrxExHeadRow">
						<Button text="{i18n>exBack}" icon="sap-icon://arrow-left" press=".onBack" type="Transparent" class="hrxExGhost hrxExSmall" />
						<Text text="{= ${ex>/claim/claimNumber} ? ${i18n>exClaimTitle} + ' ' + ${ex>/claim/claimNumber} : ${i18n>exNewClaim} }" class="hrxExTitle" />
						<ObjectStatus text="{ex>/claim/statusText}" state="{ex>/claim/statusState}" class="hrxExPill" />
					</HBox>

					<MessageStrip
						text="{ex>/claim/banner}"
						type="{ex>/claim/bannerType}"
						showIcon="true"
						visible="{= !!${ex>/claim/banner} }"
						class="hrxExStrip" />

					<!-- General information -->
					<VBox renderType="Bare" class="hrxExCard">
						<VBox renderType="Bare" class="hrxExCardHead">
							<Title text="{i18n>exGeneral}" level="H3" class="hrxExCardTitle" />
						</VBox>
						<HBox renderType="Bare" class="hrxExGeneral">
							<VBox renderType="Bare">
								<!-- The country follows the employee's site; it can be changed (UK or
								     India) until the first line is added, as the lines are in its currency -->
								<HBox renderType="Bare" class="hrxExKv">
									<Label text="{i18n>exCountry}" />
									<Select
										selectedKey="{ex>/claim/country}"
										visible="{= !${exView>/readOnly} &amp;&amp; ${ex>/claim/items}.length === 0 &amp;&amp; ${ex>/claim/mileageClaims}.length === 0 }"
										change=".onCountryChange"
										width="210px">
										<core:Item key="UK" text="{i18n>eaUk}" />
										<core:Item key="IN" text="{i18n>eaIndia}" />
									</Select>
									<Text text="{ex>/claim/countryName}"
										visible="{= !!${exView>/readOnly} || ${ex>/claim/items}.length > 0 || ${ex>/claim/mileageClaims}.length > 0 }" />
								</HBox>
								<HBox renderType="Bare" class="hrxExKv">
									<Label text="{i18n>exClaimPeriod}" required="true" />
									<DatePicker
										value="{ex>/claim/claimPeriod}"
										valueFormat="yyyy-MM-dd"
										displayFormat="d MMM yyyy"
										editable="{= !${exView>/readOnly} }"
										valueState="{= ${exView>/showErrors} &amp;&amp; !${ex>/claim/claimPeriod} ? 'Error' : 'None' }"
										change=".onClaimPeriodChange"
										width="210px" />
								</HBox>
							</VBox>
							<VBox renderType="Bare">
								<HBox renderType="Bare" class="hrxExKv">
									<Label text="{i18n>exEmployee}" />
									<Text text="{ex>/claim/employeeName}" />
								</HBox>
								<HBox renderType="Bare" class="hrxExKv">
									<Label text="{i18n>exEmployeeNumber}" />
									<Text text="{ex>/claim/employeeNumber}" />
								</HBox>
								<HBox renderType="Bare" class="hrxExKv">
									<Label text="{i18n>exSiteCurrency}" />
									<Text text="{ex>/claim/currency}" />
								</HBox>
							</VBox>
						</HBox>
					</VBox>

					<!-- Expense items -->
					<VBox renderType="Bare" class="hrxExCard">
						<HBox renderType="Bare" class="hrxExCardHead hrxExCardHeadRow">
							<VBox renderType="Bare">
								<Title text="{i18n>exItems}" level="H3" class="hrxExCardTitle" />
								<Text text="{ex>/claim/itemsHint}" class="hrxExCardHint" />
							</VBox>
							<HBox renderType="Bare" class="hrxExHeadButtons">
								<!-- Lines (one row per item, details on demand) or Grid (every field
								     in a spreadsheet-style table), as the design offers both -->
								<HBox renderType="Bare" class="hrxExSeg">
									<Button text="{i18n>exModeLines}" press=".onItemModePress" type="Transparent">
										<customData>
											<core:CustomData key="mode" value="lines" />
											<core:CustomData key="on" value="{= ${exView>/itemMode} !== 'grid' ? 'yes' : 'no' }" writeToDom="true" />
										</customData>
									</Button>
									<Button text="{i18n>exModeGrid}" press=".onItemModePress" type="Transparent">
										<customData>
											<core:CustomData key="mode" value="grid" />
											<core:CustomData key="on" value="{= ${exView>/itemMode} === 'grid' ? 'yes' : 'no' }" writeToDom="true" />
										</customData>
									</Button>
								</HBox>
								<Button text="{i18n>exFromScreenshotButton}" icon="sap-icon://iphone" press=".onPickScreenshots" visible="{= !${exView>/readOnly} }" class="hrxExGhost" />
								<Button text="{i18n>exAddFromReceipt}" icon="sap-icon://attachment" press=".onPickReceipts" visible="{= !${exView>/readOnly} }" class="hrxExGhost" />
								<Button text="{i18n>exAddItem}" icon="sap-icon://add" type="Emphasized" press=".onAddItem" visible="{= !${exView>/readOnly} }" class="hrxExPrimary" />
							</HBox>
						</HBox>

						<!-- Drop zone: each receipt dropped here is read and becomes a line -->
						<core:HTML
							id="receiptDrop"
							visible="{= !${exView>/readOnly} }"
							content="{= '&lt;div class=&quot;hrxExDropWrap&quot;&gt;&lt;div class=&quot;hrxExDrop&quot; data-drop=&quot;receipts&quot;&gt;&lt;span class=&quot;hrxExDropIcon&quot;&gt;&lt;/span&gt;&lt;div&gt;&lt;b&gt;' + ${i18n>exDropTitle} + '&lt;/b&gt;' + ${i18n>exDropText} + '&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;' }"
							afterRendering=".onDropRendered" />

						<!-- ═══ Lines ═══ -->
						<VBox renderType="Bare" visible="{= ${exView>/itemMode} !== 'grid' }">
						<HBox renderType="Bare" class="hrxExLineHead" visible="{= ${ex>/claim/items}.length > 0 }">
							<Text text="{i18n>exColItem}" />
							<Text text="{i18n>exColReason}" />
							<Text text="{i18n>exColAmount}" textAlign="End" />
							<Text text="{i18n>exColReceipt}" />
							<Text text="{i18n>exColState}" />
							<Text text="" />
						</HBox>
						<Text text="{i18n>exNoItems}" visible="{= ${ex>/claim/items}.length === 0 }" class="hrxExNoRows" />

						<VBox items="{path: 'ex>/claim/items', templateShareable: false}" renderType="Bare">
							<VBox renderType="Bare" class="hrxExLine">
								<customData>
									<core:CustomData key="open" value="{= ${ex>open} ? 'yes' : 'no' }" writeToDom="true" />
								</customData>

								<!-- A receipt still being read -->
								<HBox renderType="Bare" visible="{= !!${ex>reading} }" class="hrxExReading">
									<BusyIndicator size="14px" class="hrxExSpin" />
									<Text text="{= ${i18n>exReading} + ' ' + ${ex>receiptFileName} + '…' }" />
								</HBox>

								<HBox renderType="Bare" visible="{= !${ex>reading} }" class="hrxExLineRow">
									<VBox renderType="Bare">
										<Text text="{ex>typeText}" class="hrxExLineName" />
										<Text text="{ex>subText}" class="hrxExLineSub" />
										<Text text="{ex>aiText}" visible="{= !!${ex>aiText} }" class="hrxExAi" />
									</VBox>
									<Input
										value="{ex>reasonForTrip}"
										placeholder="{i18n>exReasonPlaceholder}"
										editable="{= !${exView>/readOnly} }"
										valueState="{= ${exView>/showErrors} &amp;&amp; !${ex>reasonForTrip} ? 'Error' : 'None' }"
										liveChange=".onItemFieldChange">
										<customData><core:CustomData key="field" value="reasonForTrip" /></customData>
									</Input>
									<VBox renderType="Bare" class="hrxExAmount">
										<Text text="{ex>grossText}" class="hrxExStrong" />
										<Text text="{ex>amountSubText}" class="hrxExAmountSub" />
									</VBox>
									<!-- The design's paperclip: blue once a receipt is on the line (opens it),
									     grey while there is none (attaches one) -->
									<HBox renderType="Bare" class="hrxExActs">
										<Button icon="sap-icon://attachment" tooltip="{i18n>exAttachReceipt}" visible="{= !${ex>receiptAttached} &amp;&amp; !${exView>/readOnly} }" press=".onAttachReceipt" type="Transparent" class="hrxExIconBtn" />
										<Button icon="sap-icon://attachment" tooltip="{ex>receiptFileName}" visible="{= !!${ex>receiptAttached} }" press=".onOpenReceipt" type="Transparent" class="hrxExIconBtn hrxExIconBtnOn" />
										<Text text="—" visible="{= !${ex>receiptAttached} &amp;&amp; !!${exView>/readOnly} }" />
									</HBox>
									<ObjectStatus text="{ex>stateText}" state="{ex>stateState}" visible="{= !!${ex>stateText} }" class="hrxExPill" />
									<HBox renderType="Bare" class="hrxExActs">
										<Button icon="{= ${ex>open} ? 'sap-icon://slim-arrow-up' : 'sap-icon://slim-arrow-down' }" tooltip="{i18n>exDetails}" press=".onToggleItem" type="Transparent" class="hrxExIconBtn" />
										<Button icon="sap-icon://delete" tooltip="{i18n>exRemove}" press=".onRemoveItem" type="Transparent" visible="{= !${exView>/readOnly} }" class="hrxExIconBtn hrxExIconBtnDel" />
									</HBox>
								</HBox>

								<!-- What to fix on this line, then what the approver will see -->
								<VBox items="{path: 'ex>issues', templateShareable: false}" renderType="Bare" visible="{= !${ex>reading} }" class="hrxExIssues">
									<HBox renderType="Bare" class="hrxExIssue">
										<customData><core:CustomData key="need" value="{ex>need}" writeToDom="true" /></customData>
										<Text text="{= ${ex>label} + ' — ' + ${ex>detail} }" class="hrxExIssueText" />
										<HBox renderType="Bare" class="hrxExIssueActs">
											<Text text="{= ${ex>need} === 'fyi' ? ${i18n>exApproverSees} : '' }" class="hrxExIssueTag" />
											<Button text="{ex>fixText}" visible="{= !!${ex>fix} &amp;&amp; !${exView>/readOnly} }" press=".onIssueFix" type="Transparent" class="hrxExGhost" />
											<Button text="{ex>dismissText}" visible="{= !!${ex>dismissText} &amp;&amp; !${exView>/readOnly} }" press=".onIssueDismiss" type="Transparent" class="hrxExGhost" />
										</HBox>
									</HBox>
								</VBox>

								<!-- The whole line, to edit -->
								<VBox renderType="Bare" visible="{= !!${ex>open} &amp;&amp; !${ex>reading} }" class="hrxExEdit">
									<HBox renderType="Bare" wrap="Wrap" class="hrxExFields">
										<VBox renderType="Bare" class="hrxExF">
											<Label text="{i18n>exDate}" required="true" />
											<DatePicker value="{ex>expenseDate}" valueFormat="yyyy-MM-dd" displayFormat="d MMM yyyy" editable="{= !${exView>/readOnly} }"
												valueState="{= ${exView>/showErrors} &amp;&amp; !${ex>expenseDate} ? 'Error' : 'None' }" change=".onItemFieldChange">
												<customData><core:CustomData key="field" value="expenseDate" /></customData>
											</DatePicker>
										</VBox>
										<VBox renderType="Bare" class="hrxExF">
											<Label text="{i18n>exType}" required="true" />
											<Select selectedKey="{ex>expenseType_code}" forceSelection="false" editable="{= !${exView>/readOnly} }" width="100%"
												valueState="{= ${exView>/showErrors} &amp;&amp; !${ex>expenseType_code} ? 'Error' : 'None' }"
												items="{path: 'ex>/types', templateShareable: false}" change=".onItemFieldChange">
												<core:Item key="{ex>code}" text="{ex>description}" />
												<customData><core:CustomData key="field" value="expenseType_code" /></customData>
											</Select>
										</VBox>
										<VBox renderType="Bare" class="hrxExF">
											<Label text="{i18n>exDestination}" />
											<Input value="{ex>destination}" editable="{= !${exView>/readOnly} }" liveChange=".onItemFieldChange">
												<customData><core:CustomData key="field" value="destination" /></customData>
											</Input>
										</VBox>
										<VBox renderType="Bare" class="hrxExF">
											<Label text="{i18n>exPaidIn}" />
											<Select selectedKey="{ex>paidCurrency}" editable="{= !${exView>/readOnly} }" width="100%"
												items="{path: 'ex>/currencies', templateShareable: false}" change=".onItemCurrencyChange">
												<core:Item key="{ex>code}" text="{ex>text}" />
											</Select>
										</VBox>
										<VBox renderType="Bare" class="hrxExF" visible="{= ${ex>paidCurrency} !== ${ex>/claim/currency} }">
											<Label text="{= ${i18n>exForeignAmount} + ' (' + ${ex>paidCurrency} + ')' }" required="true" />
											<Input value="{ex>originalAmount}" type="Number" editable="{= !${exView>/readOnly} }" change=".onForeignAmountChange" />
										</VBox>
										<VBox renderType="Bare" class="hrxExF">
											<Label text="{= ${i18n>exAmount} + ' (' + ${ex>/claim/currency} + ')' }" required="true" />
											<Input value="{ex>grossAmount}" type="Number" editable="{= !${exView>/readOnly} }"
												valueState="{= ${exView>/showErrors} &amp;&amp; !(${ex>grossAmount} > 0) ? 'Error' : 'None' }" liveChange=".onItemFieldChange">
												<customData><core:CustomData key="field" value="grossAmount" /></customData>
											</Input>
										</VBox>
										<VBox renderType="Bare" class="hrxExF">
											<Label text="{i18n>exTaxType}" />
											<Select selectedKey="{ex>vatType}" editable="{= !${exView>/readOnly} }" width="100%"
												items="{path: 'ex>/claim/taxTypes', templateShareable: false}" change=".onItemFieldChange">
												<core:Item key="{ex>code}" text="{ex>text}" />
												<customData><core:CustomData key="field" value="vatType" /></customData>
											</Select>
										</VBox>
									</HBox>
									<HBox renderType="Bare" class="hrxExSplit">
										<Text text="{ex>splitText}" />
									</HBox>
									<VBox items="{path: 'ex>okChecks', templateShareable: false}" renderType="Bare" class="hrxExChecks">
										<HBox renderType="Bare" class="hrxExCheck">
											<customData><core:CustomData key="status" value="{ex>status}" writeToDom="true" /></customData>
											<Text text="{ex>label}" class="hrxExStrong" />
											<Text text="{ex>detail}" />
										</HBox>
									</VBox>
								</VBox>
							</VBox>
						</VBox>
						</VBox>

						<!-- ═══ Grid: every field of every line in one table ═══ -->
						<Table
							items="{path: 'ex>/claim/items', templateShareable: false}"
							visible="{= ${exView>/itemMode} === 'grid' }"
							noDataText="{i18n>exNoItems}"
							class="hrxExTable hrxExGrid">
							<columns>
								<Column width="12%"><Text text="{i18n>exDate}" /></Column>
								<Column width="15%"><Text text="{i18n>exType}" /></Column>
								<Column width="10%"><Text text="{i18n>exDestination}" /></Column>
								<Column width="13%"><Text text="{i18n>exColReason}" /></Column>
								<Column width="10%"><Text text="{i18n>exTaxType}" /></Column>
								<Column width="8%"><Text text="{i18n>exColCurrency}" /></Column>
								<Column width="8%" hAlign="End"><Text text="{i18n>exColGross}" /></Column>
								<Column width="8%" hAlign="End"><Text text="{i18n>exColNetVat}" /></Column>
								<Column width="9%"><Text text="{i18n>exColChecks}" /></Column>
								<Column width="7%" />
							</columns>
							<items>
								<ColumnListItem>
									<cells>
										<DatePicker value="{ex>expenseDate}" valueFormat="yyyy-MM-dd" displayFormat="d MMM yyyy" editable="{= !${exView>/readOnly} &amp;&amp; !${ex>reading} }"
											valueState="{= ${exView>/showErrors} &amp;&amp; !${ex>expenseDate} ? 'Error' : 'None' }" change=".onItemFieldChange">
											<customData><core:CustomData key="field" value="expenseDate" /></customData>
										</DatePicker>
										<VBox renderType="Bare">
											<Select selectedKey="{ex>expenseType_code}" forceSelection="false" editable="{= !${exView>/readOnly} &amp;&amp; !${ex>reading} }" width="100%"
												valueState="{= ${exView>/showErrors} &amp;&amp; !${ex>expenseType_code} ? 'Error' : 'None' }"
												items="{path: 'ex>/types', templateShareable: false}" change=".onItemFieldChange">
												<core:Item key="{ex>code}" text="{ex>description}" />
												<customData><core:CustomData key="field" value="expenseType_code" /></customData>
											</Select>
											<Text text="{= ${ex>reading} ? ${i18n>exReading} + ' ' + ${ex>receiptFileName} + '…' : ${ex>aiText} }" visible="{= !!${ex>reading} || !!${ex>aiText} }" class="hrxExAi" />
										</VBox>
										<Input value="{ex>destination}" editable="{= !${exView>/readOnly} &amp;&amp; !${ex>reading} }" liveChange=".onItemFieldChange">
											<customData><core:CustomData key="field" value="destination" /></customData>
										</Input>
										<Input value="{ex>reasonForTrip}" editable="{= !${exView>/readOnly} &amp;&amp; !${ex>reading} }"
											valueState="{= ${exView>/showErrors} &amp;&amp; !${ex>reasonForTrip} ? 'Error' : 'None' }" liveChange=".onItemFieldChange">
											<customData><core:CustomData key="field" value="reasonForTrip" /></customData>
										</Input>
										<Select selectedKey="{ex>vatType}" editable="{= !${exView>/readOnly} &amp;&amp; !${ex>reading} }" width="100%"
											items="{path: 'ex>/claim/taxTypes', templateShareable: false}" change=".onItemFieldChange">
											<core:Item key="{ex>code}" text="{ex>text}" />
											<customData><core:CustomData key="field" value="vatType" /></customData>
										</Select>
										<VBox renderType="Bare">
											<Select selectedKey="{ex>paidCurrency}" editable="{= !${exView>/readOnly} &amp;&amp; !${ex>reading} }" width="100%"
												items="{path: 'ex>/currencies', templateShareable: false}" change=".onItemCurrencyChange">
												<core:Item key="{ex>code}" text="{ex>code}" />
											</Select>
											<Input value="{ex>originalAmount}" type="Number" placeholder="{i18n>exForeignAmount}" visible="{= !!${ex>paidCurrency} &amp;&amp; ${ex>paidCurrency} !== ${ex>/claim/currency} }"
												editable="{= !${exView>/readOnly} }" change=".onForeignAmountChange" />
										</VBox>
										<Input value="{ex>grossAmount}" type="Number" textAlign="End" editable="{= !${exView>/readOnly} &amp;&amp; !${ex>reading} }"
											valueState="{= ${exView>/showErrors} &amp;&amp; !(${ex>grossAmount} > 0) ? 'Error' : 'None' }" liveChange=".onItemFieldChange">
											<customData><core:CustomData key="field" value="grossAmount" /></customData>
										</Input>
										<VBox renderType="Bare" class="hrxExAmount">
											<Text text="{ex>netText}" />
											<Text text="{ex>taxLineText}" class="hrxExLineSub" />
										</VBox>
										<ObjectStatus text="{ex>stateText}" state="{ex>stateState}" visible="{= !!${ex>stateText} }" class="hrxExPill" />
										<HBox renderType="Bare" class="hrxExActs">
											<Button icon="sap-icon://attachment" tooltip="{i18n>exAttachReceipt}" visible="{= !${ex>receiptAttached} &amp;&amp; !${exView>/readOnly} &amp;&amp; !${ex>reading} }" press=".onAttachReceipt" type="Transparent" class="hrxExIconBtn" />
											<Button icon="sap-icon://attachment" tooltip="{ex>receiptFileName}" visible="{= !!${ex>receiptAttached} }" press=".onOpenReceipt" type="Transparent" class="hrxExIconBtn hrxExIconBtnOn" />
											<Button icon="sap-icon://delete" tooltip="{i18n>exRemove}" press=".onRemoveItem" type="Transparent" visible="{= !${exView>/readOnly} &amp;&amp; !${ex>reading} }" class="hrxExIconBtn hrxExIconBtnDel" />
										</HBox>
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</VBox>

					<!-- Mileage -->
					<VBox renderType="Bare" class="hrxExCard">
						<HBox renderType="Bare" class="hrxExCardHead hrxExCardHeadRow">
							<VBox renderType="Bare">
								<Title text="{i18n>exMileage}" level="H3" class="hrxExCardTitle" />
								<Text text="{ex>/claim/mileageHint}" class="hrxExCardHint" />
							</VBox>
							<Button text="{i18n>exAddMileage}" icon="sap-icon://add" type="Emphasized" press=".onAddMileage" visible="{= !${exView>/readOnly} }" class="hrxExPrimary" />
						</HBox>
						<Table items="{path: 'ex>/claim/mileageClaims', templateShareable: false}" noDataText="{i18n>exNoMileage}" class="hrxExTable hrxExMileTable">
							<columns>
								<Column width="15%"><Label text="{i18n>exTripDate}" required="true" /></Column>
								<Column width="18%"><Label text="{i18n>exDestination}" required="true" /></Column>
								<Column width="22%"><Label text="{i18n>exReason}" required="true" /></Column>
								<Column width="12%" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>exColEngineType}" /></Column>
								<Column width="10%" hAlign="End"><Label text="{i18n>exMiles}" required="true" /></Column>
								<Column width="9%" hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>exColRatePerMile}" /></Column>
								<Column width="10%" hAlign="End"><Text text="{i18n>exColAmount}" /></Column>
								<Column width="4%" />
							</columns>
							<items>
								<ColumnListItem>
									<cells>
										<DatePicker value="{ex>tripDate}" valueFormat="yyyy-MM-dd" displayFormat="d MMM yyyy" editable="{= !${exView>/readOnly} }"
											valueState="{= ${exView>/showErrors} &amp;&amp; !${ex>tripDate} ? 'Error' : 'None' }" change=".onMileageFieldChange">
											<customData><core:CustomData key="field" value="tripDate" /></customData>
										</DatePicker>
										<Input value="{ex>destination}" editable="{= !${exView>/readOnly} }"
											valueState="{= ${exView>/showErrors} &amp;&amp; !${ex>destination} ? 'Error' : 'None' }" liveChange=".onMileageFieldChange">
											<customData><core:CustomData key="field" value="destination" /></customData>
										</Input>
										<Input value="{ex>reasonForTrip}" editable="{= !${exView>/readOnly} }"
											valueState="{= ${exView>/showErrors} &amp;&amp; !${ex>reasonForTrip} ? 'Error' : 'None' }" liveChange=".onMileageFieldChange">
											<customData><core:CustomData key="field" value="reasonForTrip" /></customData>
										</Input>
										<Select selectedKey="{ex>engineType}" editable="{= !${exView>/readOnly} }" width="100%" change=".onMileageFieldChange">
											<core:Item key="Petrol" text="{i18n>exEnginePetrol}" />
											<core:Item key="Diesel" text="{i18n>exEngineDiesel}" />
											<core:Item key="Hybrid" text="{i18n>exEngineHybrid}" />
											<core:Item key="Electric" text="{i18n>exEngineElectric}" />
											<customData><core:CustomData key="field" value="engineType" /></customData>
										</Select>
										<Input value="{ex>milesCount}" type="Number" textAlign="End" editable="{= !${exView>/readOnly} }"
											valueState="{= ${exView>/showErrors} &amp;&amp; !(${ex>milesCount} > 0) ? 'Error' : 'None' }" liveChange=".onMileageFieldChange">
											<customData><core:CustomData key="field" value="milesCount" /></customData>
										</Input>
										<Text text="{ex>rateText}" />
										<Text text="{ex>amountText}" class="hrxExStrong" />
										<Button icon="sap-icon://delete" tooltip="{i18n>exRemove}" press=".onRemoveMileage" type="Transparent" visible="{= !${exView>/readOnly} }" />
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</VBox>

					<!-- The bar along the bottom: total, what is left to do, and the buttons -->
					<HBox renderType="Bare" visible="{= !${exView>/readOnly} }" class="hrxExBar">
						<HBox renderType="Bare" class="hrxExBarTotal">
							<Text text="{i18n>exTotal}" class="hrxExBarLabel" />
							<Text text="{ex>/claim/totalText}" class="hrxExBarAmount" />
							<Text text="{ex>/claim/totalSub}" class="hrxExBarSub" />
						</HBox>
						<HBox renderType="Bare" class="hrxExReady">
							<Text text="{ex>/claim/readyText}" class="hrxExReadyPill">
								<customData><core:CustomData key="state" value="{ex>/claim/readyState}" writeToDom="true" /></customData>
							</Text>
							<Button text="{i18n>exShowNext}" visible="{= ${ex>/claim/readyState} === 'fix' }" press=".onShowNextIssue" type="Transparent" class="hrxExGhost" />
							<Text text="{ex>/claim/flaggedText}" visible="{= !!${ex>/claim/flaggedText} }" class="hrxExReadyPill">
								<customData><core:CustomData key="state" value="info" writeToDom="true" /></customData>
							</Text>
						</HBox>
						<HBox renderType="Bare" class="hrxExBarActions">
							<Button text="{i18n>exDeleteDraft}" press=".onDeleteClaim" visible="{= ${ex>/claim/status} === 'Draft' }" type="Transparent" class="hrxExGhost" />
							<Button text="{i18n>exApply}" icon="sap-icon://accept" type="Emphasized" press=".onApply" class="hrxExPrimary" />
						</HBox>
					</HBox>
				</VBox>
			</VBox>
		</content>
	</Page>
</mvc:View>
