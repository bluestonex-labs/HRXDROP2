<mvc:View
	controllerName="bsx.hrx.hrx2026.controller.ManageResources"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:u="sap.ui.unified"
	xmlns:core="sap.ui.core"
	displayBlock="true"
	height="100%"
	class="hrxManageResources">

	<!-- The design's master / detail (.md): the resource list card on the left and,
	     once a resource is chosen, its detail card beside it. data-mr-open and
	     data-mr-full drive the column widths in css/pages/manage-resources.css. -->
	<HBox id="resourcesLayout" renderType="Bare" class="hrxMrMd">
		<customData>
			<core:CustomData key="mr-open" value="{= ${mrView>/selectedId} ? 'yes' : 'no' }" writeToDom="true" />
			<core:CustomData key="mr-full" value="{= ${mrView>/fullScreen} ? 'yes' : 'no' }" writeToDom="true" />
		</customData>

		<!-- ============================= list card ============================== -->
		<VBox id="resourceListCard" renderType="Bare" class="hrxMrCard hrxMrList">
			<HBox renderType="Bare" class="hrxMrCardHead">
				<Title id="resourceListTitle" text="{mrView>/title}" level="H2" class="hrxMrCardTitle" />
			</HBox>

			<!-- Search, filter, add and reload -->
			<HBox renderType="Bare" class="hrxMrTools">
				<HBox renderType="Bare" class="hrxMrSearch">
					<core:Icon src="sap-icon://search" class="hrxMrSearchIcon hrxMrIcoSearch" />
					<Input
						id="resourceSearch"
						value="{mrView>/searchQuery}"
						valueLiveUpdate="true"
						showClearIcon="true"
						liveChange=".onSearch"
						placeholder="{i18n>mrSearchPlaceholder}"
						width="100%" />
				</HBox>
				<Button
					id="resourceFilterButton"
					icon="sap-icon://filter"
					tooltip="{i18n>mrFilterTooltip}"
					press=".onOpenFilter"
					class="hrxMrIconBtn hrxMrIcoFilter" />
				<Button
					id="resourceAddButton"
					icon="sap-icon://add"
					tooltip="{i18n>mrAddTooltip}"
					press=".onOpenAddResource"
					class="hrxMrIconBtn hrxMrIcoPlus" />
				<Button
					id="resourceRefreshButton"
					icon="sap-icon://refresh"
					tooltip="{i18n>mrRefreshTooltip}"
					press=".onRefresh"
					class="hrxMrIconBtn hrxMrIcoRefresh" />
			</HBox>

			<!-- The rows scroll inside the card -->
			<ScrollContainer id="resourceRows" vertical="true" horizontal="false" height="100%" class="hrxMrRows">
				<List
					id="resourceList"
					items="{mr>/resources}"
					mode="SingleSelectMaster"
					showSeparators="None"
					busy="{mrView>/listBusy}"
					busyIndicatorDelay="0"
					noDataText="{i18n>mrListNoData}"
					growing="true"
					growingThreshold="40"
					growingScrollToLoad="true"
					selectionChange=".onResourceSelect">
					<items>
						<CustomListItem
							type="Active"
							press=".onResourcePress"
							selected="{= ${mr>EmpID} === ${mrView>/selectedId} }"
							class="hrxMrRowItem">
							<HBox renderType="Bare" class="hrxMrRow">
								<!-- Their picture when they have one; the initials otherwise, and
								     while it loads or if it cannot be fetched -->
								<Avatar
									displaySize="Custom"
									customDisplaySize="38px"
									customFontSize="12.5px"
									src="{= ${pictures>/users}[${mr>EmpID}] || '' }"
									initials="{parts: ['mr>FName', 'mr>LName'], formatter: '.formatter.initials'}"
									class="hrxMrAvatar" />
								<VBox renderType="Bare" class="hrxMrRowMain">
									<Text text="{mr>FullName}" wrapping="false" class="hrxMrRowName" />
									<Text text="{mr>Email}" wrapping="false" class="hrxMrRowEmail" />
								</VBox>
								<!-- Hidden while a resource is open, as in the design -->
								<VBox renderType="Bare" class="hrxMrRowSide">
									<ObjectStatus
										text="{path: 'mr>IsActive', formatter: '.formatter.activeText'}"
										state="{path: 'mr>IsActive', formatter: '.formatter.activeState'}"
										class="hrxMrPill" />
									<Text
										text="{path: 'mr>UserTypeKey', formatter: '.formatter.userTypeText'} · {mr>SiteName}"
										wrapping="false"
										class="hrxMrRowMeta" />
								</VBox>
							</HBox>
						</CustomListItem>
					</items>
				</List>
			</ScrollContainer>
		</VBox>

		<!-- ============================ detail card ============================= -->
		<VBox
			id="resourceDetailCard"
			renderType="Bare"
			visible="{= !!${mrView>/selectedId} }"
			busy="{= ${mrView>/detailBusy} || ${mrView>/saving} }"
			busyIndicatorDelay="0"
			class="hrxMrCard hrxMrDetail">

			<!-- Head: picture or initials, the name with its Active / Inactive pill,
			     type · site · job title, then full screen and close -->
			<HBox renderType="Bare" class="hrxMrHead">
				<Avatar
					id="resourceDetailAvatar"
					displaySize="Custom"
					customDisplaySize="42px"
					customFontSize="14px"
					src="{parts: ['mrDetail>/NewPic', 'mrDetail>/Pic'], formatter: '.formatter.pendingImageSrc'}"
					initials="{parts: ['mrDetail>/FName', 'mrDetail>/LName'], formatter: '.formatter.initials'}"
					class="hrxMrAvatar" />
				<VBox renderType="Bare" class="hrxMrHeadText">
					<HBox renderType="Bare" class="hrxMrNameRow">
						<Title id="resourceDetailName" text="{mrDetail>/FullName}" level="H3" wrapping="false" class="hrxMrName" />
						<ObjectStatus
							text="{path: 'mrDetail>/IsActive', formatter: '.formatter.activeText'}"
							state="{path: 'mrDetail>/IsActive', formatter: '.formatter.activeState'}"
							class="hrxMrPill" />
					</HBox>
					<Text
						class="hrxMrHeadSub"
						text="{path: 'mrDetail>/UserTypeKey', formatter: '.formatter.userTypeText'} · {mrDetail>/SiteName}{= ${mrDetail>/JobTitle} ? ' · ' + ${mrDetail>/JobTitle} : '' }" />
				</VBox>
				<HBox renderType="Bare" class="hrxMrHeadActs">
					<Button
						id="resourceFullScreenButton"
						icon="sap-icon://full-screen"
						tooltip="{i18n>mrFullScreenTooltip}"
						press=".onToggleFullScreen"
						class="hrxMrIconBtn hrxMrIcoExpand" />
					<Button
						id="resourceCloseButton"
						icon="sap-icon://decline"
						tooltip="{i18n>mrCloseTooltip}"
						press=".onCloseDetail"
						class="hrxMrIconBtn hrxMrIcoClose" />
				</HBox>
			</HBox>

			<IconTabBar
				id="resourceTabs"
				expandable="false"
				stretchContentHeight="true"
				applyContentPadding="false"
				backgroundDesign="Transparent"
				headerBackgroundDesign="Transparent"
				selectedKey="{mrView>/selectedTab}"
				class="hrxMrTabs">
				<items>

					<!-- tab: info -->
					<IconTabFilter key="info" text="{i18n>mrTabInfo}">
						<HBox renderType="Bare" class="hrxMrGrid">
							<VBox renderType="Bare" class="hrxMrFld">
								<Label text="{i18n>mrFieldFirstName}" required="true" labelFor="resourceFirstName" />
								<Input id="resourceFirstName" value="{mrDetail>/FName}" placeholder="{i18n>mrFieldFirstNamePlaceholder}" />
							</VBox>
							<VBox renderType="Bare" class="hrxMrFld">
								<Label text="{i18n>mrFieldLastName}" labelFor="resourceLastName" />
								<Input id="resourceLastName" value="{mrDetail>/LName}" placeholder="{i18n>mrFieldLastNamePlaceholder}" />
							</VBox>
							<VBox renderType="Bare" class="hrxMrFld">
								<Label text="{i18n>mrFieldEmail}" />
								<Text id="resourceEmail" text="{mrDetail>/Email}" class="hrxMrRo" />
							</VBox>
							<VBox renderType="Bare" class="hrxMrFld">
								<Label text="{i18n>mrFieldMobile}" labelFor="resourceMobile" />
								<Input id="resourceMobile" value="{mrDetail>/Mobile}" type="Tel" placeholder="{i18n>mrFieldMobilePlaceholder}" />
							</VBox>
							<!-- Only while the HRX service has a job title to keep it in -->
							<VBox renderType="Bare" class="hrxMrFld" visible="{services>/jobTitle}">
								<Label text="{i18n>mrFieldJobTitle}" labelFor="resourceJobTitle" />
								<Input
									id="resourceJobTitle"
									value="{mrDetail>/JobTitle}"
									maxLength="100"
									placeholder="{i18n>mrFieldJobTitlePlaceholder}" />
							</VBox>
							<VBox renderType="Bare" class="hrxMrFld">
								<Label text="{i18n>mrFieldLocation}" required="true" labelFor="resourceSite" />
								<ComboBox
									id="resourceSite"
									width="100%"
									selectedKey="{mrDetail>/BaseSiteKey}"
									items="{path: 'mr>/sites', templateShareable: false}"
									placeholder="{i18n>mrFieldLocationPlaceholder}">
									<core:ListItem key="{mr>SiteID}" text="{mr>SiteLabel}" additionalText="{mr>SiteLocation}" />
								</ComboBox>
							</VBox>
							<VBox renderType="Bare" class="hrxMrFld">
								<Label text="{i18n>mrFieldUserType}" required="true" labelFor="resourceUserType" />
								<ComboBox
									id="resourceUserType"
									width="100%"
									selectedKey="{mrDetail>/UserTypeKey}"
									items="{path: 'mr>/userTypes', templateShareable: false}"
									placeholder="{i18n>mrFieldUserTypePlaceholder}">
									<core:ListItem key="{mr>UserTypeKey}" text="{mr>UserTypeDesc}" />
								</ComboBox>
							</VBox>
							<!-- The picture goes to the document service on Save -->
							<VBox renderType="Bare" class="hrxMrFld">
								<Label text="{i18n>mrFieldPicture}" labelFor="resourcePictureUploader" />
								<!-- (input[type=file]) the file button, then the chosen file's name -->
								<HBox renderType="Bare" class="hrxMrFile">
									<u:FileUploader
										id="resourcePictureUploader"
										name="resourcePicture"
										uploadUrl=""
										buttonOnly="true"
										fileType="png,jpg,jpeg"
										buttonText="{i18n>mrPictureChoose}"
										tooltip="{i18n>mrPictureTooltip}"
										change=".onPictureChange"
										typeMissmatch=".onPictureTypeMismatch"
										class="hrxMrFileButton" />
									<Text
										text="{= ${mrDetail>/NewPicName} || ${i18n>mrPictureNoFile} }"
										wrapping="false"
										class="hrxMrFileName" />
								</HBox>
								<HBox renderType="Bare" class="hrxMrHintRow">
									<Text text="{i18n>mrPicturePlaceholder}" class="hrxMrHint" />
									<Link
										text="{i18n>mrRemovePicture}"
										press=".onRemovePicture"
										visible="{= !!(${mrDetail>/NewPic} || ${mrDetail>/Pic}) }"
										class="hrxMrHintLink" />
								</HBox>
							</VBox>
						</HBox>
					</IconTabFilter>

					<!-- tab: manager -->
					<IconTabFilter key="manager" text="{i18n>mrTabManager}">
						<HBox renderType="Bare" class="hrxMrGrid">
							<VBox renderType="Bare" class="hrxMrFld">
								<Label text="{i18n>mrFieldManager}" labelFor="resourceManager" />
								<ComboBox
									id="resourceManager"
									width="100%"
									selectedKey="{mrDetail>/ManagerID}"
									items="{path: 'mr>/managers', templateShareable: false}"
									placeholder="{i18n>mrFieldManagerPlaceholder}">
									<core:ListItem key="{mr>EmpID}" text="{mr>FullName}" additionalText="{mr>SiteName}" />
								</ComboBox>
							</VBox>
							<VBox renderType="Bare" class="hrxMrFld">
								<Label text="{i18n>mrFieldReportedManager}" />
								<Text text="{= ${mrLeave>/user/managerName} || ${i18n>mrNoManager} }" class="hrxMrRo" />
							</VBox>
							<VBox renderType="Bare" class="hrxMrFld">
								<Label text="{i18n>mrFieldManagerEmail}" />
								<Text text="{mrLeave>/user/managerEmail}" class="hrxMrRo" />
							</VBox>
						</HBox>
					</IconTabFilter>

					<!-- tab: working time -->
					<IconTabFilter key="workingtime" text="{i18n>mrTabWorkingTime}">
						<HBox renderType="Bare" class="hrxMrGrid">
							<VBox renderType="Bare" class="hrxMrFld">
								<Label text="{i18n>mrFieldTargetUtilisation}" labelFor="resourceTargetUtilization" />
								<HBox renderType="Bare" class="hrxMrSuffix">
									<Input id="resourceTargetUtilization" value="{mrDetail>/TargetUtilization}" type="Number" />
									<Text text="{i18n>mrPercent}" class="hrxMrSuffixText" />
								</HBox>
							</VBox>
							<VBox renderType="Bare" class="hrxMrFld">
								<Label text="{i18n>mrFieldWeeklyTargetHours}" labelFor="resourceTargetHours" />
								<MaskInput
									id="resourceTargetHours"
									value="{mrDetail>/TargetHrsPerWeek}"
									mask="99:99"
									placeholderSymbol="_"
									placeholder="{i18n>mrFieldWeeklyTargetHoursPlaceholder}" />
							</VBox>
							<VBox renderType="Bare" class="hrxMrFld hrxMrSpan2">
								<Label text="{i18n>mrFieldWorkSchedule}" />
								<HBox renderType="Bare" class="hrxMrChips">
									<ToggleButton id="resourceDayMo" text="{i18n>mrDayMo}" pressed="{mrDetail>/days/Mo}" class="hrxMrChip" />
									<ToggleButton id="resourceDayTu" text="{i18n>mrDayTu}" pressed="{mrDetail>/days/Tu}" class="hrxMrChip" />
									<ToggleButton id="resourceDayWe" text="{i18n>mrDayWe}" pressed="{mrDetail>/days/We}" class="hrxMrChip" />
									<ToggleButton id="resourceDayTh" text="{i18n>mrDayTh}" pressed="{mrDetail>/days/Th}" class="hrxMrChip" />
									<ToggleButton id="resourceDayFr" text="{i18n>mrDayFr}" pressed="{mrDetail>/days/Fr}" class="hrxMrChip" />
									<ToggleButton id="resourceDaySa" text="{i18n>mrDaySa}" pressed="{mrDetail>/days/Sa}" class="hrxMrChip" />
									<ToggleButton id="resourceDaySu" text="{i18n>mrDaySu}" pressed="{mrDetail>/days/Su}" class="hrxMrChip" />
								</HBox>
							</VBox>
							<VBox renderType="Bare" class="hrxMrFld">
								<Label text="{i18n>mrFieldAnnualLeaveQuota}" labelFor="resourceLeaveQuota" />
								<Input id="resourceLeaveQuota" value="{mrDetail>/AnnualLeaveQuota}" type="Number" />
							</VBox>
						</HBox>
					</IconTabFilter>

					<!-- tab: reward and benefits -->
					<IconTabFilter key="reward" text="{i18n>mrTabReward}">
						<HBox renderType="Bare" class="hrxMrGrid">
							<VBox renderType="Bare" class="hrxMrFld">
								<Label text="{i18n>mrFieldBonus}" labelFor="resourceBonus" />
								<HBox renderType="Bare" class="hrxMrSuffix">
									<Input id="resourceBonus" value="{mrDetail>/BonusPercent}" type="Number" />
									<Text text="{i18n>mrPercent}" class="hrxMrSuffixText" />
								</HBox>
							</VBox>
							<VBox renderType="Bare" class="hrxMrFld">
								<Label text="{i18n>mrFieldPension}" labelFor="resourcePension" />
								<HBox renderType="Bare" class="hrxMrSuffix">
									<Input id="resourcePension" value="{mrDetail>/PensionRate}" type="Number" />
									<Text text="{i18n>mrPercent}" class="hrxMrSuffixText" />
								</HBox>
							</VBox>
						</HBox>
					</IconTabFilter>

					<!-- tab: leave taken -->
					<IconTabFilter key="leave" text="{i18n>mrTabLeave}">
						<VBox renderType="Bare" busy="{mrView>/leaveBusy}" busyIndicatorDelay="0" class="hrxMrLeave">
							<!-- The figures (.kpi-mini) with Book leave level with them on the right -->
							<HBox renderType="Bare" class="hrxMrLeaveHead">
								<HBox renderType="Bare" class="hrxMrKpis">
									<VBox renderType="Bare" class="hrxMrKpi">
										<Text text="{= ${mrLeave>/user/annualLeaveQuota} || '0' }" class="hrxMrKpiNum" />
										<Text text="{i18n>mrLeaveQuotaLabel}" class="hrxMrKpiLabel" />
									</VBox>
									<VBox renderType="Bare" class="hrxMrKpi">
										<Text text="{= ${mrLeave>/user/noOfAvailedLeaves} || '0' }" class="hrxMrKpiNum" />
										<Text text="{i18n>mrLeaveTakenLabel}" class="hrxMrKpiLabel" />
									</VBox>
									<VBox renderType="Bare" class="hrxMrKpi">
										<Text text="{= ${mrLeave>/user/balanceLeaves} || '0' }" class="hrxMrKpiNum hrxMrKpiNumOk" />
										<Text text="{i18n>mrLeaveBalanceLabel}" class="hrxMrKpiLabel" />
									</VBox>
									<VBox renderType="Bare" class="hrxMrKpi">
										<Text text="{path: 'mrLeave>/bankHolidays', formatter: '.formatter.count'}" class="hrxMrKpiNum" />
										<Text text="{i18n>mrLeaveBankHolidaysLabel}" class="hrxMrKpiLabel" />
									</VBox>
								</HBox>
								<Button
									id="resourceBookLeaveButton"
									text="{i18n>mrBookLeave}"
									icon="sap-icon://appointment-2"
									press=".onOpenBookLeave"
									class="hrxMrBtnGhost hrxMrBtnSm hrxMrIcoCal" />
							</HBox>

							<Table
								id="resourceLeaveTable"
								items="{mrLeave>/availedLeaves}"
								noDataText="{i18n>mrLeaveNoData}"
								showSeparators="Inner"
								growing="true"
								growingScrollToLoad="true"
								fixedLayout="false"
								class="hrxMrTable">
								<columns>
									<Column><Text text="{i18n>mrLeaveColDate}" /></Column>
									<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>mrLeaveColType}" /></Column>
									<Column hAlign="End"><Text text="{i18n>mrLeaveColStatus}" /></Column>
								</columns>
								<items>
									<ColumnListItem type="Inactive">
										<cells>
											<Text text="{mrLeave>DisplayDate}" />
											<Text text="{mrLeave>LeaveType} · {mrLeave>Absence}" />
											<!-- A request still waiting can be decided here (.icon-btn sm ok / no) -->
											<HBox renderType="Bare" class="hrxMrRowActs">
												<Button
													icon="sap-icon://accept"
													tooltip="{i18n>mrLeaveApprove}"
													visible="{= ${mrLeave>StatusID} === 'REQ' }"
													press=".onApproveLeave"
													class="hrxMrIconBtn hrxMrIconBtnOk hrxMrIcoCheck" />
												<Button
													icon="sap-icon://decline"
													tooltip="{i18n>mrLeaveReject}"
													visible="{= ${mrLeave>StatusID} === 'REQ' }"
													press=".onRejectLeave"
													class="hrxMrIconBtn hrxMrIconBtnNo hrxMrIcoClose" />
												<ObjectStatus
													text="{mrLeave>Status}"
													state="{path: 'mrLeave>StatusID', formatter: '.formatter.leaveStatusState'}"
													class="hrxMrPill" />
											</HBox>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</VBox>
					</IconTabFilter>
				</items>
			</IconTabBar>

			<!-- Foot: Active / Inactive takes effect straight away; Save is for the form -->
			<HBox renderType="Bare" class="hrxMrFoot">
				<HBox renderType="Bare" class="hrxMrSwitchRow">
					<Switch
						id="resourceActive"
						state="{mrDetail>/Active}"
						customTextOn=" "
						customTextOff=" "
						tooltip="{i18n>mrFieldActive}"
						change=".onActiveChange"
						class="hrxMrSwitch" />
					<Text text="{= ${mrDetail>/Active} ? ${i18n>mrActive} : ${i18n>mrInactive} }" class="hrxMrSwitchText" />
				</HBox>
				<Button
					id="resourceSaveButton"
					text="{i18n>mrSave}"
					type="Emphasized"
					press=".onSave"
					class="hrxMrBtn" />
			</HBox>
		</VBox>
	</HBox>
</mvc:View>
