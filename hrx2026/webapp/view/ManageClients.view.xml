<mvc:View
	controllerName="bsx.hrx.hrx2026.controller.ManageClients"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:u="sap.ui.unified"
	xmlns:core="sap.ui.core"
	displayBlock="true"
	height="100%"
	class="hrxManageClients">

	<!-- The 15.10.26 design's master/detail: the client list as one card and, once a
	     client is picked, its detail as a second card beside it. The layout is held in
	     mcView>/layout (OneColumn, TwoColumnsMidExpanded, MidColumnFullScreen) and written
	     to the DOM as data-layout, which manage-clients.css reads to size the two cards. -->
	<Page id="clientsPage" showHeader="false" enableScrolling="false" class="hrxMcPage">
		<content>
			<HBox id="clientsMasterDetail" renderType="Bare" class="hrxMcMd">
				<customData>
					<core:CustomData key="layout" value="{mcView>/layout}" writeToDom="true" />
				</customData>

				<!-- ============================= list card ============================= -->
				<VBox id="clientListCard" renderType="Bare" class="hrxMcCard hrxMcList">
					<HBox renderType="Bare" class="hrxMcCardHead">
						<Title id="clientListTitle" text="{mcView>/title}" level="H2" class="hrxMcCardTitle" />
					</HBox>

					<HBox renderType="Bare" class="hrxMcTools">
						<SearchField
							id="clientSearch"
							value="{mcView>/searchQuery}"
							liveChange=".onSearch"
							search=".onSearch"
							showSearchButton="false"
							placeholder="{i18n>mcSearchPlaceholder}"
							width="auto"
							class="hrxMcSearch" />
						<Button
							id="clientAddButton"
							type="Transparent"
							tooltip="{i18n>mcAddTooltip}"
							press=".onOpenAddClient"
							class="hrxMcIconBtn hrxMcIcoPlus" />
						<Button
							id="clientRefreshButton"
							type="Transparent"
							tooltip="{i18n>mcRefreshTooltip}"
							press=".onRefresh"
							class="hrxMcIconBtn hrxMcIcoRefresh" />
					</HBox>

					<List
						id="clientList"
						items="{mc>/clients}"
						mode="SingleSelectMaster"
						busy="{mcView>/listBusy}"
						busyIndicatorDelay="0"
						noDataText="{i18n>mcListNoData}"
						showSeparators="None"
						growing="true"
						growingThreshold="40"
						growingScrollToLoad="true"
						selectionChange=".onClientSelect"
						class="hrxMcRows">
						<items>
							<CustomListItem
								type="Active"
								press=".onClientPress"
								selected="{= ${mc>ClientKey} === ${mcView>/selectedId} }"
								class="hrxMcRow">
								<HBox renderType="Bare" class="hrxMcRowInner">
									<Avatar
										displaySize="Custom"
										customDisplaySize="38px"
										customFontSize="12px"
										src="{path: 'mc>ClientLogo', formatter: '.formatter.imageSrc'}"
										imageFitType="Contain"
										initials="{path: 'mc>ClientDesc', formatter: '.formatter.nameInitials'}"
										class="hrxMcLogo" />
									<VBox renderType="Bare" class="hrxMcRowMain">
										<Text text="{mc>ClientDesc}" wrapping="false" class="hrxMcRowTitle" />
										<Text text="{mc>ClientKey}" wrapping="false" class="hrxMcRowSub" />
									</VBox>
									<VBox renderType="Bare" class="hrxMcRowSide">
										<Text text="{mc>ClientLocation}" wrapping="false" />
										<Text text="{mc>ClientContactName}" wrapping="false" />
									</VBox>
								</HBox>
							</CustomListItem>
						</items>
					</List>
				</VBox>

				<!-- ============================ detail card ============================ -->
				<VBox
					id="clientDetailCard"
					renderType="Bare"
					visible="{= ${mcView>/layout} !== 'OneColumn' }"
					busy="{= ${mcView>/detailBusy} || ${mcView>/saving} }"
					busyIndicatorDelay="0"
					class="hrxMcCard hrxMcDetail">

					<!-- head: logo, name, key and location, full screen and close -->
					<HBox renderType="Bare" class="hrxMcHead">
						<Avatar
							id="clientDetailLogo"
							displaySize="Custom"
							customDisplaySize="52px"
							customFontSize="16px"
							src="{parts: ['mcDetail>/NewLogo', 'mcDetail>/ClientLogo'], formatter: '.formatter.pendingImageSrc'}"
							imageFitType="Contain"
							initials="{path: 'mcDetail>/ClientDesc', formatter: '.formatter.nameInitials'}"
							class="hrxMcLogo" />
						<VBox renderType="Bare" class="hrxMcHeadText">
							<Text id="clientDetailName" text="{mcDetail>/ClientDesc}" class="hrxMcHeadName" />
							<Text
								id="clientDetailSub"
								text="{parts: ['mcDetail>/ClientKey', 'mcDetail>/ClientLocation'], formatter: '.formatHeadSub'}"
								class="hrxMcHeadSub" />
						</VBox>
						<HBox renderType="Bare" class="hrxMcHeadActs">
							<Button
								id="clientFullScreenButton"
								type="Transparent"
								tooltip="{i18n>mcFullScreenTooltip}"
								press=".onToggleFullScreen"
								class="hrxMcIconBtn hrxMcIcoExpand" />
							<Button
								id="clientCloseButton"
								type="Transparent"
								tooltip="{i18n>mcCloseTooltip}"
								press=".onCloseDetail"
								class="hrxMcIconBtn hrxMcIcoClose" />
						</HBox>
					</HBox>

					<!-- tabs: each tab's data is read when the tab is opened (see _loadTab) -->
					<IconTabHeader
						id="clientTabs"
						selectedKey="{mcView>/selectedTab}"
						select=".onTabSelect"
						backgroundDesign="Transparent"
						class="hrxMcTabs">
						<items>
							<IconTabFilter key="basic" text="{i18n>mcTabBasic}" />
							<IconTabFilter key="team" text="{i18n>mcTabTeam}" />
							<IconTabFilter key="sla" text="{i18n>mcTabSla}" />
							<IconTabFilter key="components" text="{i18n>mcTabComponents}" />
							<IconTabFilter key="services" text="{i18n>mcTabServices}" />
						</items>
					</IconTabHeader>

					<VBox id="clientDetailBody" renderType="Bare" class="hrxMcBody">

						<!-- ======================== tab: basic info ======================== -->
						<VBox id="clientBasicTab" renderType="Bare" visible="{= ${mcView>/selectedTab} === 'basic' }">
							<Title text="{i18n>mcSectionClient}" level="H3" class="hrxMcFsec" />
							<VBox renderType="Bare" class="hrxMcGrid">
								<VBox renderType="Bare" class="hrxMcFld">
									<Label text="{i18n>mcFieldKey}" class="hrxMcLbl" />
									<Text id="clientKey" text="{mcDetail>/ClientKey}" class="hrxMcRo" />
								</VBox>
								<VBox renderType="Bare" class="hrxMcFld">
									<Label text="{i18n>mcFieldName}" required="true" labelFor="clientName" class="hrxMcLbl" />
									<Input id="clientName" value="{mcDetail>/ClientDesc}" />
								</VBox>
								<VBox renderType="Bare" class="hrxMcFld">
									<Label text="{i18n>mcFieldLocation}" labelFor="clientLocation" class="hrxMcLbl" />
									<Input id="clientLocation" value="{mcDetail>/ClientLocation}" placeholder="{i18n>mcFieldLocationPlaceholder}" />
								</VBox>
								<VBox renderType="Bare" class="hrxMcFld">
									<Label text="{i18n>mcFieldLogo}" labelFor="clientLogoUploader" class="hrxMcLbl" />
									<HBox renderType="Bare" class="hrxMcFileBox">
										<u:FileUploader
											id="clientLogoUploader"
											name="clientLogo"
											uploadUrl=""
											buttonOnly="true"
											fileType="png,jpg,jpeg"
											buttonText="{i18n>mcChooseFile}"
											tooltip="{i18n>mcLogoTooltip}"
											change=".onLogoChange"
											typeMissmatch=".onLogoTypeMismatch"
											class="hrxMcFile" />
										<Text
											id="clientLogoFileName"
											text="{= ${mcDetail>/LogoFileName} || ${i18n>mcNoFileChosen} }"
											wrapping="false"
											class="hrxMcFileName" />
									</HBox>
									<HBox renderType="Bare" class="hrxMcHintRow">
										<Text text="{i18n>mcLogoPlaceholder}" class="hrxMcHint" />
										<Link
											text="{i18n>mcRemoveLogo}"
											press=".onRemoveLogo"
											visible="{= !!(${mcDetail>/NewLogo} || ${mcDetail>/ClientLogo}) }"
											class="hrxMcHintLink" />
									</HBox>
								</VBox>
							</VBox>

							<Title text="{i18n>mcSectionContact}" level="H3" class="hrxMcFsec hrxMcFsecNext" />
							<VBox renderType="Bare" class="hrxMcGrid">
								<VBox renderType="Bare" class="hrxMcFld">
									<Label text="{i18n>mcFieldContactName}" labelFor="clientContactName" class="hrxMcLbl" />
									<Input id="clientContactName" value="{mcDetail>/ClientContactName}" placeholder="{i18n>mcFieldContactNamePlaceholder}" />
								</VBox>
								<VBox renderType="Bare" class="hrxMcFld">
									<Label text="{i18n>mcFieldContactEmail}" labelFor="clientContactEmail" class="hrxMcLbl" />
									<Input id="clientContactEmail" value="{mcDetail>/ClientContactEmail}" type="Email" placeholder="{i18n>mcFieldContactEmailPlaceholder}" />
								</VBox>
								<VBox renderType="Bare" class="hrxMcFld">
									<Label text="{i18n>mcFieldContactPhone}" labelFor="clientContactPhone" class="hrxMcLbl" />
									<Input id="clientContactPhone" value="{mcDetail>/ClientContactMobile}" type="Tel" placeholder="{i18n>mcFieldContactPhonePlaceholder}" />
								</VBox>
							</VBox>
						</VBox>

						<!-- ======================= tab: support team ======================= -->
						<VBox id="clientTeamTab" renderType="Bare" visible="{= ${mcView>/selectedTab} === 'team' }">
							<MessageStrip
								text="{i18n>serviceNeededClientTeam}"
								visible="{= !${services>/clientUsers} }"
								type="Warning"
								showIcon="true"
								enableFormattedText="true"
								class="sapUiSmallMarginBottom" />
							<HBox renderType="Bare" class="hrxMcSectHead">
								<Title text="{i18n>mcUsersTitle}" level="H3" class="hrxMcSectTitle" />
								<Button
									id="clientAddUserButton"
									text="{i18n>mcAddUser}"
									press=".onAddUser"
									class="hrxMcGhostSm hrxMcIcoUserPlus" />
							</HBox>
							<Table
								id="clientUserTable"
								items="{mcTabs>/users}"
								busy="{mcView>/tabBusy}"
								busyIndicatorDelay="0"
								noDataText="{i18n>mcNoUsers}"
								fixedLayout="false"
								class="hrxMcTable">
								<columns>
									<Column><Text text="{i18n>mcColUser}" /></Column>
									<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>mcColEmail}" /></Column>
									<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>mcColStatus}" /></Column>
									<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>mcColAdmin}" /></Column>
									<Column hAlign="End"><Text text="" /></Column>
								</columns>
								<items>
									<ColumnListItem>
										<cells>
											<Text text="{mcTabs>FName} {mcTabs>LName}" class="hrxMcStrong" />
											<Text text="{path: 'mcTabs>Email', formatter: '.formatter.clean'}" />
											<ObjectStatus
												text="{path: 'mcTabs>IsActive', formatter: '.formatter.activeText'}"
												state="{= ${mcTabs>IsActive} === 'Y' ? 'Success' : 'Warning' }"
												class="hrxMcPill" />
											<ObjectStatus
												text="{= ${mcTabs>IsAdmin} === 'Y' ? ${i18n>mcYes} : ${i18n>mcNo} }"
												state="{= ${mcTabs>IsAdmin} === 'Y' ? 'Success' : 'None' }"
												class="hrxMcPill" />
											<HBox renderType="Bare" class="hrxMcRowActs">
												<Button
													type="Transparent"
													tooltip="{i18n>mcEditUser}"
													press=".onEditUser"
													class="hrxMcIconBtn hrxMcIcoEdit" />
												<Button
													type="Transparent"
													tooltip="{i18n>mcDeleteUser}"
													press=".onDeleteUser"
													visible="{= !!${services>/clientUsers} }"
													class="hrxMcIconBtn hrxMcIconBtnDel hrxMcIcoTrash" />
											</HBox>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</VBox>

						<!-- ============================ tab: SLA ============================ -->
						<VBox id="clientSlaTab" renderType="Bare" visible="{= ${mcView>/selectedTab} === 'sla' }">
							<MessageStrip
								text="{i18n>serviceNeededClientSla}"
								visible="{= !${services>/clientSlas} }"
								type="Warning"
								showIcon="true"
								enableFormattedText="true"
								class="sapUiSmallMarginBottom" />
							<HBox renderType="Bare" class="hrxMcSectHead">
								<Title text="{i18n>mcSlaTitle}" level="H3" class="hrxMcSectTitle" />
								<Button
									id="clientAddSlaButton"
									text="{i18n>mcAddSla}"
									press=".onAddSla"
									class="hrxMcGhostSm hrxMcIcoPlus" />
							</HBox>
							<Table
								id="clientSlaTable"
								items="{mcTabs>/sla}"
								busy="{mcView>/tabBusy}"
								busyIndicatorDelay="0"
								noDataText="{i18n>mcNoSla}"
								fixedLayout="false"
								class="hrxMcTable">
								<columns>
									<Column><Text text="{i18n>mcColSeverity}" /></Column>
									<Column hAlign="End"><Text text="{i18n>mcColResponse}" /></Column>
									<Column hAlign="End"><Text text="{i18n>mcColResolution}" /></Column>
									<Column hAlign="End"><Text text="" /></Column>
								</columns>
								<items>
									<ColumnListItem>
										<cells>
											<Text text="{mcTabs>PriorityDesc}" class="hrxMcStrong" />
											<Text text="{parts: ['mcTabs>ResponseSLA', 'mcTabs>UoM'], formatter: '.formatHours'}" />
											<Text text="{parts: ['mcTabs>ResolutionSLA', 'mcTabs>UoM'], formatter: '.formatHours'}" />
											<HBox renderType="Bare" class="hrxMcRowActs">
												<Button
													type="Transparent"
													tooltip="{i18n>mcEditSla}"
													press=".onEditSla"
													class="hrxMcIconBtn hrxMcIcoEdit" />
												<Button
													type="Transparent"
													tooltip="{i18n>mcDeleteSla}"
													press=".onDeleteSla"
													visible="{= !!${services>/clientSlas} }"
													class="hrxMcIconBtn hrxMcIconBtnDel hrxMcIcoTrash" />
											</HBox>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</VBox>

						<!-- ======================== tab: components ======================== -->
						<VBox id="clientComponentsTab" renderType="Bare" visible="{= ${mcView>/selectedTab} === 'components' }">
							<MessageStrip
								text="{i18n>serviceNeededClientComponents}"
								visible="{= !${services>/clientComponents} }"
								type="Warning"
								showIcon="true"
								enableFormattedText="true"
								class="sapUiSmallMarginBottom" />
							<HBox renderType="Bare" class="hrxMcSectHead">
								<Title text="{i18n>mcComponentsTitle}" level="H3" class="hrxMcSectTitle" />
								<Button
									id="clientAddComponentButton"
									text="{i18n>mcAddComponent}"
									press=".onAddComponent"
									class="hrxMcGhostSm hrxMcIcoPlus" />
							</HBox>
							<Table
								id="clientComponentTable"
								items="{mcTabs>/components}"
								busy="{mcView>/tabBusy}"
								busyIndicatorDelay="0"
								noDataText="{i18n>mcNoComponents}"
								fixedLayout="false"
								class="hrxMcTable">
								<columns>
									<Column><Text text="{i18n>mcColSoftware}" /></Column>
									<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>mcColValidity}" /></Column>
									<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>mcColStatus}" /></Column>
									<Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>mcColCosts}" /></Column>
									<Column hAlign="End"><Text text="" /></Column>
								</columns>
								<items>
									<ColumnListItem>
										<cells>
											<VBox renderType="Bare">
												<Text text="{mcTabs>AppName}" class="hrxMcStrong" />
												<Text
													text="{parts: ['mcTabs>ComponentName', 'mcTabs>SubComponentName', 'mcTabs>SystemNo'], formatter: '.formatComponentSub'}"
													visible="{= !!(${mcTabs>ComponentName} || ${mcTabs>SubComponentName} || ${mcTabs>SystemNo}) }"
													class="hrxMcTsub" />
											</VBox>
											<Text
												text="{parts: ['mcTabs>ValidFrom', 'mcTabs>ValidTill'], formatter: '.formatValidity'}"
												wrapping="false" />
											<HBox renderType="Bare" class="hrxMcFlags">
												<ObjectStatus
													text="{= ${mcTabs>IsSupported} === 'Y' ? ${i18n>mcInSupport} : ${i18n>mcOutOfSupport} }"
													state="{= ${mcTabs>IsSupported} === 'Y' ? 'Success' : 'Warning' }"
													class="hrxMcPill" />
												<ObjectStatus
													text="{i18n>mcCloud}"
													state="Information"
													visible="{= ${mcTabs>IsCloudCustomer} === 'Y' }"
													class="hrxMcPill" />
												<ObjectStatus
													text="{i18n>mcWarning}"
													tooltip="{mcTabs>WarningMessage}"
													state="Warning"
													visible="{= ${mcTabs>ShowWarning} === '1' }"
													class="hrxMcPill" />
												<ObjectStatus
													text="{i18n>mcHardStop}"
													tooltip="{mcTabs>HardMessage}"
													state="Error"
													visible="{= !!${mcTabs>HardMessage} }"
													class="hrxMcPill" />
											</HBox>
											<VBox renderType="Bare" class="hrxMcCosts">
												<Text
													text="{parts: ['mcTabs>ObjectCost', 'mcTabs>SupportCost'], formatter: '.formatCosts'}"
													wrapping="false" />
												<Text text="{i18n>mcCostsSub}" wrapping="false" class="hrxMcTsub" />
											</VBox>
											<HBox renderType="Bare" class="hrxMcRowActs">
												<Button
													type="Transparent"
													tooltip="{i18n>mcEditComponent}"
													press=".onEditComponent"
													class="hrxMcIconBtn hrxMcIcoEdit" />
												<Button
													type="Transparent"
													tooltip="{i18n>mcDeleteComponent}"
													press=".onDeleteComponent"
													class="hrxMcIconBtn hrxMcIconBtnDel hrxMcIcoTrash" />
											</HBox>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</VBox>

						<!-- ================== tab: application details ================== -->
						<VBox id="clientServicesTab" renderType="Bare" visible="{= ${mcView>/selectedTab} === 'services' }">
							<MessageStrip
								text="{i18n>serviceNeededClientApps}"
								visible="{= !${services>/clientApplications} }"
								type="Warning"
								showIcon="true"
								enableFormattedText="true"
								class="sapUiSmallMarginBottom" />
							<HBox renderType="Bare" class="hrxMcSectHead">
								<Title text="{i18n>mcServicesTitle}" level="H3" class="hrxMcSectTitle" />
								<Button
									id="clientAddServiceButton"
									text="{i18n>mcAddService}"
									press=".onAddService"
									class="hrxMcGhostSm hrxMcIcoPlus" />
							</HBox>
							<Table
								id="clientServiceTable"
								items="{mcTabs>/services}"
								busy="{mcView>/tabBusy}"
								busyIndicatorDelay="0"
								noDataText="{i18n>mcNoServices}"
								fixedLayout="false"
								class="hrxMcTable">
								<columns>
									<Column><Text text="{i18n>mcColApp}" /></Column>
									<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>mcColService}" /></Column>
									<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>mcColValidity}" /></Column>
									<Column hAlign="End"><Text text="" /></Column>
								</columns>
								<items>
									<ColumnListItem>
										<cells>
											<Text text="{mcTabs>AppID}" class="hrxMcStrong" />
											<Text text="{mcTabs>ServiceDesc}" />
											<Text
												text="{parts: ['mcTabs>ValidFrom', 'mcTabs>ValidTill'], formatter: '.formatValidity'}"
												wrapping="false" />
											<HBox renderType="Bare" class="hrxMcRowActs">
												<Button
													type="Transparent"
													tooltip="{i18n>mcEditService}"
													press=".onEditService"
													visible="{= !!${services>/clientApplications} }"
													class="hrxMcIconBtn hrxMcIcoEdit" />
												<Button
													type="Transparent"
													tooltip="{i18n>mcDeleteService}"
													press=".onDeleteService"
													visible="{= !!${services>/clientApplications} }"
													class="hrxMcIconBtn hrxMcIconBtnDel hrxMcIcoTrash" />
											</HBox>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</VBox>
					</VBox>

					<!-- Basic Info is the one tab saved as a whole, from the card's foot -->
					<HBox
						renderType="Bare"
						visible="{= ${mcView>/selectedTab} === 'basic' }"
						class="hrxMcFoot">
						<Button
							id="clientSaveButton"
							text="{i18n>mcSave}"
							type="Emphasized"
							press=".onSaveClient"
							class="hrxMcPrimary" />
					</HBox>
				</VBox>
			</HBox>
		</content>
	</Page>
</mvc:View>
