<mvc:View
	controllerName="bsx.hrx.hrx2026.controller.Home"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true">
	<!-- Home, laid out as the 15.10.26 design's dashboard view: the manager's tiles
	     and team cards on top, then "For you" (Quick Leave, Quick Timesheet) and the
	     week's timesheet rings. Every class used here is styled in css/pages/home.css,
	     under the page's root class hrxHomePage. -->
	<Page id="homePage" showHeader="false" showNavButton="false" class="hrxPageContent hrxHomePage">

		<!-- ═════════ Manager dashboard ═════════
		     Managers and admins only. Keyed off the profile's isManager flag, so the
		     shell's "View as (demo)" switch applies to it, as the design's role switch
		     hides #managerDash for an employee. -->
		<VBox id="managerDash" renderType="Bare" visible="{app>/user/isManager}" class="hrxHomeMgrDash">

			<!-- Four KPI tiles: a CSS grid of four equal columns -->
			<HBox renderType="Bare" class="hrxHomeKpis">

				<!-- Team in / working today -->
				<VBox renderType="Bare" class="hrxHomeKpi" busy="{home>/dash/loadingTeam}" busyIndicatorDelay="0">
					<customData><core:CustomData key="state" value="Neutral" writeToDom="true" /></customData>
					<HBox renderType="Bare" class="hrxHomeKpiGlyph">
						<core:Icon src="sap-icon://tabler/users" />
					</HBox>
					<Text text="{i18n>mgrKpiTeam}" class="hrxHomeKpiLabel" />
					<HBox renderType="Bare" class="hrxHomeKpiFigure">
						<Text text="{home>/dash/team/working}" class="hrxHomeKpiNum" />
						<Text text="{home>/dash/team/unit}" class="hrxHomeKpiUnit" visible="{= !!${home>/dash/team/unit} }" />
					</HBox>
					<Text text="{home>/dash/team/sub}" class="hrxHomeKpiSub" />
					<Button text="{i18n>mgrFullView}" icon="sap-icon://arrow-right" iconFirst="false"
						press=".onDashGo" class="hrxHomeBtn hrxHomeBtnGhost hrxHomeBtnSm hrxHomeBtnArrow hrxHomeKpiLink">
						<customData><core:CustomData key="go" value="teamcal" /></customData>
					</Button>
				</VBox>

				<!-- Timesheet compliance -->
				<VBox renderType="Bare" class="hrxHomeKpi" busy="{home>/dash/loadingCompliance}" busyIndicatorDelay="0">
					<customData><core:CustomData key="state" value="{home>/dash/compliance/state}" writeToDom="true" /></customData>
					<HBox renderType="Bare" class="hrxHomeKpiGlyph">
						<core:Icon src="sap-icon://tabler/clipboard-check" />
					</HBox>
					<Text text="{i18n>mgrKpiCompliance}" class="hrxHomeKpiLabel" />
					<HBox renderType="Bare" class="hrxHomeKpiFigure">
						<Text text="{home>/dash/compliance/pct}" class="hrxHomeKpiNum" />
						<Text text="%" class="hrxHomeKpiUnit" visible="{= ${home>/dash/compliance/pct} !== '—' }" />
					</HBox>
					<Text text="{home>/dash/compliance/sub}" class="hrxHomeKpiSub" />
					<Button text="{i18n>mgrViewTeam}" icon="sap-icon://arrow-right" iconFirst="false"
						press=".onDashGo" class="hrxHomeBtn hrxHomeBtnGhost hrxHomeBtnSm hrxHomeBtnArrow hrxHomeKpiLink">
						<customData><core:CustomData key="go" value="timesheetreport:sub" /></customData>
					</Button>
				</VBox>

				<!-- Policy triggers -->
				<VBox renderType="Bare" class="hrxHomeKpi" busy="{home>/dash/loadingTriggers}" busyIndicatorDelay="0">
					<customData><core:CustomData key="state" value="{home>/dash/triggers/state}" writeToDom="true" /></customData>
					<HBox renderType="Bare" class="hrxHomeKpiGlyph">
						<core:Icon src="sap-icon://tabler/alert-triangle" />
					</HBox>
					<Text text="{i18n>homeKpiTriggers}" class="hrxHomeKpiLabel" />
					<HBox renderType="Bare" class="hrxHomeKpiFigure">
						<Text text="{home>/dash/triggers/count}" class="hrxHomeKpiNum" />
					</HBox>
					<Text text="{home>/dash/triggers/sub}" class="hrxHomeKpiSub" />
					<Button text="{i18n>mgrReview}" icon="sap-icon://arrow-right" iconFirst="false"
						press=".onDashGo" class="hrxHomeBtn hrxHomeBtnGhost hrxHomeBtnSm hrxHomeBtnArrow hrxHomeKpiLink">
						<customData><core:CustomData key="go" value="sickness" /></customData>
					</Button>
				</VBox>

				<!-- Documents awaiting acknowledgement -->
				<VBox renderType="Bare" class="hrxHomeKpi" busy="{home>/dash/loadingDocs}" busyIndicatorDelay="0">
					<customData><core:CustomData key="state" value="{home>/dash/docs/state}" writeToDom="true" /></customData>
					<HBox renderType="Bare" class="hrxHomeKpiGlyph">
						<core:Icon src="sap-icon://tabler/file-text" />
					</HBox>
					<Text text="{i18n>mgrKpiDocs}" class="hrxHomeKpiLabel" />
					<HBox renderType="Bare" class="hrxHomeKpiFigure">
						<Text text="{home>/dash/docs/count}" class="hrxHomeKpiNum" />
					</HBox>
					<Text text="{home>/dash/docs/sub}" class="hrxHomeKpiSub" />
					<Button text="{i18n>mgrReview}" icon="sap-icon://arrow-right" iconFirst="false"
						press=".onDashGo" class="hrxHomeBtn hrxHomeBtnGhost hrxHomeBtnSm hrxHomeBtnArrow hrxHomeKpiLink">
						<customData><core:CustomData key="go" value="documents" /></customData>
					</Button>
				</VBox>
			</HBox>

			<!-- Team today on the left; Pending approvals over Billable utilisation on
			     the right (the design's .dash-grid, 1fr / 1.15fr) -->
			<HBox renderType="Bare" class="hrxHomeDashGrid">

				<!-- Team today -->
				<VBox renderType="Bare" class="hrxHomeCard hrxHomeTeamCard" busy="{home>/dash/loadingTeam}" busyIndicatorDelay="0">
					<HBox renderType="Bare" class="hrxHomeCardHead">
						<Title text="{i18n>mgrTeamToday}" level="H3" class="hrxHomeCardTitle" />
						<HBox renderType="Bare" class="hrxHomeCardHeadEnd">
							<Text text="{home>/dash/todayLabel}" class="hrxHomeCardHint" />
							<Button text="{i18n>mgrFullView}" press=".onDashGo" class="hrxHomeBtn hrxHomeBtnGhost hrxHomeBtnSm">
								<customData><core:CustomData key="go" value="teamcal" /></customData>
							</Button>
						</HBox>
					</HBox>
					<!-- Scrolls past 560px, with the column headers kept in view -->
					<ScrollContainer vertical="true" horizontal="false" class="hrxHomeTeamScroll">
						<Table
							items="{path: 'home>/dash/today', templateShareable: false}"
							fixedLayout="false"
							sticky="ColumnHeaders"
							showSeparators="Inner"
							noDataText="{i18n>mgrNoTeam}"
							class="hrxHomeTeamTable">
							<columns>
								<Column><Text text="{i18n>mgrColEmployee}" /></Column>
								<Column><Text text="{i18n>mgrColSite}" /></Column>
								<Column><Text text="{i18n>mgrColStatus}" /></Column>
							</columns>
							<items>
								<ColumnListItem>
									<cells>
										<HBox renderType="Bare" class="hrxHomePerson">
											<Text text="{home>initials}" class="hrxHomeAvatar" />
											<Text text="{home>Name}" class="hrxHomePersonName" />
										</HBox>
										<Text text="{home>site}" />
										<Text text="{home>statusText}" class="hrxHomePill">
											<customData><core:CustomData key="state" value="{home>statusState}" writeToDom="true" /></customData>
										</Text>
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</ScrollContainer>
				</VBox>

				<VBox renderType="Bare" class="hrxHomeDashStack">

					<!-- Pending approvals: the manager's own team only (HrxLegacy pendingApproval) -->
					<core:Fragment fragmentName="bsx.hrx.hrx2026.fragment.HomePendingApprovals" type="XML" />

					<!-- Billable utilisation, financial year to date -->
					<VBox renderType="Bare" class="hrxHomeCard hrxHomeUtilCard" busy="{home>/dash/loadingUtil}" busyIndicatorDelay="0">
						<HBox renderType="Bare" class="hrxHomeCardHead">
							<Title text="{i18n>mgrUtilTitle}" level="H3" class="hrxHomeCardTitle" />
							<HBox renderType="Bare" class="hrxHomeCardHeadEnd">
								<Text text="{i18n>homeUtilHint}" class="hrxHomeCardHint" />
								<Button text="{i18n>mgrFullReport}" press=".onDashGo" class="hrxHomeBtn hrxHomeBtnGhost hrxHomeBtnSm">
									<customData><core:CustomData key="go" value="timesheetreport:util" /></customData>
								</Button>
							</HBox>
						</HBox>
						<VBox renderType="Bare" class="hrxHomeCardBody">
							<HBox renderType="Bare" class="hrxHomeUtilTop">
								<Text text="{home>/dash/util/pctText}" class="hrxHomeUtilBig" />
								<Text text="{home>/dash/util/cap}" class="hrxHomeUtilCap" />
							</HBox>
							<Text text="{i18n>mgrNoUtil}" visible="{= ${home>/dash/util/rows}.length === 0 }" class="hrxHomeEmpty" />
							<VBox renderType="Bare" items="{path: 'home>/dash/util/rows', templateShareable: false}">
								<HBox renderType="Bare" class="hrxHomeUtilRow">
									<VBox renderType="Bare" class="hrxHomeUtilWho">
										<Text text="{home>Name}" class="hrxHomeUtilName" />
										<Text text="{home>sub}" class="hrxHomeUtilSub" />
									</VBox>
									<VBox renderType="Bare" class="hrxHomeUtilBar">
										<Text text="{home>pctText}" class="hrxHomeUtilPct" />
										<HBox renderType="Bare" class="hrxHomeUtilLine">
											<ProgressIndicator
												percentValue="{home>barPct}"
												showValue="false"
												displayOnly="true"
												state="{home>state}"
												class="hrxHomeUtilTrack" />
											<!-- The design's own state icon, drawn with a CSS mask -->
											<HBox renderType="Bare" class="hrxHomeStateIcon">
												<customData><core:CustomData key="state" value="{home>state}" writeToDom="true" /></customData>
											</HBox>
										</HBox>
									</VBox>
								</HBox>
							</VBox>
						</VBox>
					</VBox>
				</VBox>
			</HBox>

			<!-- For you: the manager's own leave and time -->
			<VBox renderType="Bare" class="hrxHomeSectionHead">
				<Text text="{i18n>mgrOwnEyebrow}" class="hrxHomeSectionEyebrow" />
				<Title text="{i18n>mgrOwnTitle}" level="H2" class="hrxHomeSectionTitle" />
			</VBox>
		</VBox>

		<!-- Somebody the profile does not flag as a manager can still have requests
		     waiting on them (the team calendar lists them too). They get the same card,
		     on its own row, only while there is something in it. -->
		<VBox id="ownApprovals" renderType="Bare" class="hrxHomeOwnApprovals"
			visible="{= !${app>/user/isManager} &amp;&amp; ${home>/approvals}.length > 0 }">
			<core:Fragment fragmentName="bsx.hrx.hrx2026.fragment.HomePendingApprovals" type="XML" />
		</VBox>

		<!-- ═════════ Quick Leave and Quick Timesheet ═════════ -->
		<HBox renderType="Bare" class="hrxHomeActionRow">

			<!-- Quick Leave -->
			<VBox id="quickLeaveCard" renderType="Bare" class="hrxHomeCard">
				<HBox renderType="Bare" class="hrxHomeCardHead">
					<Title text="{i18n>quickLeaveTitle}" level="H3" class="hrxHomeCardTitle" />
				</HBox>
				<VBox renderType="Bare" class="hrxHomeCardBody hrxHomeFormBody" busy="{home>/savingLeave}" busyIndicatorDelay="0">
					<Label text="{i18n>fieldDates}" labelFor="qlDates" class="hrxHomeLabel" />
					<!-- Opens the design's own range picker (fragment/HomeDatePopover) -->
					<Input
						id="qlDates"
						value="{home>/quickLeave/rangeText}"
						placeholder="{i18n>homeDatesPlaceholder}"
						showValueHelp="true"
						valueHelpOnly="true"
						valueHelpRequest=".onOpenQuickLeaveCalendar"
						class="hrxHomeField hrxHomeDateField" />

					<Label text="{i18n>fieldLeaveType}" labelFor="qlType" class="hrxHomeLabel" />
					<Select
						id="qlType"
						width="100%"
						selectedKey="{home>/quickLeave/LeaveCategoryId}"
						items="{home>/leaveTypes}"
						class="hrxHomeField">
						<core:Item key="{home>LeaveCategoryId}" text="{home>LeaveCategoryDesc}" />
					</Select>

					<Label text="{i18n>fieldDuration}" labelFor="qlDuration" class="hrxHomeLabel" />
					<Select
						id="qlDuration"
						width="100%"
						selectedKey="{home>/quickLeave/DayTime}"
						change=".onQuickLeaveDurationChange"
						class="hrxHomeField">
						<core:Item key="Full Day" text="{i18n>durationFullDay}" />
						<core:Item key="AM" text="{i18n>durationHalfAM}" />
						<core:Item key="PM" text="{i18n>durationHalfPM}" />
					</Select>

					<Label text="{i18n>fieldComments}" labelFor="qlComments" class="hrxHomeLabel" />
					<TextArea
						id="qlComments"
						value="{home>/quickLeave/Comments}"
						rows="2"
						width="100%"
						placeholder="{i18n>mlOptional}"
						class="hrxHomeField" />

					<Label text="{i18n>fieldApprover}" class="hrxHomeLabel" />
					<Text text="{home>/user/managerName}" class="hrxHomeApprover" />

					<Button
						id="qlSubmit"
						text="{i18n>btnRequestLeave}"
						width="100%"
						press=".onRequestLeave"
						class="hrxHomeBtn hrxHomeBtnPrimary hrxHomeFormSubmit" />
				</VBox>
			</VBox>

			<!-- Quick Timesheet -->
			<VBox id="quickTimesheetCard" renderType="Bare" class="hrxHomeCard">
				<HBox renderType="Bare" class="hrxHomeCardHead">
					<Title text="{i18n>quickTimesheetTitle}" level="H3" class="hrxHomeCardTitle" />
					<!-- The day being booked: "Today" as in the design. Pressing it opens the
					     same picker as Quick Leave, so another day can be booked as before. -->
					<Link
						id="qtDay"
						text="{home>/quick/dayLabel}"
						tooltip="{i18n>homeChangeDay}"
						press=".onOpenQuickDayCalendar"
						class="hrxHomeCardHint hrxHomeDayLink" />
				</HBox>
				<VBox renderType="Bare" class="hrxHomeCardBody hrxHomeFormBody" busy="{home>/loadingDay}" busyIndicatorDelay="0">

					<!-- Nothing booked yet for the chosen day: the entry form -->
					<VBox renderType="Bare" visible="{= !${home>/quick/logged} }" class="hrxHomeFormFill">
						<MessageStrip
							text="{home>/quick/dayEditableReason}"
							type="Information"
							showIcon="true"
							class="hrxHomeStrip"
							visible="{= !${home>/quick/dayEditable} }" />

						<Label text="{i18n>fieldProject}" labelFor="qtProject" class="hrxHomeLabel" />
						<!-- The projects bookable on the chosen day, loaded by _loadDay; the
						     first entry is the "Select a project…" prompt. -->
						<Select
							id="qtProject"
							width="100%"
							enabled="{home>/quick/dayEditable}"
							selectedKey="{home>/quick/ProjectID}"
							items="{home>/quick/projects}"
							class="hrxHomeField">
							<core:Item key="{home>ProjectID}" text="{home>label}" />
						</Select>

						<Label text="{i18n>fieldTimeSpent}" labelFor="qtHours" class="hrxHomeLabel" />
						<Input
							id="qtHours"
							enabled="{home>/quick/dayEditable}"
							value="{home>/quick/hours}"
							change=".onQuickHoursChange"
							placeholder="{i18n>qtHoursPlaceholder}"
							class="hrxHomeField" />

						<Label text="{i18n>fieldComment}" labelFor="qtComment" class="hrxHomeLabel" />
						<TextArea
							id="qtComment"
							value="{home>/quick/comment}"
							enabled="{home>/quick/dayEditable}"
							rows="2"
							width="100%"
							placeholder="{i18n>qtCommentPlaceholder}"
							class="hrxHomeField" />

						<Button
							id="qtSave"
							text="{i18n>btnSave}"
							width="100%"
							enabled="{home>/quick/dayEditable}"
							press=".onSaveQuickTimesheet"
							class="hrxHomeBtn hrxHomeBtnPrimary hrxHomeFormSubmit hrxHomeSaveBtn" />
					</VBox>

					<!-- Already booked: what the day holds, straight from the service -->
					<VBox renderType="Bare" visible="{home>/quick/logged}" class="hrxHomeLogged">
						<HBox renderType="Bare" class="hrxHomeLoggedIcon">
							<core:Icon src="sap-icon://tabler/check" />
						</HBox>
						<Text text="{home>/quick/loggedTitle}" class="hrxHomeLoggedTitle" />
						<Text text="{home>/quick/loggedSub}" class="hrxHomeLoggedSub" />
						<VBox renderType="Bare" items="{home>/quick/entries}" class="hrxHomeSummary">
							<VBox renderType="Bare" class="hrxHomeSummaryEntry">
								<HBox renderType="Bare" class="hrxHomeSummaryRow">
									<Text text="{i18n>homeSummaryProject}" class="hrxHomeSummaryKey" />
									<Text text="{home>project}" class="hrxHomeSummaryValue" />
								</HBox>
								<HBox renderType="Bare" class="hrxHomeSummaryRow">
									<Text text="{i18n>homeSummaryTime}" class="hrxHomeSummaryKey" />
									<Text text="{home>time}" class="hrxHomeSummaryValue" />
								</HBox>
								<HBox renderType="Bare" class="hrxHomeSummaryRow">
									<Text text="{i18n>homeSummaryComment}" class="hrxHomeSummaryKey" />
									<Text text="{home>comment}" class="hrxHomeSummaryValue" />
								</HBox>
							</VBox>
						</VBox>
						<!-- Where the design has its reset link: back to the form to book more -->
						<Link id="qtLogMore" text="{i18n>btnLogMoreTime}" press=".onLogMoreTime" class="hrxHomeResetLink" />
					</VBox>
				</VBox>
			</VBox>
		</HBox>

		<!-- ═════════ This week's timesheet ═════════ -->
		<VBox id="weekSummaryCard" renderType="Bare" class="hrxHomeCard hrxHomeWeekCard">
			<HBox renderType="Bare" class="hrxHomeCardHead">
				<Title text="{i18n>timesheetCardTitle}" level="H3" class="hrxHomeCardTitle" />
				<Text text="{i18n>homeThisWeek}" tooltip="{home>/week/label}" class="hrxHomeCardHint" />
			</HBox>
			<VBox renderType="Bare" class="hrxHomeCardBody" busy="{home>/loadingWeek}" busyIndicatorDelay="0">
				<!-- One column per day: the day, its ring and, on leave, the word "Leave".
				     The hover text sits on the whole column and gives the exact hours. -->
				<HBox renderType="Bare" items="{home>/weekRings}" class="hrxHomeRings">
					<VBox renderType="Bare" tooltip="{home>tooltip}" class="hrxHomeRingDay">
						<Text text="{home>day}" class="hrxHomeRingDayName" />
						<!-- A 44px SVG ring built by Home.controller _ringSvg -->
						<core:HTML content="{home>svg}" sanitizeContent="false" />
						<Text text="{i18n>homeRingLeave}" visible="{home>onLeave}" class="hrxHomeRingLeave" />
					</VBox>
				</HBox>

				<HBox renderType="Bare" class="hrxHomeLegend">
					<HBox renderType="Bare" class="hrxHomeLegendItem">
						<HBox renderType="Bare" class="hrxHomeLegendDot hrxHomeDotMissing" />
						<Text text="{i18n>legendMissing}" />
					</HBox>
					<HBox renderType="Bare" class="hrxHomeLegendItem">
						<HBox renderType="Bare" class="hrxHomeLegendDot hrxHomeDotShort" />
						<Text text="{i18n>legendActionNeeded}" />
					</HBox>
					<HBox renderType="Bare" class="hrxHomeLegendItem">
						<HBox renderType="Bare" class="hrxHomeLegendDot hrxHomeDotComplete" />
						<Text text="{i18n>legendComplete}" />
					</HBox>
					<!-- Only in a week that has an overbooked day: the design has no such
					     state, but the service can report one. -->
					<HBox renderType="Bare" class="hrxHomeLegendItem" visible="{home>/weekHasOverbooked}">
						<HBox renderType="Bare" class="hrxHomeLegendDot hrxHomeDotOver" />
						<Text text="{i18n>legendOverbooked}" />
					</HBox>
					<HBox renderType="Bare" class="hrxHomeLegendItem">
						<HBox renderType="Bare" class="hrxHomeLegendDot hrxHomeDotLeave" />
						<Text text="{i18n>legendOnLeave}" />
					</HBox>
					<HBox renderType="Bare" class="hrxHomeLegendItem">
						<HBox renderType="Bare" class="hrxHomeLegendDot hrxHomeDotNotDue" />
						<Text text="{i18n>legendNotDue}" />
					</HBox>
				</HBox>
			</VBox>
		</VBox>
	</Page>
</mvc:View>
