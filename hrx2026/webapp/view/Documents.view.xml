<mvc:View
	controllerName="bsx.hrx.hrx2026.controller.Documents"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:core="sap.ui.core"
	xmlns:layout="sap.ui.layout"
	displayBlock="true"
	class="hrxDocuments">

	<Page id="documentsPage" showHeader="false" title="{i18n>dmTitle}" showNavButton="false" class="hrxPageContent">
		<content>
			<IllustratedMessage
				visible="{= !${app>/user/isManager} }"
				illustrationType="sapIllus-UnableToLoad"
				title="{i18n>dmTitle}"
				description="{i18n>adminRestricted}" />

			<VBox visible="{app>/user/isManager}" busy="{dmView>/busy}" busyIndicatorDelay="0">

				<HBox justifyContent="End" class="sapUiSmallMarginBottom">
					<Button
						id="documentsUpload"
						text="{i18n>dmUpload}"
						icon="sap-icon://upload"
						type="Emphasized"
						press=".onOpenUpload" />
				</HBox>

				<MessageStrip
					text="{i18n>serviceNeededDocuments}"
					type="Warning"
					showIcon="true"
					enableFormattedText="true"
					visible="{= !${dmView>/bound} }"
					class="sapUiSmallMarginBottom" />
				<MessageStrip
					text="{dm>/lowText}"
					type="Warning"
					showIcon="true"
					visible="{= ${dm>/low} > 0 }"
					class="sapUiSmallMarginBottom" />

				<layout:Grid defaultSpan="XL7 L7 M12 S12" hSpacing="1" vSpacing="1" class="hrxDocGrid">

					<!-- all documents -->
					<VBox id="documentsListCard" class="hrxSkCard hrxTrCard">
						<layoutData><layout:GridData span="XL7 L7 M12 S12" /></layoutData>
						<HBox alignItems="Center" class="hrxTrCardHead">
							<VBox class="hrxTrCardHeadText">
								<Title text="{i18n>dmAllDocuments}" level="H3" wrapping="true" class="hrxTrCardTitle" />
								<Text text="{dm>/countText}" class="hrxSkHint" />
							</VBox>
						</HBox>
						<VBox class="hrxDocTools">
							<HBox alignItems="Center" class="hrxDocToolRow">
								<SearchField
									value="{dmView>/q}"
									placeholder="{i18n>dmSearch}"
									liveChange=".onFilterChange"
									width="100%">
									<layoutData><FlexItemData growFactor="1" /></layoutData>
								</SearchField>
								<Select
									selectedKey="{dmView>/category}"
									items="{path: 'dm>/categories', templateShareable: false}"
									change=".onFilterChange"
									width="11rem">
									<core:Item key="{dm>key}" text="{dm>text}" />
								</Select>
							</HBox>
							<HBox wrap="Wrap" items="{path: 'dm>/chips', templateShareable: false}" class="hrxDocChips">
								<Button
									text="{dm>text}"
									type="{= ${dm>selected} ? 'Emphasized' : 'Default' }"
									press=".onChip"
									class="hrxDocChip" />
							</HBox>
						</VBox>

						<VBox visible="{= ${dm>/rows}.length === 0 }" class="hrxDocEmpty">
							<Title text="{= ${dm>/total} ? ${i18n>dmNoMatch} : ${i18n>dmNoDocuments} }" level="H4" />
							<Text text="{= ${dm>/total} ? ${i18n>dmNoMatchText} : ${i18n>dmNoDocumentsText} }" class="hrxResourceMeta" />
						</VBox>

						<VBox id="documentsList" items="{path: 'dm>/rows', templateShareable: false}">
							<HBox alignItems="Center" class="hrxDocRow2">
								<customData>
									<core:CustomData key="id" value="{dm>DocumentID}" writeToDom="true" />
									<core:CustomData key="sel" value="{= ${dm>selected} ? 'yes' : 'no' }" writeToDom="true" />
								</customData>
								<VBox class="hrxDocMain">
									<Text text="{dm>Name}" class="hrxDocName" />
									<Text text="{dm>meta}" class="hrxResourceMeta" />
								</VBox>
								<VBox class="hrxDocAck">
									<Text text="{dm>ackText}" class="{= ${dm>AckRequired} ? 'hrxDocAckN' : 'hrxResourceMeta' }" />
									<core:HTML content="{dm>barHtml}" visible="{dm>AckRequired}" />
								</VBox>
								<HBox class="hrxDocAct" justifyContent="End">
									<Button
										icon="sap-icon://email"
										type="Transparent"
										tooltip="{i18n>dmRemindOutstanding}"
										visible="{= ${dm>outstandingCount} > 0 }"
										press=".onRemindRow" />
								</HBox>
							</HBox>
						</VBox>
					</VBox>

					<!-- who hasn't acknowledged the selected document -->
					<VBox class="hrxSkCard hrxTrCard">
						<layoutData><layout:GridData span="XL5 L5 M12 S12" /></layoutData>
						<HBox alignItems="Center" class="hrxTrCardHead">
							<VBox class="hrxTrCardHeadText">
								<Title text="{i18n>dmWhoTitle}" level="H3" wrapping="true" class="hrxTrCardTitle" />
								<Text text="{dm>/selected/Name}" class="hrxSkHint" />
							</VBox>
						</HBox>

						<VBox visible="{= !!${dm>/detailEmptyTitle} }" class="hrxDocEmpty">
							<Title text="{dm>/detailEmptyTitle}" level="H4" />
							<Text text="{dm>/detailEmptyText}" class="hrxResourceMeta" />
						</VBox>

						<VBox items="{path: 'dm>/outstanding', templateShareable: false}" class="hrxDocWho">
							<HBox alignItems="Center" class="hrxDocWhoRow">
								<f:Avatar initials="{dm>initials}" displaySize="XS" backgroundColor="Accent6" class="sapUiTinyMarginEnd" />
								<VBox>
									<Text text="{dm>Name}" class="hrxResourceName" />
									<Text text="{dm>siteName}" class="hrxResourceMeta" />
								</VBox>
							</HBox>
						</VBox>

						<HBox justifyContent="End" wrap="Wrap" visible="{= !!${dm>/selected/DocumentID} }" class="hrxDocWhoFoot">
							<Button
								text="{i18n>dmRemove}"
								icon="sap-icon://delete"
								type="Transparent"
								press=".onRemove" />
							<Button
								text="{i18n>dmRemindOutstanding}"
								icon="sap-icon://email"
								type="Emphasized"
								visible="{= ${dm>/outstanding}.length > 0 }"
								press=".onRemindSelected" />
						</HBox>
					</VBox>
				</layout:Grid>
			</VBox>
		</content>
	</Page>
</mvc:View>
