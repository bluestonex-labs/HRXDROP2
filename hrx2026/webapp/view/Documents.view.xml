<mvc:View
	controllerName="bsx.hrx.hrx2026.controller.Documents"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
	class="hrxDocuments hrxPageDocuments">

	<!-- "Upload document" is in the shell's top bar on this route, as in the design:
	     it calls onPageAction (see App.controller). -->
	<Page id="documentsPage" showHeader="false" title="{i18n>dmTitle}" showNavButton="false" class="hrxPageContent">
		<content>
			<IllustratedMessage
				visible="{= !${app>/user/isManager} }"
				illustrationType="sapIllus-UnableToLoad"
				title="{i18n>dmTitle}"
				description="{i18n>adminRestricted}" />

			<VBox visible="{app>/user/isManager}" busy="{dmView>/busy}" busyIndicatorDelay="0" renderType="Bare">

				<MessageStrip
					text="{i18n>serviceNeededDocuments}"
					type="Warning"
					showIcon="true"
					enableFormattedText="true"
					visible="{= !${dmView>/bound} }"
					class="hrxPdStrip" />

				<!-- .alert.warn: how many documents are below the acknowledgement target -->
				<HBox visible="{= ${dm>/low} > 0 }" renderType="Bare" class="hrxDmAlert">
					<core:Icon src="sap-icon://warning" class="hrxDmAlertIcon" />
					<Text text="{dm>/lowText}" class="hrxDmAlertText" />
				</HBox>

				<HBox renderType="Bare" class="hrxDmGrid">

					<!-- All documents: search, category, filter chips, then one row per document -->
					<VBox id="documentsListCard" renderType="Bare" class="hrxPdCard hrxDmPanel">
						<HBox renderType="Bare" class="hrxPdCardHead">
							<Title text="{i18n>dmAllDocuments}" level="H3" class="hrxPdCardTitle" />
							<Text text="{dm>/countText}" class="hrxPdCardHint" />
						</HBox>

						<HBox renderType="Bare" class="hrxDmTools">
							<HBox renderType="Bare" class="hrxDmSearch">
								<core:Icon src="sap-icon://search" class="hrxDmSearchIcon" />
								<Input
									value="{dmView>/q}"
									placeholder="{i18n>dmSearch}"
									valueLiveUpdate="true"
									liveChange=".onFilterChange"
									width="100%"
									class="hrxDmInput" />
							</HBox>
							<Select
								selectedKey="{dmView>/category}"
								items="{path: 'dm>/categories', templateShareable: false}"
								change=".onFilterChange"
								width="170px"
								class="hrxDmSelect">
								<core:Item key="{dm>key}" text="{dm>text}" />
							</Select>
						</HBox>

						<!-- .doc-filters: each chip carries its count in a small pill after the label -->
						<HBox items="{path: 'dm>/chips', templateShareable: false}" renderType="Bare" class="hrxDmChips">
							<Button text="{dm>text}" press=".onChip" class="hrxDmChip">
								<customData>
									<core:CustomData key="count" value="{dm>count}" writeToDom="true" />
									<core:CustomData key="on" value="{= ${dm>selected} ? 'yes' : 'no' }" writeToDom="true" />
								</customData>
							</Button>
						</HBox>

						<VBox renderType="Bare" class="hrxDmRows">
							<VBox visible="{= ${dm>/rows}.length === 0 }" renderType="Bare" class="hrxPdEmpty">
								<Text text="{= ${dm>/total} ? ${i18n>dmNoMatch} : ${i18n>dmNoDocuments} }" textAlign="Center" class="hrxPdEmptyTitle" />
								<Text text="{= ${dm>/total} ? ${i18n>dmNoMatchText} : ${i18n>dmNoDocumentsText} }" textAlign="Center" class="hrxPdEmptyText" />
							</VBox>

							<VBox id="documentsList" items="{path: 'dm>/rows', templateShareable: false}" renderType="Bare">
								<!-- a click on the row selects it (see onInit) -->
								<HBox renderType="Bare" class="hrxDmRow">
									<customData>
										<core:CustomData key="id" value="{dm>DocumentID}" writeToDom="true" />
										<core:CustomData key="sel" value="{= ${dm>selected} ? 'yes' : 'no' }" writeToDom="true" />
									</customData>
									<VBox renderType="Bare" class="hrxDmMain">
										<Text text="{dm>Name}" wrapping="false" class="hrxPdName" />
										<Text text="{dm>meta}" wrapping="false" class="hrxPdMeta" />
									</VBox>

									<!-- .ack-mini: "acknowledged / audience", the bar and its state icon -->
									<HBox visible="{= !!${dm>AckRequired} }" renderType="Bare" class="hrxDmAck">
										<Text text="{dm>ackText}" class="hrxDmAckN" />
										<ProgressIndicator
											percentValue="{dm>pct}"
											showValue="false"
											width="84px"
											height="7px"
											state="{dm>ackState}"
											class="hrxDmBar" />
										<core:Icon src="sap-icon://status-inactive" class="hrxDmAckIcon">
											<core:customData>
												<core:CustomData key="state" value="{dm>ackIcon}" writeToDom="true" />
											</core:customData>
										</core:Icon>
									</HBox>
									<Text text="{dm>ackText}" visible="{= !${dm>AckRequired} }" class="hrxPdNoAck" />

									<HBox renderType="Bare" class="hrxDmAct">
										<Button
											icon="sap-icon://email"
											tooltip="{i18n>dmRemindOutstanding}"
											visible="{= ${dm>outstandingCount} > 0 }"
											press=".onRemindRow"
											class="hrxDmIconBtn hrxPdBtnMail" />
									</HBox>
								</HBox>
							</VBox>
						</VBox>
					</VBox>

					<!-- Who hasn't acknowledged the selected document -->
					<VBox renderType="Bare" class="hrxPdCard hrxDmPanel">
						<HBox renderType="Bare" class="hrxPdCardHead">
							<Title text="{i18n>dmWhoTitle}" level="H3" class="hrxPdCardTitle" />
							<Text text="{dm>/selected/Name}" wrapping="false" class="hrxPdCardHint hrxDmWhoDoc" />
						</HBox>

						<VBox renderType="Bare" class="hrxDmRows">
							<VBox visible="{= !!${dm>/detailEmptyTitle} }" renderType="Bare" class="hrxPdEmpty">
								<Text text="{dm>/detailEmptyTitle}" textAlign="Center" class="hrxPdEmptyTitle" />
								<Text text="{dm>/detailEmptyText}" visible="{= !!${dm>/detailEmptyText} }" textAlign="Center" class="hrxPdEmptyText" />
							</VBox>

							<VBox items="{path: 'dm>/outstanding', templateShareable: false}" renderType="Bare">
								<HBox renderType="Bare" class="hrxDmWhoRow">
									<Image src="{= ${pictures>/users}[${dm>EmpID}] || '' }" visible="{= !!${pictures>/users}[${dm>EmpID}] }" width="30px" height="30px" class="hrxAvatarPic" />
									<Text text="{dm>initials}" visible="{= !${pictures>/users}[${dm>EmpID}] }" class="hrxDmAvatar" />
									<VBox renderType="Bare">
										<Text text="{dm>Name}" class="hrxDmWhoName" />
										<Text text="{dm>siteName}" class="hrxDmWhoSite" />
									</VBox>
								</HBox>
							</VBox>

							<!-- .who-foot: Remind outstanding. Remove document is the app's own
							     (the design has no way to unpublish), so it sits beside it. -->
							<HBox visible="{= !!${dm>/selected/DocumentID} }" renderType="Bare" class="hrxDmWhoFoot">
								<Button
									text="{i18n>dmRemove}"
									icon="sap-icon://delete"
									press=".onRemove"
									class="hrxPdBtn hrxPdBtnTrash" />
								<Button
									text="{i18n>dmRemindOutstanding}"
									icon="sap-icon://email"
									type="Emphasized"
									visible="{= ${dm>/outstanding}.length > 0 }"
									press=".onRemindSelected"
									class="hrxPdBtn hrxPdBtnMail" />
							</HBox>
						</VBox>
					</VBox>
				</HBox>
			</VBox>
		</content>
	</Page>
</mvc:View>
