<mvc:View
	controllerName="bsx.hrx.hrx2026.controller.TeamCalendar"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
	height="100%"
	class="hrxTeamCalendar">

	<!-- Team Calendar, as the 15.10.26 design has it: a manager's Team leave card
	     above the week's availability grid. -->
	<Page id="teamCalPage" showHeader="false" title="{i18n>teamCalendarTitle}" showNavButton="false" class="hrxPageContent">
		<content>
			<VBox class="hrxTcStack">

				<!-- ── Team leave (managers only) ─────────────────────────────── -->
				<VBox
					id="teamLeaveCard"
					visible="{tcView>/isManager}"
					busy="{tlView>/busy}"
					busyIndicatorDelay="0"
					class="hrxTcCard">
					<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="hrxTcCardHead">
						<VBox renderType="Bare" class="hrxTcCardHeadText">
							<Title text="{i18n>lmTeamLeave}" level="H3" class="hrxTcCardTitle" />
							<Text text="{tl>/countText}" class="hrxTcCardHint" />
						</VBox>
						<HBox alignItems="Center" wrap="Wrap" renderType="Bare" class="hrxTlTools">
							<Select
								id="teamLeavePeriod"
								selectedKey="{tlView>/period}"
								items="{path: 'tl>/periods', templateShareable: false}"
								change=".onPeriodChange"
								width="250px"
								class="hrxTcSelect">
								<core:Item key="{tl>key}" text="{tl>text}" />
							</Select>
							<DateRangeSelection
								id="teamLeaveRange"
								visible="{= ${tlView>/period} === 'custom' }"
								dateValue="{tlView>/rangeFrom}"
								secondDateValue="{tlView>/rangeTo}"
								displayFormat="d MMM yyyy"
								placeholder="{i18n>tlSelectDates}"
								change=".onRangeChange"
								width="210px"
								class="hrxTcInput" />
							<SearchField
								id="teamLeaveSearch"
								value="{tlView>/q}"
								placeholder="{i18n>lmSearch}"
								liveChange=".onLeaveSearch"
								width="260px"
								class="hrxTcSearch" />
						</HBox>
					</HBox>

					<!-- Pending / Approved / Rejected, each with its count -->
					<HBox wrap="Wrap" items="{path: 'tl>/chips', templateShareable: false}" class="hrxTcChips">
						<Button text="{tl>text}" press=".onStatusChip" class="hrxTcChip">
							<customData>
								<core:CustomData key="status" value="{tl>status}" />
								<core:CustomData key="count" value="{tl>count}" writeToDom="true" />
								<core:CustomData key="on" value="{= ${tl>selected} ? 'yes' : 'no' }" writeToDom="true" />
							</customData>
						</Button>
					</HBox>

					<Table
						id="teamLeaveTable"
						items="{path: 'tl>/rows', templateShareable: false}"
						noDataText="{tl>/noDataText}"
						growing="true"
						growingThreshold="25"
						class="hrxTcTable">
						<columns>
							<Column><Text text="{i18n>mgrColEmployee}" /></Column>
							<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>lmColDates}" /></Column>
							<Column hAlign="Center" width="5rem"><Text text="{i18n>lmColDays}" /></Column>
							<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>lmColType}" /></Column>
							<Column width="9rem"><Text text="{i18n>mgrColStatus}" /></Column>
							<Column hAlign="End" width="13rem"><Text text="" /></Column>
						</columns>
						<items>
							<!-- Click a request to see it on the calendar -->
							<ColumnListItem type="Active" press=".onLeaveRowPress">
								<cells>
									<HBox alignItems="Center" class="hrxTcPersonCell">
										<HBox alignItems="Center" justifyContent="Center" class="hrxTcAvatar">
											<Image src="{= ${pictures>/users}[${tl>EmpID}] || '' }" visible="{= !!${pictures>/users}[${tl>EmpID}] }" width="30px" height="30px" class="hrxAvatarPic" />
											<Text text="{tl>initials}" visible="{= !${pictures>/users}[${tl>EmpID}] }" class="hrxTcAvatarText" />
										</HBox>
										<Text text="{tl>Name}" class="hrxTcPersonName" />
									</HBox>
									<Text text="{tl>dates}" />
									<Text text="{tl>daysNum}" />
									<HBox alignItems="Center" class="hrxTcType">
										<HBox class="hrxTcTypeDot">
											<customData><core:CustomData key="type" value="{tl>typeCode}" writeToDom="true" /></customData>
										</HBox>
										<Text text="{tl>type}" class="hrxTcTypeName" />
										<Text text="{tl>duration}" class="hrxTcDur" />
									</HBox>
									<HBox>
										<Text text="{tl>statusText}" class="hrxTcPill">
											<customData><core:CustomData key="state" value="{tl>status}" writeToDom="true" /></customData>
										</Text>
									</HBox>
									<HBox justifyContent="End" visible="{= ${tl>status} === 'REQ' }" class="hrxTcRowActions">
										<Button text="{i18n>btnApprove}" icon="sap-icon://accept" press=".onApproveRow" class="hrxTcBtn hrxTcBtnApprove" />
										<Button text="{i18n>btnReject}" icon="sap-icon://decline" press=".onRejectRow" class="hrxTcBtn hrxTcBtnReject" />
									</HBox>
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</VBox>

				<!-- ── The week ───────────────────────────────────────────────── -->
				<VBox id="teamCalCard" class="hrxTcCard hrxTcWeekCard">
					<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="hrxTcTop">
						<HBox alignItems="Center" renderType="Bare" class="hrxTcWeekNav">
							<Button icon="sap-icon://slim-arrow-left" tooltip="{i18n>tcPreviousWeek}" press=".onPreviousWeek" class="hrxTcIconBtn" />
							<Title text="{tcView>/weekLabel}" level="H3" class="hrxTcWeekLabel" />
							<Button icon="sap-icon://slim-arrow-right" tooltip="{i18n>tcNextWeek}" press=".onNextWeek" class="hrxTcIconBtn" />
						</HBox>

						<HBox alignItems="End" wrap="Wrap" class="hrxTcFilters">
							<!-- A manager starts on their own team; Everyone is a step away -->
							<VBox visible="{tcView>/isManager}" class="hrxTcFilter">
								<Label text="{i18n>tcTeam}" labelFor="teamCalTeam" class="hrxTcFilterLabel" />
								<Select id="teamCalTeam" selectedKey="{tcView>/team}" change=".onFilterChange" width="130px" class="hrxTcSelect">
									<core:Item key="mine" text="{i18n>tcTeamMine}" />
									<core:Item key="all" text="{i18n>tcTeamAll}" />
								</Select>
							</VBox>

							<!-- "Select resource(s)": opens a list to tick people in -->
							<Input
								id="teamCalResources"
								value="{tcView>/resourcesText}"
								placeholder="{i18n>tcSelectResources}"
								valueHelpOnly="true"
								showValueHelp="true"
								valueHelpRequest=".onOpenResources"
								width="200px"
								class="hrxTcInput hrxTcResourceInput" />

							<VBox class="hrxTcFilter">
								<Label text="{i18n>tcSite}" labelFor="teamCalSite" class="hrxTcFilterLabel" />
								<Select
									id="teamCalSite"
									selectedKey="{tcView>/site}"
									items="{path: 'tc>/sites', templateShareable: false}"
									change=".onFilterChange"
									width="130px"
									class="hrxTcSelect">
									<core:Item key="{tc>key}" text="{tc>text}" />
								</Select>
							</VBox>

							<VBox class="hrxTcFilter">
								<HBox alignItems="Center" class="hrxTcFilterLabelRow">
									<Label text="{i18n>tcProject}" labelFor="teamCalProject" class="hrxTcFilterLabel" />
									<Text text="{i18n>tcNotInMvp}" class="hrxTcPill hrxTcNotMvp" />
								</HBox>
								<Select
									id="teamCalProject"
									selectedKey="{tcView>/project}"
									items="{path: 'tc>/projects', templateShareable: false}"
									change=".onFilterChange"
									width="170px"
									class="hrxTcSelect">
									<core:Item key="{tc>key}" text="{tc>text}" />
								</Select>
							</VBox>
						</HBox>
					</HBox>

					<!-- The leave type colour key, and how a request still waiting is drawn -->
					<HBox alignItems="Center" wrap="Wrap" class="hrxTcLegend">
						<HBox items="{path: 'tc>/legend', templateShareable: false}" class="hrxTcLegendTypes">
							<HBox alignItems="Center" class="hrxTcLegendItem">
								<HBox class="hrxTcLegendDot">
									<customData><core:CustomData key="type" value="{tc>code}" writeToDom="true" /></customData>
								</HBox>
								<Text text="{tc>text}" />
							</HBox>
						</HBox>
						<HBox alignItems="Center" visible="{tcView>/isManager}" class="hrxTcLegendItem">
							<HBox class="hrxTcLegendHatch" />
							<Text text="{i18n>tcHatched}" />
						</HBox>
					</HBox>

					<!-- The grid: who, then Monday to Sunday -->
					<VBox busy="{tcView>/busy}" busyIndicatorDelay="0" class="hrxTcScroll">
						<HBox class="hrxTcRow hrxTcHeadRow">
							<Text text="{i18n>tcTeamMember}" class="hrxTcHead" />
							<HBox items="{path: 'tc>/days', templateShareable: false}" class="hrxTcDays">
								<Text text="{tc>label}" class="hrxTcHead">
									<customData><core:CustomData key="today" value="{= ${tc>isToday} ? 'yes' : 'no' }" writeToDom="true" /></customData>
								</Text>
							</HBox>
						</HBox>

						<VBox visible="{= ${tc>/people}.length === 0 }" class="hrxTcEmpty">
							<Title text="{i18n>tcNobodyTitle}" level="H4" />
							<Text text="{i18n>tcNobodyText}" />
						</VBox>

						<VBox items="{path: 'tc>/people', templateShareable: false}">
							<HBox class="hrxTcRow">
								<HBox alignItems="Center" class="hrxTcPerson">
									<Avatar
										src="{= ${pictures>/users}[${tc>EmpID}] || '' }"
										initials="{tc>initials}"
										displaySize="Custom"
										customDisplaySize="26px"
										customFontSize="10.5px"
										class="hrxTcPersonAvatar" />
									<VBox renderType="Bare" class="hrxTcPersonText">
										<Text text="{tc>Name}" wrapping="false" class="hrxTcPersonName" />
										<Text text="{tc>subText}" visible="{= !!${tc>subText} }" class="hrxTcSub" />
										<Button
											text="{tc>pendingText}"
											visible="{= ${tcView>/isManager} &amp;&amp; ${tc>pendingCount} > 0 }"
											press=".onPersonPendingPress"
											class="hrxTcPend" />
									</VBox>
								</HBox>
								<HBox items="{path: 'tc>cells', templateShareable: false}" class="hrxTcDays">
									<VBox items="{path: 'tc>pills', templateShareable: false}" class="hrxTcCell">
										<customData><core:CustomData key="weekend" value="{= ${tc>weekend} ? 'yes' : 'no' }" writeToDom="true" /></customData>
										<Button text="{tc>text}" tooltip="{tc>tooltip}" press=".onPillPress" class="hrxTcp">
											<customData>
												<core:CustomData key="type" value="{tc>typeCode}" writeToDom="true" />
												<core:CustomData key="pending" value="{= ${tc>pending} ? 'yes' : 'no' }" writeToDom="true" />
												<core:CustomData key="selected" value="{= ${tc>selected} ? 'yes' : 'no' }" writeToDom="true" />
											</customData>
										</Button>
									</VBox>
								</HBox>
							</HBox>
						</VBox>
					</VBox>
				</VBox>
			</VBox>
		</content>
	</Page>
</mvc:View>
