<mvc:View
	controllerName="bsx.hrx.hrx2026.controller.TeamCalendar"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:unified="sap.ui.unified"
	xmlns:core="sap.ui.core"
	displayBlock="true"
	height="100%"
	class="hrxTeamCalendar">

	<!-- Team Calendar, as the 15.10.26 design has it: a manager's Team leave card
	     (what was Leave Management) above everybody's availability. -->
	<Page id="teamCalPage" showHeader="false" title="{i18n>teamCalendarTitle}" showNavButton="false" class="hrxPageContent">
		<content>
			<VBox class="hrxSkStack hrxTcStack">

				<!-- ── Team leave (managers only) ─────────────────────────────── -->
				<VBox
					id="teamLeaveCard"
					visible="{tcView>/isManager}"
					busy="{tlView>/busy}"
					busyIndicatorDelay="0"
					class="hrxSkCard hrxTrCard">
					<HBox alignItems="Center" wrap="Wrap" class="hrxTrCardHead">
						<VBox class="hrxTrCardHeadText">
							<Title text="{i18n>lmTeamLeave}" level="H3" wrapping="true" class="hrxTrCardTitle" />
							<Text text="{tl>/countText}" class="hrxSkHint" />
						</VBox>
						<HBox alignItems="Center" wrap="Wrap" class="hrxTlTools">
							<Select
								id="teamLeavePeriod"
								selectedKey="{tlView>/period}"
								items="{path: 'tl>/periods', templateShareable: false}"
								change=".onPeriodChange"
								width="17rem">
								<core:Item key="{tl>key}" text="{tl>text}" />
							</Select>
							<DateRangeSelection
								id="teamLeaveRange"
								visible="{= ${tlView>/period} === 'custom' }"
								dateValue="{tlView>/rangeFrom}"
								secondDateValue="{tlView>/rangeTo}"
								displayFormat="d MMM yyyy"
								placeholder="{i18n>tlSelectDates}"
								change=".onRangeChange"
								width="14rem" />
							<SearchField
								id="teamLeaveSearch"
								value="{tlView>/q}"
								placeholder="{i18n>lmSearch}"
								liveChange=".onLeaveSearch"
								width="14rem" />
						</HBox>
					</HBox>

					<!-- Pending / Approved / Rejected, each with its count -->
					<HBox wrap="Wrap" items="{path: 'tl>/chips', templateShareable: false}" class="hrxDocFilterRow hrxDocChips">
						<Button
							text="{tl>text}"
							type="{= ${tl>selected} ? 'Emphasized' : 'Default' }"
							press=".onStatusChip"
							class="hrxDocChip">
							<customData><core:CustomData key="status" value="{tl>status}" /></customData>
						</Button>
					</HBox>

					<Table
						id="teamLeaveTable"
						items="{path: 'tl>/rows', templateShareable: false}"
						noDataText="{tl>/noDataText}"
						growing="true"
						growingThreshold="25"
						class="hrxSkTable">
						<columns>
							<Column width="24%"><Text text="{i18n>mgrColEmployee}" /></Column>
							<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>lmColDates}" /></Column>
							<Column hAlign="Center" width="5rem"><Text text="{i18n>lmColDays}" /></Column>
							<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>lmColType}" /></Column>
							<Column width="8rem"><Text text="{i18n>mgrColStatus}" /></Column>
							<Column hAlign="End" width="13rem"><Text text="" /></Column>
						</columns>
						<items>
							<!-- Click a request to see it on the calendar -->
							<ColumnListItem type="Active" press=".onLeaveRowPress">
								<cells>
									<HBox alignItems="Center">
										<Avatar initials="{tl>initials}" displaySize="XS" class="sapUiTinyMarginEnd" />
										<Text text="{tl>Name}" class="hrxResourceName" />
									</HBox>
									<Text text="{tl>dates}" />
									<Text text="{tl>daysNum}" />
									<HBox alignItems="Center" wrap="Wrap" class="hrxLmType">
										<core:Icon src="sap-icon://circle-task-2" color="{tl>colour}" size="0.6rem" class="hrxTlDot" />
										<Text text="{tl>type}" />
										<Text text="{tl>duration}" class="hrxLmDur" />
									</HBox>
									<ObjectStatus text="{tl>statusText}" state="{tl>statusState}" inverted="true" class="hrxSkPill" />
									<HBox justifyContent="End" visible="{= ${tl>status} === 'REQ' }" class="hrxRowActions">
										<Button text="{i18n>btnApprove}" icon="sap-icon://accept" type="Accept"
											press=".onApproveRow" class="sapUiTinyMarginEnd" />
										<Button text="{i18n>btnReject}" icon="sap-icon://decline" type="Reject"
											press=".onRejectRow" />
									</HBox>
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</VBox>

				<!-- ── Availability ───────────────────────────────────────────── -->
				<VBox id="teamCalCard" class="hrxSkCard hrxTcCard">
					<OverflowToolbar id="teamCalToolbar" class="hrxFilterBar hrxTcFilters">
						<!-- A manager starts on their own team; Everyone is a step away -->
						<Label text="{i18n>tcTeam}" labelFor="teamCalTeam" visible="{tcView>/isManager}" />
						<Select
							id="teamCalTeam"
							selectedKey="{tcView>/team}"
							visible="{tcView>/isManager}"
							change=".onFilterChange"
							width="9rem">
							<core:Item key="mine" text="{i18n>tcTeamMine}" />
							<core:Item key="all" text="{i18n>tcTeamAll}" />
						</Select>

						<MultiComboBox
							id="teamCalResourceFilter"
							items="{path: 'tc>/pool', templateShareable: false}"
							selectedKeys="{tcView>/selectedResources}"
							width="15rem"
							selectionFinish=".onFilterChange"
							placeholder="{i18n>tcResourceFilterPlaceholder}">
							<core:Item key="{tc>EmpID}" text="{tc>Name}" />
						</MultiComboBox>

						<Label text="{i18n>tcSite}" labelFor="teamCalSite" />
						<Select
							id="teamCalSite"
							selectedKey="{tcView>/site}"
							items="{path: 'tc>/sites', templateShareable: false}"
							change=".onFilterChange"
							width="9rem">
							<core:Item key="{tc>key}" text="{tc>text}" />
						</Select>

						<Label text="{i18n>tcProject}" labelFor="teamCalProject" />
						<ObjectStatus text="{i18n>tcNotInMvp}" state="Warning" inverted="true" class="hrxSkPill" />
						<Select
							id="teamCalProject"
							selectedKey="{tcView>/project}"
							items="{path: 'tc>/projects', templateShareable: false}"
							change=".onFilterChange"
							width="11rem">
							<core:Item key="{tc>key}" text="{tc>text}" />
						</Select>

						<ToolbarSpacer />

						<Button
							id="teamCalBookLeave"
							text="{i18n>tcBookLeave}"
							icon="sap-icon://create-leave-request"
							type="Transparent"
							visible="{tcView>/isManager}"
							press=".onOpenBookLeave" />
					</OverflowToolbar>

					<PlanningCalendar
						id="teamPlanningCalendar"
						startDate="{tcView>/startDate}"
						rows="{tc>/people}"
						busy="{tcView>/busy}"
						busyIndicatorDelay="0"
						viewKey="week"
						appointmentsVisualization="Filled"
						appointmentHeight="Automatic"
						showEmptyIntervalHeaders="false"
						showWeekNumbers="false"
						stickyHeader="true"
						noDataText="{i18n>tcNoData}"
						startDateChange=".onStartDateChange"
						viewChange=".onViewChange"
						appointmentSelect=".onAppointmentSelect"
						legend="teamCalLegend">
						<views>
							<!-- Day intervals, so every booking in the period is laid out on the timeline.
							     The month's interval count is set by the controller to the number of
							     days that month actually has. -->
							<PlanningCalendarView key="week" intervalType="Day" description="{i18n>tcViewWeek}" intervalsL="7" intervalsM="7" intervalsS="7" />
							<PlanningCalendarView id="teamCalMonthView" key="month" intervalType="Day" description="{i18n>tcViewMonth}" intervalsL="31" intervalsM="31" intervalsS="7" />
						</views>
						<toolbarContent>
							<Title text="{tcView>/title}" level="H3" />
							<ToolbarSpacer />
							<Text text="{tcView>/periodLabel}" class="hrxResourceMeta" />
						</toolbarContent>
						<rows>
							<PlanningCalendarRow
								nonWorkingDays="0,6"
								title="{tc>Name}"
								appointments="{path: 'tc>Leave', templateShareable: true}">
								<!-- Who, their job title and site, and - for a manager - how many
								     of their requests are waiting -->
								<headerContent>
									<HBox alignItems="Center" class="hrxTcPerson">
										<Avatar
											src="{path: 'tc>Pic', formatter: '.formatter.imageSrc'}"
											initials="{tc>initials}"
											displaySize="XS"
											class="sapUiTinyMarginEnd" />
										<VBox class="hrxTcPersonText">
											<Text text="{tc>Name}" wrapping="false" class="hrxResourceName" />
											<Text text="{tc>subText}" wrapping="false" class="hrxTcSub" />
											<Button
												text="{tc>pendingText}"
												visible="{= ${tcView>/isManager} &amp;&amp; ${tc>pendingCount} > 0 }"
												press=".onPersonPendingPress"
												class="hrxTcPend" />
										</VBox>
									</HBox>
								</headerContent>
								<appointments>
									<unified:CalendarAppointment
										startDate="{tc>start}"
										endDate="{tc>end}"
										title="{tc>title}"
										text="{tc>info}"
										color="{tc>colour}"
										tentative="{tc>tentative}"
										selected="{tc>selected}"
										tooltip="{tc>tooltip}" />
								</appointments>
							</PlanningCalendarRow>
						</rows>
					</PlanningCalendar>

					<!-- The leave type colour key, and how a request still waiting is drawn -->
					<HBox alignItems="Center" wrap="Wrap" class="hrxTcLegend">
						<PlanningCalendarLegend
							id="teamCalLegend"
							standardItems="Today,NonWorkingDay"
							appointmentItemsHeader="{i18n>tcLegendLeaveHeader}"
							appointmentItems="{path: 'tc>/legend', templateShareable: false}">
							<appointmentItems>
								<unified:CalendarLegendItem text="{tc>text}" color="{tc>colour}" />
							</appointmentItems>
						</PlanningCalendarLegend>
						<HBox alignItems="Center" visible="{tcView>/isManager}" class="hrxTcHatchKey">
							<core:HTML content="&lt;span class=&quot;hrxTcHatchSwatch&quot;&gt;&lt;/span&gt;" />
							<Text text="{i18n>tcHatched}" class="hrxResourceMeta" />
						</HBox>
					</HBox>
				</VBox>
			</VBox>
		</content>
	</Page>
</mvc:View>
