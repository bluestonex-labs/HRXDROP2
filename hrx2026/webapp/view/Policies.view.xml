<mvc:View
	controllerName="bsx.hrx.hrx2026.controller.Policies"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:layout="sap.ui.layout"
	displayBlock="true"
	class="hrxPolicies">

	<Page id="policiesPage" showHeader="false" title="{i18n>pdTitle}" showNavButton="false" class="hrxPageContent">
		<content>
			<VBox busy="{pdView>/busy}" busyIndicatorDelay="0">

				<MessageStrip
					text="{i18n>serviceNeededPolicies}"
					type="Warning"
					showIcon="true"
					enableFormattedText="true"
					visible="{= !${pdView>/bound} }"
					class="sapUiSmallMarginBottom" />

				<layout:Grid defaultSpan="XL4 L4 M4 S12" hSpacing="1" vSpacing="1" class="hrxCardRow sapUiSmallMarginBottom">
					<VBox class="hrxKpi">
						<customData><core:CustomData key="state" value="Neutral" writeToDom="true" /></customData>
						<core:Icon src="sap-icon://document-text" class="hrxKpiGlyph" />
						<Text text="{i18n>pdKpiAvailable}" class="hrxKpiLabel" />
						<Text text="{pd>/kpis/available}" class="hrxKpiNum" />
						<Text text="{i18n>pdKpiAvailableSub}" class="hrxKpiSub" />
					</VBox>
					<VBox class="hrxKpi">
						<customData><core:CustomData key="state" value="Neutral" writeToDom="true" /></customData>
						<core:Icon src="sap-icon://checklist-item" class="hrxKpiGlyph" />
						<Text text="{i18n>pdKpiNeed}" class="hrxKpiLabel" />
						<Text text="{pd>/kpis/need}" class="hrxKpiNum" />
						<Text text="{i18n>pdKpiNeedSub}" class="hrxKpiSub" />
					</VBox>
					<VBox class="hrxKpi">
						<customData><core:CustomData key="state" value="{= ${pd>/kpis/outstanding} > 0 ? 'Warning' : 'Good' }" writeToDom="true" /></customData>
						<core:Icon src="sap-icon://alert" class="hrxKpiGlyph" />
						<Text text="{i18n>pdKpiOutstanding}" class="hrxKpiLabel" />
						<Text text="{pd>/kpis/outstanding}" class="hrxKpiNum" />
						<Text text="{= ${pd>/kpis/outstanding} > 0 ? ${i18n>pdKpiOutstandingSub} : ${i18n>pdKpiAllDone} }" class="hrxKpiSub" />
					</VBox>
				</layout:Grid>

				<VBox class="hrxSkCard hrxTrCard">
					<HBox alignItems="Center" wrap="Wrap" class="hrxTrCardHead">
						<VBox class="hrxTrCardHeadText">
							<Title text="{i18n>pdListTitle}" level="H3" wrapping="true" class="hrxTrCardTitle" />
							<Text text="{i18n>pdListHint}" class="hrxSkHint" />
						</VBox>
						<CheckBox
							text="{i18n>pdOnlyOutstanding}"
							selected="{pdView>/onlyOutstanding}"
							select=".onFilterChange" />
					</HBox>

					<VBox visible="{= ${pd>/rows}.length === 0 }" class="hrxDocEmpty">
						<Title text="{= ${pdView>/onlyOutstanding} ? ${i18n>pdNothingOutstanding} : ${i18n>pdNoDocuments} }" level="H4" />
						<Text text="{= ${pdView>/onlyOutstanding} ? ${i18n>pdNothingOutstandingText} : ${i18n>pdNoDocumentsText} }" class="hrxResourceMeta" />
					</VBox>

					<VBox items="{path: 'pd>/rows', templateShareable: false}">
						<HBox alignItems="Center" wrap="Wrap" class="hrxDocRow">
							<VBox class="hrxDocMain">
								<Text text="{pd>Name}" class="hrxDocName" />
								<Text text="{pd>meta}" class="hrxResourceMeta" />
							</VBox>
							<HBox alignItems="Center" class="hrxDocStatus">
								<ObjectStatus
									text="{pd>statusText}"
									state="{pd>statusState}"
									inverted="{pd>AckRequired}"
									class="hrxSkPill" />
							</HBox>
							<HBox alignItems="Center" class="hrxDocActs">
								<Button text="{i18n>pdRead}" icon="sap-icon://show" press=".onRead" />
								<Button
									text="{i18n>pdAcknowledge}"
									icon="sap-icon://accept"
									type="Emphasized"
									visible="{pd>outstanding}"
									press=".onAcknowledge" />
							</HBox>
						</HBox>
					</VBox>
				</VBox>
			</VBox>
		</content>
	</Page>
</mvc:View>
