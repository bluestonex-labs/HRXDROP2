<mvc:View
	controllerName="bsx.hrx.hrx2026.controller.Policies"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
	class="hrxPolicies hrxPagePolicies">

	<Page id="policiesPage" showHeader="false" title="{i18n>pdTitle}" showNavButton="false" class="hrxPageContent">
		<content>
			<VBox busy="{pdView>/busy}" busyIndicatorDelay="0" renderType="Bare">

				<MessageStrip
					text="{i18n>serviceNeededPolicies}"
					type="Warning"
					showIcon="true"
					enableFormattedText="true"
					visible="{= !${pdView>/bound} }"
					class="hrxPdStrip" />

				<!-- The design's two KPI tiles: what the employee can read, and how many
				     of those need acknowledging -->
				<HBox renderType="Bare" class="hrxPdKpis">
					<VBox renderType="Bare" class="hrxPdKpi">
						<HBox renderType="Bare" class="hrxPdGlyph">
							<core:Icon src="sap-icon://tabler/file-text" />
						</HBox>
						<Text text="{i18n>pdKpiAvailable}" class="hrxPdKlab" />
						<Text text="{pd>/kpis/available}" class="hrxPdKnum" />
						<Text text="{i18n>pdKpiAvailableSub}" class="hrxPdKsub" />
					</VBox>
					<VBox renderType="Bare" class="hrxPdKpi">
						<HBox renderType="Bare" class="hrxPdGlyph">
							<core:Icon src="sap-icon://tabler/checklist" />
						</HBox>
						<Text text="{i18n>pdKpiNeed}" class="hrxPdKlab" />
						<Text text="{pd>/kpis/need}" class="hrxPdKnum" />
						<Text text="{i18n>pdKpiNeedSub}" class="hrxPdKsub" />
					</VBox>
				</HBox>

				<!-- Policies & documents: one row per document, newest first -->
				<VBox renderType="Bare" class="hrxPdCard">
					<HBox renderType="Bare" class="hrxPdCardHead">
						<VBox renderType="Bare">
							<Title text="{i18n>pdListTitle}" level="H3" class="hrxPdCardTitle" />
							<Text text="{i18n>pdListHint}" class="hrxPdCardHint" />
						</VBox>
						<CheckBox
							text="{i18n>pdOnlyOutstanding}"
							selected="{pdView>/onlyOutstanding}"
							select=".onFilterChange"
							class="hrxPdCheck" />
					</HBox>

					<VBox visible="{= ${pd>/rows}.length === 0 }" renderType="Bare" class="hrxPdEmpty">
						<Text text="{= ${pdView>/onlyOutstanding} ? ${i18n>pdNothingOutstanding} : ${i18n>pdNoDocuments} }" textAlign="Center" class="hrxPdEmptyTitle" />
						<Text text="{= ${pdView>/onlyOutstanding} ? ${i18n>pdNothingOutstandingText} : ${i18n>pdNoDocumentsText} }" textAlign="Center" class="hrxPdEmptyText" />
					</VBox>

					<VBox items="{path: 'pd>/rows', templateShareable: false}" renderType="Bare" class="hrxPdRows">
						<HBox renderType="Bare" class="hrxPdRow">
							<VBox renderType="Bare" class="hrxPdMain">
								<Text text="{pd>Name}" class="hrxPdName" />
								<Text text="{pd>meta}" class="hrxPdMeta" />
							</VBox>
							<HBox renderType="Bare" class="hrxPdStatus">
								<Text text="{pd>statusText}" visible="{= !${pd>AckRequired} }" class="hrxPdNoAck" />
								<Text text="{pd>statusText}" visible="{pd>AckRequired}" class="hrxPdPill">
									<customData>
										<core:CustomData key="state" value="{pd>statusState}" writeToDom="true" />
									</customData>
								</Text>
							</HBox>
							<HBox renderType="Bare" class="hrxPdActs">
								<!-- Acknowledge first, where there is one to give, then Read -->
								<Button
									text="{i18n>pdAcknowledge}"
									icon="sap-icon://accept"
									type="Emphasized"
									visible="{pd>outstanding}"
									press=".onAcknowledge"
									class="hrxPdBtn hrxPdBtnAck" />
								<Button
									text="{i18n>pdRead}"
									icon="sap-icon://show"
									press=".onRead"
									class="hrxPdBtn hrxPdBtnRead" />
							</HBox>
						</HBox>
					</VBox>
				</VBox>
			</VBox>
		</content>
	</Page>
</mvc:View>
