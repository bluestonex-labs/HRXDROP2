<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:grid="sap.ui.layout.cssgrid">

	<!-- New project, as the design's modal: the name, the client and type it is
	     charged as, its manager and priority. Everything else (areas, commercials,
	     dates) is set on the project's Info tab once it is created. -->
	<Dialog
		id="addProjectDialog"
		title="{i18n>mpAddTitle}"
		busy="{mpView>/saving}"
		busyIndicatorDelay="0"
		class="hrxModal hrxModalWide hrxMpDialog">
		<content>
			<grid:CSSGrid id="addProjectGrid" class="hrxMpGrid">
				<VBox renderType="Bare" class="hrxMpField">
					<layoutData>
						<grid:GridItemLayoutData gridColumn="1 / -1" />
					</layoutData>
					<Label text="{i18n>mpFieldDesc}" labelFor="newProjectDesc" required="true" class="hrxModalLabel" />
					<Input
						id="newProjectDesc"
						value="{mpForm>/ProjectDesc}"
						placeholder="{i18n>mpFieldDescPlaceholder}"
						class="hrxMpInput" />
				</VBox>
				<VBox renderType="Bare" class="hrxMpField">
					<Label text="{i18n>mpFieldClient}" labelFor="newProjectClient" required="true" class="hrxModalLabel" />
					<ComboBox
						id="newProjectClient"
						selectedKey="{mpForm>/ClientKey}"
						items="{mp>/clients}"
						width="100%"
						placeholder="{i18n>mpFieldClientPlaceholder}"
						class="hrxMpInput hrxMpSelect">
						<core:ListItem key="{mp>ClientKey}" text="{mp>ClientDesc}" />
					</ComboBox>
				</VBox>
				<VBox renderType="Bare" class="hrxMpField">
					<Label text="{i18n>mpFieldType}" labelFor="newProjectType" required="true" class="hrxModalLabel" />
					<ComboBox
						id="newProjectType"
						selectedKey="{mpForm>/ProjectTypeKey}"
						items="{mp>/projectTypes}"
						width="100%"
						placeholder="{i18n>mpFieldTypePlaceholder}"
						class="hrxMpInput hrxMpSelect">
						<core:ListItem key="{mp>ProjectTypeKey}" text="{mp>ProjectTypeDesc}" />
					</ComboBox>
				</VBox>
				<VBox renderType="Bare" class="hrxMpField">
					<Label text="{i18n>mpFieldManager}" labelFor="newProjectManager" class="hrxModalLabel" />
					<ComboBox
						id="newProjectManager"
						selectedKey="{mpForm>/ProjectManagerID}"
						items="{mp>/managers}"
						width="100%"
						placeholder="{i18n>mpFieldManagerPlaceholder}"
						class="hrxMpInput hrxMpSelect">
						<core:ListItem key="{mp>EmpID}" text="{mp>FullName}" />
					</ComboBox>
				</VBox>
				<VBox renderType="Bare" class="hrxMpField">
					<Label text="{i18n>mpFieldPriority}" labelFor="newProjectPriority" class="hrxModalLabel" />
					<ComboBox
						id="newProjectPriority"
						selectedKey="{mpForm>/PriorityKey}"
						items="{mp>/priorities}"
						width="100%"
						placeholder="{i18n>mpFieldPriorityPlaceholder}"
						class="hrxMpInput hrxMpSelect">
						<core:ListItem key="{mp>PriorityKey}" text="{mp>PriorityDesc}" />
					</ComboBox>
				</VBox>
			</grid:CSSGrid>
		</content>
		<beginButton>
			<Button id="newProjectConfirm" text="{i18n>mpAddConfirm}" type="Emphasized" press=".onCreateProject" class="hrxModalBtn hrxModalBtnPrimary" />
		</beginButton>
		<endButton>
			<Button id="newProjectCancel" text="{i18n>mpCancel}" press=".onCancelAddProject" class="hrxModalBtn hrxModalBtnGhost" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
