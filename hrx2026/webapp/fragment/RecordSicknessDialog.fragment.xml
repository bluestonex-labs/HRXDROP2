<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<!-- The design's "Record a sickness absence" modal (.modal.wide): employee, dates,
	     reason, notes, fit note, and a strip counting the working days. -->
	<Dialog
		id="recordSicknessDialog"
		title="{i18n>skRecordTitle}"
		resizable="false"
		draggable="true"
		class="hrxModal hrxModalWide hrxSicknessDialog"
		afterClose=".onRecordAfterClose">
		<content>
			<VBox busy="{skForm>/saving}" busyIndicatorDelay="0" renderType="Bare" class="hrxSickDlgBody">
				<VBox renderType="Bare" class="hrxSickField">
					<Label text="{i18n>skFieldEmployee}" required="true" labelFor="skEmployee" class="hrxModalLabel" />
					<ComboBox
						id="skEmployee"
						width="100%"
						showSecondaryValues="true"
						filterSecondaryValues="true"
						selectedKey="{skForm>/EmpID}"
						items="{path: 'sk>/employees', length: 2000}"
						placeholder="{i18n>skEmployeePlaceholder}"
						selectionChange=".onRecordInput">
						<core:ListItem key="{sk>EmpID}" text="{sk>FullName}" additionalText="{sk>Email}" />
					</ComboBox>
				</VBox>

				<VBox renderType="Bare" class="hrxSickField">
					<Label text="{i18n>skFieldDates}" required="true" labelFor="skDates" class="hrxModalLabel" />
					<DateRangeSelection
						id="skDates"
						width="100%"
						displayFormat="d MMM yyyy"
						placeholder="{i18n>skDatesPlaceholder}"
						change=".onRecordInput" />
				</VBox>

				<VBox renderType="Bare" class="hrxSickField">
					<Label text="{i18n>skFieldReason}" required="true" labelFor="skReason" class="hrxModalLabel" />
					<Input
						id="skReason"
						width="100%"
						value="{skForm>/Reason}"
						maxLength="200"
						valueLiveUpdate="true"
						liveChange=".onRecordInput"
						placeholder="{i18n>skReasonPlaceholder}" />
				</VBox>

				<VBox renderType="Bare" class="hrxSickField">
					<Label text="{i18n>skFieldNotes}" labelFor="skNotes" class="hrxModalLabel" />
					<TextArea
						id="skNotes"
						width="100%"
						height="65px"
						rows="3"
						maxLength="1000"
						value="{skForm>/Notes}"
						placeholder="{i18n>skOptional}"
						class="hrxSickNotes" />
				</VBox>

				<CheckBox
					id="skFitNote"
					text="{i18n>skFieldFitNote}"
					selected="{skForm>/FitNote}"
					class="hrxSickCheck" />

				<!-- the working days the dates cover, or why there are none -->
				<HBox alignItems="Center" renderType="Bare" class="hrxSickStrip">
					<customData>
						<core:CustomData
							key="kind"
							value="{= ${skForm>/datesPicked} &amp;&amp; ${skForm>/Days} === 0 ? 'crit' : 'info' }"
							writeToDom="true" />
					</customData>
					<core:Icon src="sap-icon://message-information" class="hrxSickStripIcon" />
					<Text text="{skForm>/daysText}" class="hrxSickStripText" />
				</HBox>
			</VBox>
		</content>
		<beginButton>
			<Button
				text="{i18n>skRecord}"
				type="Emphasized"
				class="hrxModalBtn hrxModalBtnPrimary"
				enabled="{= ${skForm>/canSave} &amp;&amp; !${skForm>/saving} }"
				press=".onSaveRecord" />
		</beginButton>
		<endButton>
			<Button text="{i18n>skCancel}" press=".onCancelRecord" class="hrxModalBtn hrxModalBtnGhost" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
