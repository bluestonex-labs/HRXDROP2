<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">

	<!-- The design's "New client" modal: name, location and contact name. The logo and
	     the contact's email and phone are filled in on the client's Basic Info tab,
	     which opens as soon as the client is created. -->
	<Dialog
		id="addClientDialog"
		title="{i18n>mcAddTitle}"
		busy="{mcView>/saving}"
		busyIndicatorDelay="0"
		class="hrxModal hrxModalWide hrxManageClientsDialog">
		<content>
			<VBox renderType="Bare" class="hrxMcGrid">
				<VBox renderType="Bare" class="hrxMcFld hrxMcSpan2">
					<Label text="{i18n>mcFieldName}" required="true" labelFor="newClientName" class="hrxModalLabel hrxMcLbl" />
					<Input id="newClientName" value="{mcForm>/ClientDesc}" placeholder="{i18n>mcFieldNamePlaceholder}" />
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldLocation}" labelFor="newClientLocation" class="hrxModalLabel hrxMcLbl" />
					<Input id="newClientLocation" value="{mcForm>/ClientLocation}" placeholder="{i18n>mcFieldLocationPlaceholder}" />
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldContactName}" labelFor="newClientContact" class="hrxModalLabel hrxMcLbl" />
					<Input id="newClientContact" value="{mcForm>/ClientContactName}" placeholder="{i18n>mcFieldContactNamePlaceholder}" />
				</VBox>
			</VBox>
		</content>
		<beginButton>
			<Button id="newClientConfirm" text="{i18n>mcAddConfirm}" type="Emphasized" press=".onCreateClient" class="hrxModalBtn hrxModalBtnPrimary" />
		</beginButton>
		<endButton>
			<Button id="newClientCancel" text="{i18n>mcCancel}" press=".onCancelAddClient" class="hrxModalBtn hrxModalBtnGhost" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
