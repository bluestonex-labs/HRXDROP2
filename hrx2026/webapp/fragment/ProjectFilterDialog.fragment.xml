<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:grid="sap.ui.layout.cssgrid">

	<!-- Filter projects by client and by whether time can be booked to them -->
	<Dialog
		id="projectFilterDialog"
		title="{i18n>mpFilterTitle}"
		class="hrxModal hrxMpDialog">
		<content>
			<grid:CSSGrid id="projectFilterGrid" class="hrxMpGrid hrxMpGridOne">
				<VBox renderType="Bare" class="hrxMpField">
					<Label text="{i18n>mpFilterClient}" labelFor="filterProjectClient" class="hrxModalLabel" />
					<Select
						id="filterProjectClient"
						selectedKey="{mpView>/filterDraft/client}"
						items="{mp>/filterClients}"
						width="100%"
						class="hrxMpInput hrxMpSelect">
						<core:Item key="{mp>ClientKey}" text="{mp>ClientDesc}" />
					</Select>
				</VBox>
				<VBox renderType="Bare" class="hrxMpField">
					<Label text="{i18n>mpFilterTimeBooking}" labelFor="filterProjectTimeBooking" class="hrxModalLabel" />
					<Select
						id="filterProjectTimeBooking"
						selectedKey="{mpView>/filterDraft/timeBooking}"
						width="100%"
						class="hrxMpInput hrxMpSelect">
						<core:Item key="A" text="{i18n>mpFilterAll}" />
						<core:Item key="Y" text="{i18n>mpFilterOpen}" />
						<core:Item key="N" text="{i18n>mpFilterClosed}" />
					</Select>
				</VBox>
			</grid:CSSGrid>
		</content>
		<beginButton>
			<Button id="projectFilterConfirm" text="{i18n>mpFilterConfirm}" type="Emphasized" press=".onConfirmFilter" class="hrxModalBtn hrxModalBtnPrimary" />
		</beginButton>
		<endButton>
			<Button id="projectFilterCancel" text="{i18n>mpCancel}" press=".onCancelFilter" class="hrxModalBtn hrxModalBtnGhost" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
