<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">

	<!-- New / Edit Service Level. A service level is kept per severity, so the
	     severity of an existing one cannot be changed. -->
	<Dialog
		id="slaDialog"
		title="{= ${mcForm>/mode} === 'edit' ? ${i18n>mcEditSlaTitle} : ${i18n>mcAddSlaTitle} }"
		busy="{mcView>/saving}"
		busyIndicatorDelay="0"
		class="hrxModal hrxManageClientsDialog">
		<content>
			<VBox renderType="Bare" class="hrxMcGrid">
				<VBox renderType="Bare" class="hrxMcFld hrxMcSpan2">
					<Label text="{i18n>mcFieldSeverity}" required="true" labelFor="slaSeverity" class="hrxModalLabel hrxMcLbl" />
					<ComboBox
						id="slaSeverity"
						selectedKey="{mcForm>/PriorityID}"
						items="{mc>/priorities}"
						enabled="{= ${mcForm>/mode} !== 'edit' }"
						width="100%"
						placeholder="{i18n>mcFieldSeverityPlaceholder}">
						<core:ListItem key="{mc>PriorityID}" text="{mc>PriorityDesc}" />
					</ComboBox>
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldResponse}" required="true" labelFor="slaResponse" class="hrxModalLabel hrxMcLbl" />
					<Input id="slaResponse" value="{mcForm>/ResponseSLA}" type="Number" />
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldResolution}" required="true" labelFor="slaResolution" class="hrxModalLabel hrxMcLbl" />
					<Input id="slaResolution" value="{mcForm>/ResolutionSLA}" type="Number" />
				</VBox>
			</VBox>
		</content>
		<beginButton>
			<Button id="slaConfirm" text="{i18n>mcSave}" type="Emphasized" press=".onSaveSla" class="hrxModalBtn hrxModalBtnPrimary" />
		</beginButton>
		<endButton>
			<Button id="slaCancel" text="{i18n>mcCancel}" press=".onCancelSla" class="hrxModalBtn hrxModalBtnGhost" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
