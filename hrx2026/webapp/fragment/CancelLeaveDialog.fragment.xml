<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">

	<!-- "Cancel this leave request?" - the design's confirm (hrx.confirm): the
	     destructive action in red first, then a quiet way back out. -->
	<Dialog
		id="cancelLeaveDialog"
		title="{i18n>mlCancelTitle}"
		contentWidth="460px"
		busy="{mlView>/saving}"
		busyIndicatorDelay="0"
		class="hrxModal hrxMyLeaveDialog">
		<content>
			<VBox renderType="Bare" class="hrxLeaveDialogBody">
				<Text text="{i18n>mlCancelQuestion}" class="hrxModalText" />
				<Text
					text="{mlEdit>/DisplayRange} · {mlEdit>/LeaveType} ({mlEdit>/DurationText})"
					class="hrxModalText hrxLeaveDialogDetail" />
			</VBox>
		</content>
		<beginButton>
			<Button
				id="cancelLeaveConfirm"
				text="{i18n>mlCancelConfirm}"
				type="Reject"
				press=".onConfirmCancelLeave"
				class="hrxModalBtn hrxModalBtnDanger" />
		</beginButton>
		<endButton>
			<Button id="cancelLeaveKeep" text="{i18n>mlCancelKeep}" press=".onCloseCancelLeave" class="hrxModalBtn hrxModalBtnGhost" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
