<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">

	<!-- A day's work description, as the design's modal (hrxModal in css/style.css).
	     The design asks for it in a modal prompt with OK and Cancel: Save writes it
	     back onto the day, Cancel leaves the day as it was. -->
	<Dialog
		id="timesheetCommentDialog"
		title="{i18n>tsCommentTitle}"
		class="hrxModal">
		<content>
			<Label
				text="{tsComment>/label}"
				labelFor="timesheetCommentText"
				class="hrxModalLabel" />
			<TextArea
				id="timesheetCommentText"
				value="{tsComment>/comment}"
				editable="{tsComment>/editable}"
				rows="4"
				width="100%"
				growing="true"
				placeholder="{i18n>tsCommentPlaceholder}" />
		</content>
		<beginButton>
			<Button
				id="timesheetCommentSave"
				text="{i18n>btnSave}"
				type="Emphasized"
				visible="{tsComment>/editable}"
				press=".onSaveComment"
				class="hrxModalBtn hrxModalBtnPrimary" />
		</beginButton>
		<endButton>
			<Button
				id="timesheetCommentCancel"
				text="{i18n>tsCancel}"
				press=".onCancelComment"
				class="hrxModalBtn hrxModalBtnGhost" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
