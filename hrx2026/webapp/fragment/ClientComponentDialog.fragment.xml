<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">

	<!-- New / Edit Component: the design's wide two-column modal. Software, component
	     and sub-component are suggestions from the names already in use; a name typed
	     in that is not in the list yet is kept too (see onSaveComponent). -->
	<Dialog
		id="clientComponentDialog"
		title="{= ${mcForm>/mode} === 'edit' ? ${i18n>mcEditComponentTitle} : ${i18n>mcAddComponentTitle} }"
		busy="{mcView>/saving}"
		busyIndicatorDelay="0"
		class="hrxModal hrxModalWide hrxManageClientsDialog">
		<content>
			<VBox renderType="Bare" class="hrxMcGrid">
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldSoftware}" required="true" labelFor="componentSoftware" class="hrxModalLabel hrxMcLbl" />
					<ComboBox
						id="componentSoftware"
						selectedKey="{mcForm>/Software}"
						items="{mc>/softwares}"
						selectionChange=".onSoftwareChange"
						width="100%"
						placeholder="{i18n>mcFieldSoftwarePlaceholder}">
						<core:ListItem key="{mc>AppID}" text="{mc>AppName}" />
					</ComboBox>
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldComponent}" required="true" labelFor="componentComponent" class="hrxModalLabel hrxMcLbl" />
					<ComboBox
						id="componentComponent"
						selectedKey="{mcForm>/Component}"
						items="{mc>/componentChoices}"
						selectionChange=".onComponentChange"
						width="100%"
						placeholder="{i18n>mcFieldComponentPlaceholder}">
						<core:ListItem key="{mc>ComponentID}" text="{mc>ComponentName}" />
					</ComboBox>
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldSubComponent}" labelFor="componentSubComponent" class="hrxModalLabel hrxMcLbl" />
					<ComboBox
						id="componentSubComponent"
						selectedKey="{mcForm>/SubComponent}"
						items="{mc>/subComponentChoices}"
						width="100%"
						placeholder="{i18n>mcFieldSubComponentPlaceholder}">
						<core:ListItem key="{mc>SubComponentID}" text="{mc>SubComponentName}" />
					</ComboBox>
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldSystemNo}" labelFor="componentSystemNo" class="hrxModalLabel hrxMcLbl" />
					<Input id="componentSystemNo" value="{mcForm>/SystemNo}" />
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldValidFrom}" labelFor="componentValidFrom" class="hrxModalLabel hrxMcLbl" />
					<DatePicker id="componentValidFrom" dateValue="{mcForm>/ValidFrom}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" placeholder="dd/mm/yyyy" />
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldValidTill}" labelFor="componentValidTill" class="hrxModalLabel hrxMcLbl" />
					<DatePicker id="componentValidTill" dateValue="{mcForm>/ValidTill}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" placeholder="dd/mm/yyyy" />
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldInstallDate}" labelFor="componentInstallDate" class="hrxModalLabel hrxMcLbl" />
					<DatePicker id="componentInstallDate" dateValue="{mcForm>/InstallDate}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" placeholder="dd/mm/yyyy" />
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldSapVersion}" labelFor="componentSapVersion" class="hrxModalLabel hrxMcLbl" />
					<Input id="componentSapVersion" value="{mcForm>/SAPVersion}" />
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldObjectCost}" labelFor="componentObjectCost" class="hrxModalLabel hrxMcLbl" />
					<HBox renderType="Bare" class="hrxMcSfx">
						<Input id="componentObjectCost" value="{mcForm>/ObjectCost}" type="Number" />
						<Text text="{i18n>mcCurrencyGbp}" />
					</HBox>
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldSupportCost}" labelFor="componentSupportCost" class="hrxModalLabel hrxMcLbl" />
					<HBox renderType="Bare" class="hrxMcSfx">
						<Input id="componentSupportCost" value="{mcForm>/SupportCost}" type="Number" />
						<Text text="{i18n>mcCurrencyGbp}" />
					</HBox>
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldSupported}" labelFor="componentSupported" class="hrxModalLabel hrxMcLbl" />
					<Switch id="componentSupported" state="{mcForm>/IsSupported}" customTextOn=" " customTextOff=" " class="hrxMcSwitch" />
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldCloudCustomer}" labelFor="componentCloud" class="hrxModalLabel hrxMcLbl" />
					<Switch id="componentCloud" state="{mcForm>/IsCloudCustomer}" customTextOn=" " customTextOff=" " class="hrxMcSwitch" />
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldShowWarning}" labelFor="componentShowWarning" class="hrxModalLabel hrxMcLbl" />
					<Switch id="componentShowWarning" state="{mcForm>/ShowWarning}" customTextOn=" " customTextOff=" " class="hrxMcSwitch" />
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld hrxMcSpan2">
					<Label text="{i18n>mcFieldWarningMessage}" labelFor="componentWarningMessage" class="hrxModalLabel hrxMcLbl" />
					<Input id="componentWarningMessage" value="{mcForm>/WarningMessage}" />
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld hrxMcSpan2">
					<Label text="{i18n>mcFieldHardMessage}" labelFor="componentHardMessage" class="hrxModalLabel hrxMcLbl" />
					<Input id="componentHardMessage" value="{mcForm>/HardMessage}" />
				</VBox>
			</VBox>
		</content>
		<beginButton>
			<Button id="componentConfirm" text="{i18n>mcSave}" type="Emphasized" press=".onSaveComponent" class="hrxModalBtn hrxModalBtnPrimary" />
		</beginButton>
		<endButton>
			<Button id="componentCancel" text="{i18n>mcCancel}" press=".onCancelComponent" class="hrxModalBtn hrxModalBtnGhost" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
