<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">

	<!-- The design's "Filter resources" modal: one field a row, Apply and Cancel -->
	<Dialog
		id="resourceFilterDialog"
		title="{i18n>mrFilterTitle}"
		titleAlignment="Start"
		class="hrxModal hrxMrDialog">
		<content>
			<HBox renderType="Bare" class="hrxMrGrid hrxMrGridOne">
				<VBox renderType="Bare" class="hrxMrFld">
					<Label class="hrxModalLabel" text="{i18n>mrFilterUserType}" labelFor="filterUserType" />
					<Select id="filterUserType" selectedKey="{mrView>/filterDraft/userType}" width="100%">
						<core:Item key="A" text="{i18n>mrFilterAll}" />
						<core:Item key="S" text="{i18n>mrUserTypeStaff}" />
						<core:Item key="C" text="{i18n>mrUserTypeContractor}" />
					</Select>
				</VBox>
				<VBox renderType="Bare" class="hrxMrFld">
					<Label class="hrxModalLabel" text="{i18n>mrFilterStatus}" labelFor="filterActive" />
					<Select id="filterActive" selectedKey="{mrView>/filterDraft/active}" width="100%">
						<core:Item key="A" text="{i18n>mrFilterAll}" />
						<core:Item key="Y" text="{i18n>mrStatusActive}" />
						<core:Item key="N" text="{i18n>mrStatusInactive}" />
					</Select>
				</VBox>
				<!-- Left empty for every location -->
				<VBox renderType="Bare" class="hrxMrFld">
					<Label class="hrxModalLabel" text="{i18n>mrFilterLocation}" labelFor="filterSite" />
					<ComboBox
						id="filterSite"
						selectedKey="{mrView>/filterDraft/site}"
						items="{path: 'mr>/sites', templateShareable: false}"
						width="100%"
						placeholder="{i18n>mrFilterAllLocations}">
						<core:ListItem key="{mr>SiteID}" text="{mr>SiteLabel}" additionalText="{mr>SiteLocation}" />
					</ComboBox>
				</VBox>
			</HBox>
		</content>
		<beginButton>
			<Button
				id="filterConfirm"
				text="{i18n>mrFilterConfirm}"
				type="Emphasized"
				press=".onConfirmFilter"
				class="hrxModalBtn hrxModalBtnPrimary" />
		</beginButton>
		<endButton>
			<Button
				id="filterCancel"
				text="{i18n>mrCancel}"
				press=".onCancelFilter"
				class="hrxModalBtn hrxModalBtnGhost" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
