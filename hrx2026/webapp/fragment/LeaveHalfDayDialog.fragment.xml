<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">

	<!-- "Choose per day" from the Duration list: each bookable day in the range with
	     its own full day / AM / PM choice. A day already half taken offers only its
	     free half. Styled as the design's modal. -->
	<Dialog
		id="leaveHalfDayDialog"
		title="{i18n>mlHalfDaysTitle}"
		initialFocus="leaveHalfDayConfirm"
		contentWidth="460px"
		escapeHandler=".onCancelHalfDays"
		class="hrxModal hrxMyLeaveDialog">
		<content>
			<VBox renderType="Bare" class="hrxLeaveDialogBody">
				<List
					id="leaveHalfDayList"
					items="{ml>/dates}"
					showSeparators="Inner"
					noDataText="{i18n>mlNoBookableDays}"
					class="hrxLeaveHalfDayList">
					<CustomListItem>
						<HBox renderType="Bare" class="hrxLeaveHalfDayRow">
							<Text text="{ml>displayDate}" class="hrxLeaveHalfDayDate" />
							<SegmentedButton selectedKey="{ml>SelectedKey}" class="hrxLeaveSeg">
								<items>
									<SegmentedButtonItem text="{i18n>mlFullDay}" key="F" enabled="{ml>FullDayEnabled}" />
									<SegmentedButtonItem text="{i18n>mlAm}" key="A" enabled="{ml>AMEnabled}" />
									<SegmentedButtonItem text="{i18n>mlPm}" key="P" enabled="{ml>PMEnabled}" />
								</items>
							</SegmentedButton>
						</HBox>
					</CustomListItem>
				</List>
			</VBox>
		</content>
		<!-- Confirm the days, or Cancel (or Escape) to leave the request as it was -->
		<beginButton>
			<Button id="leaveHalfDayConfirm" text="{i18n>mlConfirm}" type="Emphasized" press=".onConfirmHalfDays" class="hrxModalBtn hrxModalBtnPrimary" />
		</beginButton>
		<endButton>
			<Button id="leaveHalfDayCancel" text="{i18n>mlCancel}" press=".onCancelHalfDays" class="hrxModalBtn hrxModalBtnGhost" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
