<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<!-- Home: Pending approvals. The leave waiting for the signed-in user's decision,
	     one row per requester, with Approve and Reject. Used twice on the Home view:
	     in the manager dashboard, and on its own row for anybody else who has
	     requests waiting on them. Handlers live in Home.controller. -->
	<VBox renderType="Bare" class="hrxHomeCard hrxHomeApprCard" busy="{home>/loadingApprovals}" busyIndicatorDelay="0">
		<HBox renderType="Bare" class="hrxHomeCardHead">
			<Title text="{i18n>mgrPendingTitle}" level="H3" class="hrxHomeCardTitle" />
			<Text text="{path: 'home>/approvals', formatter: '.formatPendingCount'}" class="hrxHomeCardHint" />
		</HBox>
		<VBox renderType="Bare" class="hrxHomeApprRows">
			<Text text="{i18n>homeNoPending}" visible="{= ${home>/approvals}.length === 0 }" class="hrxHomeApprEmpty" />
			<VBox renderType="Bare" items="{path: 'home>/approvals', templateShareable: false}">
				<HBox renderType="Bare" class="hrxHomeApprRow">
					<Image src="{= ${pictures>/users}[${home>RequesterID}] || '' }" visible="{= !!${pictures>/users}[${home>RequesterID}] }" width="38px" height="38px" class="hrxAvatarPic" />
					<Text text="{home>initials}" visible="{= !${pictures>/users}[${home>RequesterID}] }" class="hrxHomeApprAvatar" />
					<VBox renderType="Bare" class="hrxHomeApprMain">
						<Text text="{home>RequesterName}" class="hrxHomeApprName" />
						<Text text="{home>rangeLabel}" class="hrxHomeApprMeta" />
						<Text text="{home>typeLabel}" class="hrxHomeApprMeta" />
					</VBox>
					<Text text="{home>daysLabel}" class="hrxHomeApprDays" />
					<HBox renderType="Bare" class="hrxHomeApprActions">
						<Button text="{i18n>btnApprove}" icon="sap-icon://accept" press=".onApproveLeave"
							class="hrxHomeBtn hrxHomeBtnSm hrxHomeBtnApprove" />
						<Button text="{i18n>btnReject}" icon="sap-icon://decline" press=".onRejectLeave"
							class="hrxHomeBtn hrxHomeBtnSm hrxHomeBtnReject" />
					</HBox>
				</HBox>
			</VBox>
		</VBox>
	</VBox>
</core:FragmentDefinition>
