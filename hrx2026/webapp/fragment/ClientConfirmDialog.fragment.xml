<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">

	<!-- The design's delete confirmation ("Delete user", "Are you sure you want to
	     delete this user?"), shared by every tab of Manage Clients. The texts are set in
	     mcConfirm by the controller's _confirmDelete. -->
	<Dialog
		id="clientConfirmDialog"
		title="{mcConfirm>/title}"
		busy="{mcView>/saving}"
		busyIndicatorDelay="0"
		class="hrxModal hrxManageClientsDialog">
		<content>
			<Text text="{mcConfirm>/text}" class="hrxModalText" />
		</content>
		<beginButton>
			<Button
				id="clientConfirmDelete"
				text="{i18n>mcDelete}"
				type="Reject"
				press=".onConfirmDelete"
				class="hrxModalBtn hrxModalBtnDanger" />
		</beginButton>
		<endButton>
			<Button id="clientConfirmCancel" text="{i18n>mcCancel}" press=".onCancelDelete" class="hrxModalBtn hrxModalBtnGhost" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
