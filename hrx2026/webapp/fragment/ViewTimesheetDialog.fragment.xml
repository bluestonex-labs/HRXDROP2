<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<!-- HR admins pick whose timesheet to look at (read only); see Timesheet.onViewOtherTimesheet -->
	<SelectDialog
		title="{i18n>tsPickPersonTitle}"
		items="{path: 'tsView>/people', templateShareable: false}"
		search=".onSearchTimesheetPeople"
		liveChange=".onSearchTimesheetPeople"
		confirm=".onPickTimesheetPerson"
		cancel=".onCancelTimesheetPerson">
		<StandardListItem title="{tsView>Name}" description="{tsView>Email}" />
	</SelectDialog>
</core:FragmentDefinition>
