<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">

	<!-- The design's wide modal (.modal.wide, 560px - hrxModal in css/style.css):
	     uppercase title, the action first and Cancel after it in a frosted foot.
	     The assignment list runs edge to edge inside it (hrxTsAddProjects). -->
	<Dialog
		id="addTimesheetProjectsDialog"
		title="{i18n>tsAddProjectsTitle}"
		contentHeight="24rem"
		busy="{tsView>/saving}"
		busyIndicatorDelay="0"
		class="hrxModal hrxModalWide hrxTsAddProjects">
		<content>
			<Table
				id="addProjectsTable"
				items="{ts>/available}"
				mode="MultiSelect"
				growing="true"
				growingThreshold="50"
				sticky="ColumnHeaders"
				class="hrxTsPickerTable"
				noDataText="{i18n>tsNoAvailableProjects}">
				<columns>
					<!-- Fixed widths for the two short columns so the three of them line up
					     down the list instead of shifting with the longest client name. -->
					<Column><Text text="{i18n>tsColProject}" /></Column>
					<Column width="9rem" minScreenWidth="Tablet" demandPopin="true">
						<Text text="{i18n>tsColClient}" />
					</Column>
					<Column width="7rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
						<Text text="{i18n>tsColType}" />
					</Column>
				</columns>
				<items>
					<!-- Middle, so the two-line project cell and the single-line client and
					     type cells sit on one centre line. -->
					<ColumnListItem vAlign="Middle">
						<cells>
							<ObjectIdentifier title="{ts>ProjectDesc}" text="{ts>ProjectID}" />
							<Text text="{ts>ClientDesc}" />
							<Text text="{ts>ProjectTypeText}" />
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<beginButton>
			<Button id="addProjectsConfirm" text="{i18n>tsAddProjectsConfirm}" type="Emphasized" press=".onConfirmAddProjects" class="hrxModalBtn hrxModalBtnPrimary" />
		</beginButton>
		<endButton>
			<Button id="addProjectsCancel" text="{i18n>tsCancel}" press=".onCancelAddProjects" class="hrxModalBtn hrxModalBtnGhost" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
