<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">

	<!-- New / Edit Support User, laid out as the design's two-column modal form -->
	<Dialog
		id="clientUserDialog"
		title="{= ${mcForm>/mode} === 'edit' ? ${i18n>mcEditUserTitle} : ${i18n>mcAddUserTitle} }"
		busy="{mcView>/saving}"
		busyIndicatorDelay="0"
		class="hrxModal hrxManageClientsDialog">
		<content>
			<VBox renderType="Bare" class="hrxMcGrid">
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldFirstName}" required="true" labelFor="userFirstName" class="hrxModalLabel hrxMcLbl" />
					<Input id="userFirstName" value="{mcForm>/FName}" placeholder="{i18n>mcFieldFirstNamePlaceholder}" />
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldLastName}" required="true" labelFor="userLastName" class="hrxModalLabel hrxMcLbl" />
					<Input id="userLastName" value="{mcForm>/LName}" placeholder="{i18n>mcFieldLastNamePlaceholder}" />
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld hrxMcSpan2">
					<Label text="{i18n>mcFieldEmail}" required="true" labelFor="userEmail" class="hrxModalLabel hrxMcLbl" />
					<Input id="userEmail" value="{mcForm>/Email}" type="Email" placeholder="{i18n>mcFieldEmailPlaceholder}" />
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldMobile}" labelFor="userMobile" class="hrxModalLabel hrxMcLbl" />
					<Input id="userMobile" value="{mcForm>/Mobile}" type="Tel" placeholder="{i18n>mcFieldMobilePlaceholder}" />
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldActive}" labelFor="userActive" class="hrxModalLabel hrxMcLbl" />
					<Switch id="userActive" state="{mcForm>/IsActive}" customTextOn=" " customTextOff=" " class="hrxMcSwitch" />
				</VBox>
				<VBox renderType="Bare" class="hrxMcFld">
					<Label text="{i18n>mcFieldAdmin}" labelFor="userAdmin" class="hrxModalLabel hrxMcLbl" />
					<Switch id="userAdmin" state="{mcForm>/IsAdmin}" customTextOn=" " customTextOff=" " class="hrxMcSwitch" />
				</VBox>
			</VBox>
		</content>
		<beginButton>
			<Button id="userConfirm" text="{i18n>mcSave}" type="Emphasized" press=".onSaveUser" class="hrxModalBtn hrxModalBtnPrimary" />
		</beginButton>
		<endButton>
			<Button id="userCancel" text="{i18n>mcCancel}" press=".onCancelUser" class="hrxModalBtn hrxModalBtnGhost" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
