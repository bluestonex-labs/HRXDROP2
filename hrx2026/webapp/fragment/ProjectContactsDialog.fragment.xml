<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form">

	<!-- The client's contacts for a project: a primary (name and email required) and
	     an optional secondary (both or neither). Checked by ManageProjects.onSaveContacts
	     and again by the HRX service. -->
	<Dialog
		id="projectContactsDialog"
		title="{i18n>mpContactsDialogTitle}"
		contentWidth="36rem"
		busy="{mpView>/saving}"
		busyIndicatorDelay="0">
		<content>
			<form:SimpleForm
				id="projectContactsForm"
				editable="true"
				layout="ResponsiveGridLayout"
				labelSpanXL="4"
				labelSpanL="4"
				labelSpanM="4"
				labelSpanS="12"
				adjustLabelSpan="false"
				emptySpanXL="0"
				emptySpanL="0"
				emptySpanM="0"
				emptySpanS="0"
				columnsXL="1"
				columnsL="1"
				columnsM="1"
				singleContainerFullSize="false">
				<form:content>
					<core:Title text="{i18n>mpPrimaryContact}" />
					<Label text="{i18n>mpColName}" required="true" />
					<Input
						id="primaryContactName"
						value="{mpForm>/PrimaryContactName}"
						valueState="{mpForm>/state/PrimaryContactName}"
						maxLength="100"
						placeholder="{i18n>mpContactNamePlaceholder}" />
					<Label text="{i18n>mpFieldEmailAddress}" required="true" />
					<Input
						id="primaryContactEmail"
						type="Email"
						value="{mpForm>/PrimaryContactEmail}"
						valueState="{mpForm>/state/PrimaryContactEmail}"
						maxLength="100"
						placeholder="{i18n>mpContactEmailPlaceholder}" />

					<core:Title text="{i18n>mpSecondaryContact}" />
					<Label text="{i18n>mpColName}" />
					<Input
						id="secondaryContactName"
						value="{mpForm>/SecondaryContactName}"
						valueState="{mpForm>/state/SecondaryContactName}"
						maxLength="100"
						placeholder="{i18n>mpContactNameOptional}" />
					<Label text="{i18n>mpFieldEmailAddress}" />
					<Input
						id="secondaryContactEmail"
						type="Email"
						value="{mpForm>/SecondaryContactEmail}"
						valueState="{mpForm>/state/SecondaryContactEmail}"
						maxLength="100"
						placeholder="{i18n>mpContactEmailOptional}" />
				</form:content>
			</form:SimpleForm>
		</content>
		<beginButton>
			<Button id="projectContactsSave" text="{i18n>mpSave}" type="Emphasized" press=".onSaveContacts" />
		</beginButton>
		<endButton>
			<Button id="projectContactsCancel" text="{i18n>mpCancel}" press=".onCancelContacts" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
